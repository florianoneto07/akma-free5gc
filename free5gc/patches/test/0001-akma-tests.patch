+// akmaSuci returns the SUCI (null scheme) of IMSI 20893<msin> with the
+// Routing Indicator rid, as a 5GS mobile identity (TS 24.501 cl. 9.11.3.4).
+func akmaSuci(rid [2]uint8, msin [5]uint8) nasType.MobileIdentity5GS {
+	return nasType.MobileIdentity5GS{
+		Len: 13,
+		Buffer: []uint8{0x01, 0x02, 0xf8, 0x39, rid[0], rid[1], 0x00, 0x00,
+			msin[0], msin[1], msin[2], msin[3], msin[4]},
+	}
+}
+
+// akmaRegister runs an initial registration of ue up to Registration
+// Complete, with 5G AKA or EAP-AKA' according to its subscription.
+func akmaRegister(t *testing.T, conn *sctp.SCTPConn, ue *test.RanUeContext, id nasType.MobileIdentity5GS) {
+	t.Helper()
+	recvMsg := make([]byte, 2048)
+	read := func() *ngapType.NGAPPDU {
+		n, err := conn.Read(recvMsg)
+		require.NoError(t, err)
+		pdu, err := ngap.Decoder(recvMsg[:n])
+		require.NoError(t, err)
+		return pdu
+	}
+	write := func(msg []byte, err error) {
+		require.NoError(t, err)
+		_, err = conn.Write(msg)
+		require.NoError(t, err)
+	}
+
+	secCap := ue.GetUESecurityCapability()
+	registrationRequest := nasTestpacket.GetRegistrationRequest(
+		nasMessage.RegistrationType5GSInitialRegistration, id, nil, secCap, nil, nil, nil)
+	write(test.GetInitialUEMessage(ue.RanUeNgapId, registrationRequest, ""))
+
+	// Authentication Request. The AMF UE NGAP ID is taken from it: the
+	// AKMA tests run in one process, where the AMF numbers UEs from 1.
+	ngapPdu := read()
+	require.NotNil(t, ngapPdu.InitiatingMessage)
+	ue.AmfUeNgapId = amfUeNgapId(t, ngapPdu.InitiatingMessage.Value.DownlinkNASTransport)
+	nasPdu := test.GetNasPdu(ue, ngapPdu.InitiatingMessage.Value.DownlinkNASTransport)
+	require.NotNil(t, nasPdu)
+	require.Equal(t, nas.MsgTypeAuthenticationRequest, nasPdu.GmmHeader.GetMessageType())
+	var pdu []byte
+	if ue.AuthenticationSubs.AuthenticationMethod == models.AuthMethod_EAP_AKA_PRIME {
+		eap := nasPdu.AuthenticationRequest.GetEAPMessage()
+		res := ue.DeriveResEAPMessageAndSetKey(ue.AuthenticationSubs, eap, "5G:mnc093.mcc208.3gppnetwork.org")
+		pdu = nasTestpacket.GetAuthenticationResponse(nil, base64.StdEncoding.EncodeToString(res))
+	} else {
+		rand := nasPdu.AuthenticationRequest.GetRANDValue()
+		resStar := ue.DeriveRESstarAndSetKey(ue.AuthenticationSubs, rand[:], "5G:mnc093.mcc208.3gppnetwork.org")
+		pdu = nasTestpacket.GetAuthenticationResponse(resStar, "")
+	}
+	write(test.GetUplinkNASTransport(ue.AmfUeNgapId, ue.RanUeNgapId, pdu))
+
+	// Security Mode Command
+	ngapPdu = read()
+	require.NotNil(t, ngapPdu.InitiatingMessage)
+	nasPdu = test.GetNasPdu(ue, ngapPdu.InitiatingMessage.Value.DownlinkNASTransport)
+	require.NotNil(t, nasPdu)
+	require.Equal(t, nas.MsgTypeSecurityModeCommand, nasPdu.GmmHeader.GetMessageType())
+	withCap := nasTestpacket.GetRegistrationRequest(nasMessage.RegistrationType5GSInitialRegistration,
+		id, nil, secCap, ue.Get5GMMCapability(), nil, nil)
+	pdu, err := test.EncodeNasPduWithSecurity(ue, nasTestpacket.GetSecurityModeComplete(withCap),
+		nas.SecurityHeaderTypeIntegrityProtectedAndCipheredWithNew5gNasSecurityContext, true, true)
+	require.NoError(t, err)
+	write(test.GetUplinkNASTransport(ue.AmfUeNgapId, ue.RanUeNgapId, pdu))
+
+	// Initial Context Setup
+	ngapPdu = read()
+	require.NotNil(t, ngapPdu.InitiatingMessage)
+	require.Equal(t, ngapType.ProcedureCodeInitialContextSetup, ngapPdu.InitiatingMessage.ProcedureCode.Value)
+	write(test.GetInitialContextSetupResponse(ue.AmfUeNgapId, ue.RanUeNgapId))
+
+	// Registration Complete
+	pdu, err = test.EncodeNasPduWithSecurity(ue, nasTestpacket.GetRegistrationComplete(nil),
+		nas.SecurityHeaderTypeIntegrityProtectedAndCiphered, true, false)
+	require.NoError(t, err)
+	write(test.GetUplinkNASTransport(ue.AmfUeNgapId, ue.RanUeNgapId, pdu))
+}
+
+func amfUeNgapId(t *testing.T, msg *ngapType.DownlinkNASTransport) int64 {
+	t.Helper()
+	require.NotNil(t, msg)
+	for _, ie := range msg.ProtocolIEs.List {
+		if ie.Id.Value == ngapType.ProtocolIEIDAMFUENGAPID {
+			return ie.Value.AMFUENGAPID.Value
+		}
+	}
+	t.Fatal("AMF UE NGAP ID missing in DownlinkNASTransport")
+	return 0
+}
