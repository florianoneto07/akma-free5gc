+func removeAkmaContext(ueSupi string) {
+	req := &Naanf_AKMA.RemoveContextRequest{}
+	req.SetCtxRemove(models.CtxRemove{Supi: ueSupi})
+	_, _ = aanfClient().RemoveTheAKMAApplicationKeyMaterialDeletionApi.RemoveContext(context.Background(), req)
+}
