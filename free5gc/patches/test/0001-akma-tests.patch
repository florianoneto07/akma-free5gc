+// runAkmaRegistration registers a UE with the given subscription and SUCI
+// and returns its context.
+func runAkmaRegistration(t *testing.T, imsi string, subs models.AuthenticationSubscription,
+	id nasType.MobileIdentity5GS,
+) *test.RanUeContext {
+	t.Helper()
+	conn, err := test.ConnectToAmf(amfN2Ipv4Addr, ranN2Ipv4Addr, 38412, 9487)
+	require.NoError(t, err)
+	t.Cleanup(func() { _ = conn.Close() })
+
+	recvMsg := make([]byte, 2048)
+	sendMsg, err := test.GetNGSetupRequest([]byte("\x00\x01\x02"), 24, "free5gc")
+	require.NoError(t, err)
+	_, err = conn.Write(sendMsg)
+	require.NoError(t, err)
+	n, err := conn.Read(recvMsg)
+	require.NoError(t, err)
+	ngapPdu, err := ngap.Decoder(recvMsg[:n])
+	require.NoError(t, err)
+	require.Equal(t, ngapType.NGAPPDUPresentSuccessfulOutcome, ngapPdu.Present)
+
+	ue := test.NewRanUeContext(imsi, 1, security.AlgCiphering128NEA0, security.AlgIntegrity128NIA2,
+		models.AccessType__3_GPP_ACCESS)
+	ue.AmfUeNgapId = 1
+	ue.AuthenticationSubs = subs
+	servingPlmnId := "20893"
+	test.InsertUeToMongoDB(t, ue, servingPlmnId)
+	t.Cleanup(func() {
+		test.DelUeFromMongoDB(t, ue, servingPlmnId)
+		removeAkmaContext(ue.Supi)
+	})
+
+	akmaRegister(t, conn, ue, id)
+	return ue
+}
+
+func akmaSubscription(eap bool, rid string) models.AuthenticationSubscription {
+	var subs models.AuthenticationSubscription
+	if eap {
+		subs = test.GetEAPAKAPrimeAuthSubscription(TestGenAuthData.MilenageTestSet19.K,
+			TestGenAuthData.MilenageTestSet19.OPC, TestGenAuthData.MilenageTestSet19.OP)
+	} else {
+		subs = test.GetAuthSubscription(TestGenAuthData.MilenageTestSet19.K,
+			TestGenAuthData.MilenageTestSet19.OPC, TestGenAuthData.MilenageTestSet19.OP)
+	}
+	if rid != "" {
+		subs.AkmaAllowed = true
+		subs.RoutingId = rid
+	}
+	return subs
+}
