+func aanfClient() *Naanf_AKMA.APIClient {
+	cfg := Naanf_AKMA.NewConfiguration()
+	cfg.SetBasePath("http://" + test.AanfSbiIPv4 + ":8000")
+	return Naanf_AKMA.NewAPIClient(cfg)
+}
+
+// retrieveKaf asks the AAnF for K_AF as the AF of the test bench, retrying
+// while the AUSF registration, which runs apart from the authentication
+// (TS 33.535 cl. 6.1), has not arrived. It returns the HTTP status of the last try.
+func retrieveKaf(aKId string, wait time.Duration) (*models.AkmaAfKeyData, int) {
+	req := &Naanf_AKMA.GetAKMAAPPKeyMaterialRequest{}
+	req.SetAkmaAfKeyRequest(models.AkmaAfKeyRequest{AfId: test.AanfTestAfId, AKId: aKId})
+	deadline := time.Now().Add(wait)
+	for {
+		rsp, err := aanfClient().RetrieveTheAKMAApplicationKeyMaterialCollectionApi.
+			GetAKMAAPPKeyMaterial(context.Background(), req)
+		if err == nil {
+			return &rsp.AkmaAfKeyData, http.StatusOK
+		}
+		status := 0
+		var apiErr openapi.GenericOpenAPIError
+		if errors.As(err, &apiErr) {
+			status = apiErr.ErrorStatus
+		}
+		if time.Now().After(deadline) {
+			return nil, status
+		}
+		time.Sleep(200 * time.Millisecond)
+	}
+}
