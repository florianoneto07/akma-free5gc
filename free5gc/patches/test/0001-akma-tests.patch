+// TestAkma5GAKA: the K_AF returned by the AAnF equals the K_AF
+// derived by the test UE from its own K_AUSF. RID "0000" in the SUCI and in
+// the subscription.
+func TestAkma5GAKA(t *testing.T) {
+	ue := runAkmaRegistration(t, "imsi-208930000007490", akmaSubscription(false, "0000"),
+		akmaSuci([2]uint8{0x00, 0x00}, [5]uint8{0x00, 0x00, 0x00, 0x47, 0x09}))
+
+	aKId, kaf := akmaExpected(t, ue, "0000")
+	require.Regexp(t, `^rid0000\.atid[A-Za-z0-9+/]{43}=@5gc\.mnc093\.mcc208\.3gppnetwork\.org$`, aKId)
+	data, status := retrieveKaf(aKId, 5*time.Second)
+	require.Equal(t, http.StatusOK, status)
+	require.Equal(t, codec.HexKey(kaf), data.Kaf)
+	require.Equal(t, ue.Supi, data.Supi)
+}
+
+// TestAkmaEAPAKAPrime: RID "012", leading zero kept end to end.
+func TestAkmaEAPAKAPrime(t *testing.T) {
+	ue := runAkmaRegistration(t, "imsi-208930000007491", akmaSubscription(true, "012"),
+		akmaSuci([2]uint8{0x10, 0xf2}, [5]uint8{0x00, 0x00, 0x00, 0x47, 0x19}))
+
+	aKId, kaf := akmaExpected(t, ue, "012")
+	require.Regexp(t, `^rid012\.atid`, aKId)
+	data, status := retrieveKaf(aKId, 5*time.Second)
+	require.Equal(t, http.StatusOK, status)
+	require.Equal(t, codec.HexKey(kaf), data.Kaf)
+	require.Equal(t, ue.Supi, data.Supi)
+}
