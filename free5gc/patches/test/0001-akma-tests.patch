+// akmaExpected derives, from the K_AUSF of the test UE, the A-KID and the
+// K_AF that the AAnF must hold (TS 33.535 cl. 6.1, A.2-A.4).
+func akmaExpected(t *testing.T, ue *test.RanUeContext, rid akid.RID) (string, kdf.Key) {
+	t.Helper()
+	require.Len(t, ue.Kausf, kdf.KeyLen, "K_AUSF of the test UE")
+	var kAusf kdf.Key
+	copy(kAusf[:], ue.Kausf)
+	p, err := supi.FromSBI(ue.Supi)
+	require.NoError(t, err)
+	hn, err := akid.NewHomeNetwork("208", "93")
+	require.NoError(t, err)
+	id, err := derive.AKID(kAusf, p, rid, hn)
+	require.NoError(t, err)
+	aKId, err := id.Format(akid.DefaultOptions())
+	require.NoError(t, err)
+	kAkma, err := derive.KAkma(kAusf, p)
+	require.NoError(t, err)
+	af, err := afid.Parse(test.AanfTestAfId)
+	require.NoError(t, err)
+	kaf, err := derive.KAf(kAkma, af)
+	require.NoError(t, err)
+	return aKId, kaf
+}
