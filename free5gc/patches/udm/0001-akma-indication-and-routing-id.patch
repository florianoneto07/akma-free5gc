@@ -0,0 +1,121 @@
+package processor
+
+import (
+	"encoding/json"
+	"net/http/httptest"
+	"testing"
+
+	"github.com/gin-gonic/gin"
+	"github.com/h2non/gock"
+	"github.com/stretchr/testify/require"
+	"go.uber.org/mock/gomock"
+
+	"github.com/free5gc/openapi"
+	"github.com/free5gc/openapi/models"
+	udm_context "github.com/free5gc/udm/internal/context"
+	"github.com/free5gc/udm/internal/sbi/consumer"
+	mockapp "github.com/free5gc/udm/pkg/mockapp"
+)
+
+func TestSetAkmaIndication(t *testing.T) {
+	const supi = "imsi-208930000000001"
+	const suci0000 = "suci-0-208-93-0000-0-0-0000000001"
+	cases := []struct {
+		name       string
+		subs       models.AuthenticationSubscription
+		supiOrSuci string
+		wantInd    bool
+		wantRid    string
+	}{
+		{"no AKMA subscription", models.AuthenticationSubscription{RoutingId: "0000"}, suci0000, false, ""},
+		{"AKMA with SUCI", models.AuthenticationSubscription{AkmaAllowed: true, RoutingId: "0000"}, suci0000, true, "0000"},
+		{"AKMA with SUPI", models.AuthenticationSubscription{AkmaAllowed: true, RoutingId: "0000"}, supi, true, "0000"},
+		{"leading zero kept", models.AuthenticationSubscription{AkmaAllowed: true, RoutingId: "012"}, supi, true, "012"},
+		{"default RID", models.AuthenticationSubscription{AkmaAllowed: true, RoutingId: "0"}, supi, true, "0"},
+		{"SUCI RID differs: stored one used", models.AuthenticationSubscription{AkmaAllowed: true, RoutingId: "12"}, suci0000, true, "12"},
+		{"routingId missing", models.AuthenticationSubscription{AkmaAllowed: true}, suci0000, false, ""},
+		{"routingId too long", models.AuthenticationSubscription{AkmaAllowed: true, RoutingId: "00000"}, supi, false, ""},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			var rsp models.UdmUeauAuthenticationInfoResult
+			setAkmaIndication(&rsp, &c.subs, c.supiOrSuci, supi)
+			require.Equal(t, c.wantInd, rsp.AkmaInd)
+			require.Equal(t, c.wantRid, rsp.RoutingId)
+		})
+	}
+}
+
+// generateAuthDataBody runs GenerateAuthDataProcedure against a mocked UDR
+// that returns subs and gives back the raw response body.
+func generateAuthDataBody(t *testing.T, subs models.AuthenticationSubscription, supiOrSuci string) []byte {
+	t.Helper()
+	defer gock.Off()
+	openapi.InterceptH2CClient()
+	defer openapi.RestoreH2CClient()
+
+	gock.New("http://127.0.0.4:8000/nudr-dr/v2").
+		Get("/subscription-data/imsi-208930000000001/authentication-data/authentication-subscription").
+		Reply(200).
+		AddHeader("Content-Type", "application/json").
+		JSON(subs)
+	gock.New("http://127.0.0.4:8000").
+		Patch("/nudr-dr/v2/subscription-data/imsi-208930000000001/authentication-data/authentication-subscription").
+		Reply(204).
+		JSON(map[string]string{})
+
+	ctrl := gomock.NewController(t)
+	defer ctrl.Finish()
+	mockApp := mockapp.NewMockApp(ctrl)
+	testConsumer, err := consumer.NewConsumer(mockApp)
+	require.NoError(t, err)
+	testProcessor, err := NewProcessor(mockApp)
+	require.NoError(t, err)
+	udm_context.GetSelf().NrfUri = "http://127.0.0.10:8000"
+	ue := new(udm_context.UdmUeContext)
+	ue.Init()
+	ue.Supi = "imsi-208930000000001"
+	ue.UdrUri = "http://127.0.0.4:8000"
+	udm_context.GetSelf().UdmUePool.Store("imsi-208930000000001", ue)
+	mockApp.EXPECT().Consumer().Return(testConsumer).AnyTimes()
+	mockApp.EXPECT().Context().Return(
+		&udm_context.UDMContext{OAuth2Required: false, NrfUri: "http://127.0.0.10:8000", NfId: "1"},
+	).AnyTimes()
+
+	rec := httptest.NewRecorder()
+	c, _ := gin.CreateTestContext(rec)
+	testProcessor.GenerateAuthDataProcedure(c, models.AuthenticationInfoRequest{ServingNetworkName: "internet"}, supiOrSuci)
+	require.Equal(t, 200, rec.Code)
+	return rec.Body.Bytes()
+}
+
+func akmaTestSubscription(akma bool) models.AuthenticationSubscription {
+	return models.AuthenticationSubscription{
+		AuthenticationMethod:          models.AuthMethod__5_G_AKA,
+		EncPermanentKey:               "8baf473f2f8fd09487cccbd7097c6862",
+		ProtectionParameterId:         "8baf473f2f8fd09487cccbd7097c6862",
+		SequenceNumber:                &models.SequenceNumber{Sqn: "000000000023"},
+		AuthenticationManagementField: "8000",
+		AlgorithmId:                   "128-EEA0",
+		EncOpcKey:                     "8e27b6af0e692e750f32667a3b14605d",
+		AkmaAllowed:                   akma,
+		RoutingId:                     "0000",
+	}
+}
+
+func TestGenerateAuthDataAkma(t *testing.T) {
+	body := generateAuthDataBody(t, akmaTestSubscription(true), "imsi-208930000000001")
+	var raw map[string]any
+	require.NoError(t, json.Unmarshal(body, &raw))
+	require.Equal(t, true, raw["akmaInd"])
+	require.Equal(t, "0000", raw["routingId"])
+}
+
+// Without akmaAllowed, akmaInd and routingId are absent.
+func TestGenerateAuthDataWithoutAkma(t *testing.T) {
+	body := generateAuthDataBody(t, akmaTestSubscription(false), "imsi-208930000000001")
+	var raw map[string]any
+	require.NoError(t, json.Unmarshal(body, &raw))
+	require.NotContains(t, raw, "akmaInd")
+	require.NotContains(t, raw, "routingId")
+}
