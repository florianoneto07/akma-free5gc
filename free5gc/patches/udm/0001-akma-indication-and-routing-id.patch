+// RoutingIndicator returns the Routing Indicator carried in a SUCI, as a
+// string in which every digit is kept (TS 23.003 cl. 2.2B), and false when s
+// is not a SUCI.
+func RoutingIndicator(s string) (string, bool) {
+	parsed := parseSuci(s)
+	if parsed == nil {
+		return "", false
+	}
+	return parsed.RoutingIndicator, true
+}
