+// TS 23.003 cl. 2.2B: every digit of the Routing Indicator is significant.
+func TestRoutingIndicator(t *testing.T) {
+	cases := map[string]string{
+		"suci-0-208-93-0-0-0-0000000001":    "0",
+		"suci-0-208-93-012-0-0-0000000001":  "012",
+		"suci-0-208-93-0000-0-0-0000000001": "0000",
+		"suci-0-208-093-12-0-0-0000000001":  "12",
+	}
+	for in, want := range cases {
+		got, ok := RoutingIndicator(in)
+		if !ok || got != want {
+			t.Errorf("RoutingIndicator(%q) = %q, %v; want %q", in, got, ok, want)
+		}
+	}
+	if _, ok := RoutingIndicator("imsi-208930000000001"); ok {
+		t.Error("a SUPI was taken as a SUCI")
+	}
+}
