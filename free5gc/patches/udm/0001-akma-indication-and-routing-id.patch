diff --git a/internal/sbi/processor/akma.go b/internal/sbi/processor/akma.go
new file mode 100644
index 0000000..7214788
--- /dev/null
+++ b/internal/sbi/processor/akma.go
@@ -0,0 +1,44 @@
+package processor
+
+import (
+	"regexp"
+
+	"github.com/free5gc/openapi/models"
+	"github.com/free5gc/udm/internal/logger"
+	"github.com/free5gc/udm/pkg/suci"
+)
+
+// routingIdPattern is the pattern of routingId (TS29505_Subscription_Data.yaml).
+var routingIdPattern = regexp.MustCompile(`^[0-9]{1,4}$`)
+
+// setAkmaIndication fills akmaInd and routingId of the
+// Nudm_UEAuthentication_Get response when the subscriber has an AKMA
+// subscription (TS 33.501 cl. 6.1.3.1 step 2 and cl. 6.1.3.2.0 step 2;
+// TS 29.503 table 6.3.6.2.3-1).
+//
+// The Routing Indicator is the routingId stored with the authentication
+// subscription, which TS 29.505 table 5.4.2.2-1 makes mandatory when
+// akmaAllowed is true; it is available whether the request carries a SUCI or
+// a SUPI. When the request carries a SUCI, its Routing Indicator is compared
+// with the stored one and a difference is logged.
+func setAkmaIndication(rsp *models.UdmUeauAuthenticationInfoResult,
+	subs *models.AuthenticationSubscription, supiOrSuci, supi string,
+) {
+	if !subs.AkmaAllowed {
+		logger.AkmaLog.Debugf("No AKMA subscription for %s", supi)
+		return
+	}
+	rid := subs.RoutingId
+	if !routingIdPattern.MatchString(rid) {
+		logger.AkmaLog.Errorf("AKMA allowed for %s, but the stored routingId %q is not a Routing Indicator: "+
+			"AKMA indication not sent", supi, rid)
+		return
+	}
+	if suciRid, ok := suci.RoutingIndicator(supiOrSuci); ok && suciRid != rid {
+		logger.AkmaLog.Warnf("Routing Indicator of the SUCI (%s) differs from the stored routingId (%s) for %s",
+			suciRid, rid, supi)
+	}
+	rsp.AkmaInd = true
+	rsp.RoutingId = rid
+	logger.AkmaLog.Infof("AKMA indication sent to the AUSF for %s, Routing Indicator %s", supi, rid)
+}
diff --git a/internal/sbi/processor/akma_test.go b/internal/sbi/processor/akma_test.go
