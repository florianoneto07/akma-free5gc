diff --git a/internal/sbi/api_authtrigger.go b/internal/sbi/api_authtrigger.go
new file mode 100644
index 0000000..ee98955
--- /dev/null
+++ b/internal/sbi/api_authtrigger.go
@@ -0,0 +1,96 @@
+package sbi
+
+import (
+	"net/http"
+	"regexp"
+	"strings"
+
+	"github.com/gin-gonic/gin"
+
+	"github.com/free5gc/openapi"
+	"github.com/free5gc/openapi/models"
+	"github.com/free5gc/udm/internal/logger"
+	"github.com/free5gc/util/metrics/sbi"
+	"github.com/free5gc/util/validator"
+)
+
+// HandleAuthTrigger serves the custom operation trigger-auth (TS 29.503
+// clauses 5.3.2.16 and 6.2.3.13): POST
+// {apiRoot}/nudm-uecm/v1/{ueId}/registrations/trigger-auth with an
+// AuthTriggerInfo, sent for example by the AAnF to refresh K_AKMA (TS 33.535
+// clause 6.4.4).
+func (s *Server) HandleAuthTrigger(c *gin.Context) {
+	ueID := c.Param("ueId")
+	if !validator.IsValidSupi(ueID) {
+		authTriggerBadRequest(c, "MANDATORY_IE_INCORRECT", "The ueId is not a SUPI")
+		return
+	}
+
+	requestBody, err := c.GetRawData()
+	if err != nil {
+		problemDetail := openapi.ProblemDetailsSystemFailure(err.Error())
+		logger.UecmLog.Errorf("Get Request Body error: %+v", err)
+		c.Set(sbi.IN_PB_DETAILS_CTX_STR, problemDetail.Cause)
+		c.JSON(http.StatusInternalServerError, problemDetail)
+		return
+	}
+
+	var authTriggerInfo models.AuthTriggerInfo
+	if err = openapi.Deserialize(&authTriggerInfo, requestBody, "application/json"); err != nil {
+		authTriggerBadRequest(c, "", "[Request Body] "+err.Error())
+		return
+	}
+	// The request body carries the SUPI (table 6.2.3.13.4.2.2-1), although
+	// AuthTriggerInfo declares the attribute optional.
+	switch authTriggerInfo.Supi {
+	case "":
+		authTriggerBadRequest(c, "MANDATORY_IE_MISSING", "Mandatory IE [supi] is missing")
+		return
+	case ueID:
+	default:
+		authTriggerBadRequest(c, "MANDATORY_IE_INCORRECT", "The supi of the body differs from the ueId")
+		return
+	}
+
+	s.Processor().AuthTriggerProcedure(c, ueID, requester(c))
+}
+
+// HandleAuthTriggerMethodNotAllowed answers GET on trigger-auth. The operation
+// is a custom operation mapped to POST (table 6.2.3.13.4.1-1; TS 29.501 clause
+// 4.6.1.2), although TS29503_Nudm_UECM.yaml declares it with get.
+func (s *Server) HandleAuthTriggerMethodNotAllowed(c *gin.Context) {
+	problemDetail := models.ProblemDetails{
+		Title:  "Method not allowed",
+		Status: http.StatusMethodNotAllowed,
+		Detail: "trigger-auth is a custom operation with POST (TS 29.503 table 6.2.3.13.4.1-1)",
+	}
+	logger.UecmLog.Warnf("AuthTrigger with %s from %s refused: only POST", c.Request.Method, requester(c))
+	c.Header("Allow", http.MethodPost)
+	c.Set(sbi.IN_PB_DETAILS_CTX_STR, http.StatusText(http.StatusMethodNotAllowed))
+	c.JSON(http.StatusMethodNotAllowed, problemDetail)
+}
+
+func authTriggerBadRequest(c *gin.Context, cause, detail string) {
+	problemDetail := models.ProblemDetails{
+		Title:  "Malformed request syntax",
+		Status: http.StatusBadRequest,
+		Detail: detail,
+		Cause:  cause,
+	}
+	logger.UecmLog.Warnf("AuthTrigger from %s refused: %s", requester(c), detail)
+	c.Set(sbi.IN_PB_DETAILS_CTX_STR, http.StatusText(http.StatusBadRequest))
+	c.JSON(http.StatusBadRequest, problemDetail)
+}
+
+// nfTypePattern is the form of an NF type of TS 29.510 table 6.1.6.3.3-1.
+var nfTypePattern = regexp.MustCompile(`^[A-Z][A-Z0-9_]*$`)
+
+// requester names the NF service consumer in the logs: the NF type that
+// starts its User-Agent header (TS 29.500 table 5.2.2.2-1), and its address.
+func requester(c *gin.Context) string {
+	nfType, _, _ := strings.Cut(c.GetHeader("User-Agent"), "-")
+	if !nfTypePattern.MatchString(nfType) {
+		return c.ClientIP()
+	}
+	return nfType + " at " + c.ClientIP()
+}
