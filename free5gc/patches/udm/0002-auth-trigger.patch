@@ -0,0 +1,174 @@
+package processor
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"testing"
+	"time"
+
+	"github.com/gin-gonic/gin"
+	"github.com/h2non/gock"
+	"github.com/stretchr/testify/require"
+	"go.uber.org/mock/gomock"
+
+	"github.com/free5gc/openapi"
+	"github.com/free5gc/openapi/models"
+	udm_context "github.com/free5gc/udm/internal/context"
+	"github.com/free5gc/udm/internal/sbi/consumer"
+	mockapp "github.com/free5gc/udm/pkg/mockapp"
+)
+
+const (
+	authTriggerUdr = "http://127.0.0.4:8000"
+	authTriggerAmf = "http://127.0.0.18:8000"
+)
+
+// authTriggerUe stores in the UDM a UE whose authentication subscription is
+// in the mocked UDR and, with callback, an AMF registration for 3GPP access
+// with that reauthNotifyCallbackUri.
+func authTriggerUe(supi, callback string, registered bool) {
+	ue := new(udm_context.UdmUeContext)
+	ue.Init()
+	ue.Supi = supi
+	ue.UdrUri = authTriggerUdr
+	if registered {
+		ue.Amf3GppAccessRegistration = &models.Amf3GppAccessRegistration{
+			AmfInstanceId:           "8f1c5b2e-0000-4000-8000-000000000018",
+			DeregCallbackUri:        authTriggerAmf + "/namf-callback/v1/deregistration/" + supi,
+			ReauthNotifyCallbackUri: callback,
+			Guami:                   &models.Guami{AmfId: "cafe00"},
+			RatType:                 models.RatType_NR,
+		}
+	}
+	udm_context.GetSelf().UdmUePool.Store(supi, ue)
+}
+
+// runAuthTrigger runs AuthTriggerProcedure with the UDR answering udrStatus
+// for the authentication subscription and returns the recorder.
+func runAuthTrigger(t *testing.T, supi string, udrStatus int) *httptest.ResponseRecorder {
+	t.Helper()
+	gock.New(authTriggerUdr+"/nudr-dr/v2").
+		Get("/subscription-data/"+supi+"/authentication-data/authentication-subscription").
+		Reply(udrStatus).
+		AddHeader("Content-Type", "application/json").
+		JSON(map[string]string{"authenticationMethod": "5G_AKA"})
+
+	ctrl := gomock.NewController(t)
+	mockApp := mockapp.NewMockApp(ctrl)
+	testConsumer, err := consumer.NewConsumer(mockApp)
+	require.NoError(t, err)
+	testProcessor, err := NewProcessor(mockApp)
+	require.NoError(t, err)
+	self := udm_context.GetSelf()
+	self.OAuth2Required = false
+	mockApp.EXPECT().Consumer().Return(testConsumer).AnyTimes()
+	mockApp.EXPECT().Context().Return(self).AnyTimes()
+
+	rec := httptest.NewRecorder()
+	c, _ := gin.CreateTestContext(rec)
+	testProcessor.AuthTriggerProcedure(c, supi, "AANF at 127.0.0.1")
+	// As gin does at the end of a request: a status without a body is
+	// written here.
+	c.Writer.WriteHeaderNow()
+	return rec
+}
+
+// amfAnswers mocks the AMF answering the re-authentication notification of
+// supi with status and cause, and checks the body of the notification.
+func amfAnswers(supi string, status int, cause string) {
+	r := gock.New(authTriggerAmf).
+		Post("/namf-callback/v1/reauth/" + supi).
+		MatchType("json").
+		JSON(models.ReauthNotificationInfo{Supi: supi}).
+		Reply(status)
+	if cause != "" {
+		r.AddHeader("Content-Type", "application/problem+json").
+			JSON(models.ProblemDetails{Status: int32(status), Cause: cause})
+	}
+}
+
+func problemOf(t *testing.T, rec *httptest.ResponseRecorder) models.ProblemDetails {
+	t.Helper()
+	var pd models.ProblemDetails
+	require.NoError(t, openapi.Deserialize(&pd, rec.Body.Bytes(), "application/json"))
+	return pd
+}
+
+func TestAuthTrigger(t *testing.T) {
+	defer gock.Off()
+	openapi.InterceptH2CClient()
+	defer openapi.RestoreH2CClient()
+
+	cases := []struct {
+		name       string
+		supi       string
+		registered bool
+		noCallback bool
+		udrStatus  int
+		amfStatus  int
+		amfCause   string
+		wantStatus int
+		wantCause  string
+	}{
+		{"AMF accepts", "imsi-208930000000101", true, false, 200, 204, "", 204, ""},
+		{"AMF sets the pending flag", "imsi-208930000000102", true, false, 200, 202, "", 204, ""},
+		{"unknown user", "imsi-208930000000103", true, false, 404, 0, "", 404, "USER_NOT_FOUND"},
+		{"no AMF registration", "imsi-208930000000104", false, false, 200, 0, "", 404, "CONTEXT_NOT_FOUND"},
+		{"registration without callback", "imsi-208930000000105", true, true, 200, 0, "", 403,
+			"REAUTHENTICATION_NOT_ALLOWED"},
+		{"AMF refuses", "imsi-208930000000106", true, false, 200, 403, "REAUTHENTICATION_NOT_ALLOWED", 403,
+			"REAUTHENTICATION_NOT_ALLOWED"},
+		{"registration in progress at the AMF", "imsi-208930000000107", true, false, 200, 409,
+			"TEMPORARY_REJECT_REGISTRATION_ONGOING", 403, "REAUTHENTICATION_NOT_ALLOWED"},
+		{"AMF without the UE", "imsi-208930000000108", true, false, 200, 404, "CONTEXT_NOT_FOUND", 404,
+			"CONTEXT_NOT_FOUND"},
+		{"AMF fails", "imsi-208930000000109", true, false, 200, 500, "SYSTEM_FAILURE", 500, "SYSTEM_FAILURE"},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			callback := authTriggerAmf + "/namf-callback/v1/reauth/" + tc.supi
+			if tc.noCallback {
+				callback = ""
+			}
+			authTriggerUe(tc.supi, callback, tc.registered)
+			if tc.amfStatus != 0 {
+				amfAnswers(tc.supi, tc.amfStatus, tc.amfCause)
+			}
+			rec := runAuthTrigger(t, tc.supi, tc.udrStatus)
+			require.Equal(t, tc.wantStatus, rec.Code, rec.Body.String())
+			if tc.wantCause != "" {
+				require.Equal(t, tc.wantCause, problemOf(t, rec).Cause)
+			}
+		})
+	}
+	require.True(t, gock.IsDone(), "pending mocks: %v", gock.Pending())
+}
+
+// TS 33.501 cl. 6.1.5.2, NOTE A: the UDM refuses another AuthTrigger for the
+// same SUPI within authTriggerInterval of an accepted one; a refusal of the
+// AMF does not count.
+func TestAuthTriggerInterval(t *testing.T) {
+	defer gock.Off()
+	openapi.InterceptH2CClient()
+	defer openapi.RestoreH2CClient()
+
+	const supi = "imsi-208930000000110"
+	authTriggerUe(supi, authTriggerAmf+"/namf-callback/v1/reauth/"+supi, true)
+
+	amfAnswers(supi, 409, "TEMPORARY_REJECT_HANDOVER_ONGOING")
+	require.Equal(t, http.StatusForbidden, runAuthTrigger(t, supi, 200).Code)
+
+	amfAnswers(supi, 204, "")
+	require.Equal(t, http.StatusNoContent, runAuthTrigger(t, supi, 200).Code)
+
+	rec := runAuthTrigger(t, supi, 200)
+	require.Equal(t, http.StatusForbidden, rec.Code)
+	require.Equal(t, "REAUTHENTICATION_NOT_ALLOWED", problemOf(t, rec).Cause)
+
+	// After the interval, a new AuthTrigger is accepted.
+	authTriggers.Lock()
+	authTriggers.accepted[supi] = time.Now().Add(-authTriggerInterval)
+	authTriggers.Unlock()
+	amfAnswers(supi, 204, "")
+	require.Equal(t, http.StatusNoContent, runAuthTrigger(t, supi, 200).Code)
+}
