@@ -0,0 +1,81 @@
+package sbi
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"github.com/gin-gonic/gin"
+	"github.com/stretchr/testify/require"
+)
+
+// authTriggerRouter serves the routes of trigger-auth. The requests of these
+// tests are refused before the processor.
+func authTriggerRouter(t *testing.T) *gin.Engine {
+	t.Helper()
+	s := &Server{}
+	router := gin.New()
+	n := 0
+	for _, r := range s.getUEContextManagementRoutes() {
+		if r.Pattern == "/:ueId/registrations/trigger-auth" {
+			router.Handle(r.Method, r.Pattern, r.HandlerFunc)
+			n++
+		}
+	}
+	require.Equal(t, 2, n)
+	return router
+}
+
+func TestAuthTriggerRequests(t *testing.T) {
+	router := authTriggerRouter(t)
+	cases := []struct {
+		name       string
+		method     string
+		ueID       string
+		body       string
+		wantStatus int
+		wantCause  string
+	}{
+		{"GET", http.MethodGet, "imsi-208930000000001", "", http.StatusMethodNotAllowed, ""},
+		{"ueId not a SUPI", http.MethodPost, "msisdn-0900000000", `{"supi":"msisdn-0900000000"}`,
+			http.StatusBadRequest, "MANDATORY_IE_INCORRECT"},
+		{"no supi", http.MethodPost, "imsi-208930000000001", `{}`, http.StatusBadRequest, "MANDATORY_IE_MISSING"},
+		{"supi of another UE", http.MethodPost, "imsi-208930000000001", `{"supi":"imsi-208930000000002"}`,
+			http.StatusBadRequest, "MANDATORY_IE_INCORRECT"},
+		{"malformed body", http.MethodPost, "imsi-208930000000001", `{"supi":`, http.StatusBadRequest, ""},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			req := httptest.NewRequest(tc.method, "/"+tc.ueID+"/registrations/trigger-auth",
+				strings.NewReader(tc.body))
+			req.Header.Set("Content-Type", "application/json")
+			req.Header.Set("User-Agent", "AANF-3b2c1a90-0000-4000-8000-000000000001")
+			rec := httptest.NewRecorder()
+			router.ServeHTTP(rec, req)
+			require.Equal(t, tc.wantStatus, rec.Code, rec.Body.String())
+			if tc.wantStatus == http.StatusMethodNotAllowed {
+				require.Equal(t, http.MethodPost, rec.Header().Get("Allow"))
+			}
+			if tc.wantCause != "" {
+				require.Contains(t, rec.Body.String(), `"cause":"`+tc.wantCause+`"`)
+			}
+		})
+	}
+}
+
+func TestRequester(t *testing.T) {
+	for _, tc := range []struct{ userAgent, want string }{
+		{"AANF-3b2c1a90-0000-4000-8000-000000000001", "AANF at 192.0.2.1"},
+		{"AMF", "AMF at 192.0.2.1"},
+		{"Go-http-client/1.1", "192.0.2.1"},
+		{"OpenAPI-Generator/1.0.0/go", "192.0.2.1"},
+		{"", "192.0.2.1"},
+	} {
+		c, _ := gin.CreateTestContext(httptest.NewRecorder())
+		c.Request = httptest.NewRequest(http.MethodPost, "/", nil)
+		c.Request.RemoteAddr = "192.0.2.1:41000"
+		c.Request.Header.Set("User-Agent", tc.userAgent)
+		require.Equal(t, tc.want, requester(c), tc.userAgent)
+	}
+}
