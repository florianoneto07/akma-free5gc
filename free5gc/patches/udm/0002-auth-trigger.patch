diff --git a/internal/sbi/processor/auth_trigger.go b/internal/sbi/processor/auth_trigger.go
new file mode 100644
index 0000000..8615edf
--- /dev/null
+++ b/internal/sbi/processor/auth_trigger.go
@@ -0,0 +1,180 @@
+package processor
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"net/http"
+	"sync"
+	"time"
+
+	"github.com/gin-gonic/gin"
+
+	"github.com/free5gc/openapi"
+	"github.com/free5gc/openapi/models"
+	"github.com/free5gc/openapi/udm/UEContextManagement"
+	Nudr_DataRepository "github.com/free5gc/openapi/udr/DataRepository"
+	"github.com/free5gc/udm/internal/logger"
+	"github.com/free5gc/util/metrics/sbi"
+)
+
+// authTriggerInterval is the local authentication policy of the UDM for the
+// requests of other NFs (TS 33.501 clause 6.1.5.2, NOTE A): another
+// AuthTrigger for the same SUPI within this interval of an accepted one is
+// refused.
+const authTriggerInterval = 60 * time.Second
+
+// reauthNotifyTimeout bounds the wait for the answer of the AMF.
+const reauthNotifyTimeout = 10 * time.Second
+
+// authTriggers holds when the last AuthTrigger of each SUPI was accepted.
+var authTriggers = struct {
+	sync.Mutex
+	accepted map[string]time.Time
+}{accepted: make(map[string]time.Time)}
+
+// AuthTriggerProcedure runs Nudm_UECM_AuthTrigger (TS 29.503 clause 5.3.2.16;
+// TS 33.501 clause 6.1.5.2 steps 1 and 2). The UDM checks the subscriber and
+// its policy, and notifies the AMF registered for 3GPP access with
+// Nudm_UECM_Re-AuthenticationNotification (TS 29.503 clause 5.3.2.15). It
+// answers after the AMF: 204 when the AMF accepted the notification, also when
+// the AMF set the authentication pending flag.
+func (p *Processor) AuthTriggerProcedure(c *gin.Context, supi, requester string) {
+	if pd := p.authTrigger(supi, requester); pd != nil {
+		logger.AkmaLog.Warnf("AuthTrigger for %s from %s refused: %d %s (%s)",
+			supi, requester, pd.Status, pd.Cause, pd.Detail)
+		c.Set(sbi.IN_PB_DETAILS_CTX_STR, pd.Cause)
+		c.JSON(int(pd.Status), pd)
+		return
+	}
+	c.Status(http.StatusNoContent)
+}
+
+func (p *Processor) authTrigger(supi, requester string) *models.ProblemDetails {
+	if pd := p.subscriberExists(supi); pd != nil {
+		return pd
+	}
+	ue, ok := p.Context().UdmUeFindBySupi(supi)
+	if !ok || ue.Amf3GppAccessRegistration == nil {
+		return authTriggerProblem(http.StatusNotFound, "CONTEXT_NOT_FOUND", "no AMF registered for 3GPP access")
+	}
+	registration := *ue.Amf3GppAccessRegistration
+	if registration.ReauthNotifyCallbackUri == "" {
+		return authTriggerProblem(http.StatusForbidden, "REAUTHENTICATION_NOT_ALLOWED",
+			"the AMF registration has no reauthNotifyCallbackUri")
+	}
+	if !reserveAuthTrigger(supi, time.Now()) {
+		return authTriggerProblem(http.StatusForbidden, "REAUTHENTICATION_NOT_ALLOWED",
+			fmt.Sprintf("an AuthTrigger for this SUPI was accepted less than %s ago", authTriggerInterval))
+	}
+
+	rsp, err := p.SendReauthNotification(registration.ReauthNotifyCallbackUri, supi)
+	if err != nil {
+		releaseAuthTrigger(supi)
+		return reauthNotificationProblem(err)
+	}
+	if rsp.Pending {
+		logger.AkmaLog.Infof("AuthTrigger for %s from %s: re-authentication notified to the AMF %s, "+
+			"pending until the UE is reachable", supi, requester, registration.AmfInstanceId)
+	} else {
+		logger.AkmaLog.Infof("AuthTrigger for %s from %s: re-authentication notified to the AMF %s",
+			supi, requester, registration.AmfInstanceId)
+	}
+	return nil
+}
+
+// subscriberExists looks up the authentication subscription of supi in the
+// UDR: without one, the user does not exist (TS 29.503 clause 5.3.2.16.2
+// step 2b).
+func (p *Processor) subscriberExists(supi string) *models.ProblemDetails {
+	ctx, pd, err := p.Context().GetTokenCtx(models.ServiceName_NUDR_DR, models.NrfNfManagementNfType_UDR)
+	if err != nil {
+		return pd
+	}
+	client, err := p.Consumer().CreateUDMClientToUDR(supi)
+	if err != nil {
+		return openapi.ProblemDetailsSystemFailure(err.Error())
+	}
+	var request Nudr_DataRepository.QueryAuthSubsDataRequest
+	request.UeId = &supi
+	if _, err = client.AuthenticationDataDocumentApi.QueryAuthSubsData(ctx, &request); err != nil {
+		var apiError openapi.GenericOpenAPIError
+		if errors.As(err, &apiError) && apiError.ErrorStatus == http.StatusNotFound {
+			return authTriggerProblem(http.StatusNotFound, "USER_NOT_FOUND", "no subscription for the SUPI")
+		}
+		return openapi.ProblemDetailsSystemFailure(err.Error())
+	}
+	return nil
+}
+
+// SendReauthNotification sends Nudm_UECM_Re-AuthenticationNotification with
+// the SUPI to the reauthNotifyCallbackUri of the AMF (TS 29.503 clause
+// 5.3.2.15.2). The request has no access token: OAuth 2.0 does not apply to
+// notifications (TS 29.500 clause 6.7.3; TS 33.501 clause 13.4.1.0).
+func (p *Processor) SendReauthNotification(uri, supi string) (
+	*UEContextManagement.Call3GppRegistrationReauthNotificationPostResponse, error,
+) {
+	ctx, cancel := context.WithTimeout(context.Background(), reauthNotifyTimeout)
+	defer cancel()
+	var request UEContextManagement.Call3GppRegistrationReauthNotificationPostRequest
+	request.SetReauthNotificationInfo(models.ReauthNotificationInfo{Supi: supi})
+	clientAPI := p.Consumer().GetUECMClient("SendReauthNotification")
+	return clientAPI.AMFRegistrationFor3GPPAccessApi.Call3GppRegistrationReauthNotificationPost(ctx, uri, &request)
+}
+
+// reauthNotificationProblem maps a failure of the notification to the answer
+// of trigger-auth (table 6.2.3.13.4.2.2-2): a refusal of the AMF becomes 403
+// REAUTHENTICATION_NOT_ALLOWED, including the 409 of a registration or a
+// handover in progress (table 6.2.5.6-3), which trigger-auth does not list.
+func reauthNotificationProblem(err error) *models.ProblemDetails {
+	var apiError openapi.GenericOpenAPIError
+	if !errors.As(err, &apiError) {
+		return openapi.ProblemDetailsSystemFailure("notification to the AMF failed: " + err.Error())
+	}
+	cause := ""
+	if v, ok := apiError.Model().(UEContextManagement.Call3GppRegistrationReauthNotificationPostError); ok {
+		cause = v.ProblemDetails.Cause
+	}
+	switch apiError.ErrorStatus {
+	case http.StatusForbidden, http.StatusConflict:
+		return authTriggerProblem(http.StatusForbidden, "REAUTHENTICATION_NOT_ALLOWED",
+			fmt.Sprintf("the AMF refused the re-authentication: %d %s", apiError.ErrorStatus, cause))
+	case http.StatusNotFound:
+		return authTriggerProblem(http.StatusNotFound, "CONTEXT_NOT_FOUND", "the AMF has no context of the UE")
+	}
+	return openapi.ProblemDetailsSystemFailure(
+		fmt.Sprintf("the AMF answered the notification with %d %s", apiError.ErrorStatus, cause))
+}
+
+func authTriggerProblem(status int32, cause, detail string) *models.ProblemDetails {
+	return &models.ProblemDetails{
+		Title:  http.StatusText(int(status)),
+		Status: status,
+		Cause:  cause,
+		Detail: detail,
+	}
+}
+
+// reserveAuthTrigger records an AuthTrigger for supi at now, unless one was
+// accepted within authTriggerInterval.
+func reserveAuthTrigger(supi string, now time.Time) bool {
+	authTriggers.Lock()
+	defer authTriggers.Unlock()
+	for s, t := range authTriggers.accepted {
+		if now.Sub(t) >= authTriggerInterval {
+			delete(authTriggers.accepted, s)
+		}
+	}
+	if _, ok := authTriggers.accepted[supi]; ok {
+		return false
+	}
+	authTriggers.accepted[supi] = now
+	return true
+}
+
+// releaseAuthTrigger forgets the AuthTrigger of supi that the AMF refused.
+func releaseAuthTrigger(supi string) {
+	authTriggers.Lock()
+	defer authTriggers.Unlock()
+	delete(authTriggers.accepted, supi)
+}
