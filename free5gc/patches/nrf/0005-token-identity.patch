diff --git a/internal/util/peer.go b/internal/util/peer.go
new file mode 100644
index 0000000..15bb971
--- /dev/null
+++ b/internal/util/peer.go
@@ -0,0 +1,72 @@
+package util
+
+import (
+	"crypto/tls"
+	"fmt"
+	"regexp"
+	"strings"
+
+	"github.com/free5gc/openapi/models"
+	"github.com/free5gc/openapi/sbitls"
+)
+
+// homeNetworkDomain finds the PLMN of the Home Network Domain in the O of the
+// Subject of a certificate (TS 33.310 table 6.1.3c.3-1; TS 23.003 cl. 28.2).
+var homeNetworkDomain = regexp.MustCompile(`(?:^|\.)mnc([0-9]{3})\.mcc([0-9]{3})\.3gppnetwork\.org$`)
+
+// CheckPeer compares an NF instance ID and an NF type, when given, with the
+// client certificate of the session. Without TLS, as in the test bench of
+// free5GC, there is no certificate to compare.
+func CheckPeer(state *tls.ConnectionState, nfInstanceId, nfType string) error {
+	cert := sbitls.PeerCertificate(state)
+	if cert == nil {
+		return nil
+	}
+	if nfInstanceId != "" {
+		id, err := sbitls.NfInstanceId(cert)
+		if err != nil {
+			return err
+		}
+		if !strings.EqualFold(id, nfInstanceId) {
+			return fmt.Errorf("NF instance %s, the certificate is of %s", nfInstanceId, id)
+		}
+	}
+	if nfType == "" {
+		return nil
+	}
+	types, err := sbitls.NfTypes(cert)
+	if err != nil {
+		return err
+	}
+	for _, t := range types {
+		if strings.EqualFold(t, nfType) {
+			return nil
+		}
+	}
+	return fmt.Errorf("NF type %s, the certificate is of %s", nfType, strings.Join(types, ","))
+}
+
+// CheckPeerPlmn compares a PLMN, when given, with the O of the client
+// certificate of the session. A two-digit MNC has a zero on the left in the
+// domain (TS 23.003 cl. 28.2).
+func CheckPeerPlmn(state *tls.ConnectionState, plmn *models.PlmnId) error {
+	cert := sbitls.PeerCertificate(state)
+	if cert == nil || plmn == nil {
+		return nil
+	}
+	mnc := plmn.Mnc
+	if len(mnc) == 2 {
+		mnc = "0" + mnc
+	}
+	for _, organization := range cert.Subject.Organization {
+		match := homeNetworkDomain.FindStringSubmatch(organization)
+		if match == nil {
+			continue
+		}
+		if match[1] == mnc && match[2] == plmn.Mcc {
+			return nil
+		}
+		return fmt.Errorf("PLMN %s-%s, the certificate is of %s", plmn.Mcc, plmn.Mnc, organization)
+	}
+	return fmt.Errorf("PLMN %s-%s, the certificate has no Home Network Domain", plmn.Mcc, plmn.Mnc)
+}
