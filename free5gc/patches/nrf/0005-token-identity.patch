+// scopeGranted tells whether the NF services of a producer give a scope to an
+// NF type. A service with allowedOperationsPerNfType gives only what the list
+// has for the NF type: any other NF type is disallowed (TS 29.510
+// table 6.1.6.2.3-1 NOTE 11). Without the list, the scope is the name of the
+// service, for the allowedNfTypes.
+func scopeGranted(services []models.NrfNfManagementNfService, scope, nfType string) bool {
+	for i := range services {
+		service := &services[i]
+		if len(service.AllowedOperationsPerNfType) > 0 {
+			if slices.Contains(service.AllowedOperationsPerNfType[nfType], scope) {
+				return true
+			}
+			continue
+		}
+		if string(service.ServiceName) != scope {
+			continue
+		}
+		if len(service.AllowedNfTypes) == 0 {
+			return true
+		}
+		for _, allowed := range service.AllowedNfTypes {
+			if string(allowed) == nfType {
+				return true
+			}
+		}
+	}
+	return false
+}
