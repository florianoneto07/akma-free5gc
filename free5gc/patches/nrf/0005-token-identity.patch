+++ b/internal/context/token_test.go
@@ -0,0 +1,95 @@
+package context
+
+import (
+	"crypto/ecdsa"
+	"crypto/elliptic"
+	"crypto/rand"
+	"crypto/x509"
+	"crypto/x509/pkix"
+	"encoding/asn1"
+	"encoding/pem"
+	"math/big"
+	"net/url"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"github.com/golang-jwt/jwt/v5"
+	"github.com/stretchr/testify/require"
+	"golang.org/x/oauth2"
+
+	"github.com/free5gc/nrf/pkg/factory"
+	"github.com/free5gc/openapi"
+	"github.com/free5gc/openapi/models"
+)
+
+const testNrfId = "cdee1983-45ab-41a6-8f5b-6f832d5206e8"
+
+// tokenPair writes the certificate of the access tokens of an NF instance and
+// its key.
+func tokenPair(t *testing.T, id string) (certFile, keyFile string) {
+	t.Helper()
+	key, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	require.NoError(t, err)
+	uri, err := url.Parse("urn:uuid:" + id)
+	require.NoError(t, err)
+	template := &x509.Certificate{
+		SerialNumber: big.NewInt(1), Subject: pkix.Name{CommonName: id},
+		NotBefore: time.Now().Add(-time.Hour), NotAfter: time.Now().Add(time.Hour),
+		URIs:               []*url.URL{uri},
+		UnknownExtKeyUsage: []asn1.ObjectIdentifier{{1, 3, 6, 1, 5, 5, 7, 3, 39}},
+	}
+	der, err := x509.CreateCertificate(rand.Reader, template, template, &key.PublicKey, key)
+	require.NoError(t, err)
+	pkcs8, err := x509.MarshalPKCS8PrivateKey(key)
+	require.NoError(t, err)
+	dir := t.TempDir()
+	certFile, keyFile = filepath.Join(dir, "nrf-token.pem"), filepath.Join(dir, "nrf-token.key")
+	require.NoError(t, os.WriteFile(certFile, pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: der}), 0o600))
+	require.NoError(t, os.WriteFile(keyFile, pem.EncodeToMemory(&pem.Block{Type: "PRIVATE KEY", Bytes: pkcs8}), 0o600))
+	return certFile, keyFile
+}
+
+func nrfConfig(certFile, keyFile string) *factory.Config {
+	return &factory.Config{
+		Info: &factory.Info{Version: "1.0.0"},
+		Configuration: &factory.Configuration{
+			NfInstanceId: testNrfId,
+			Sbi: &factory.Sbi{
+				Scheme: "https", RegisterIPv4: "127.0.0.10", BindingIPv4: "127.0.0.10", Port: 8000, OAuth: true,
+				Cert: &factory.Cert{Pem: certFile, Key: keyFile},
+			},
+		},
+	}
+}
+
+func TestInitNrfContextToken(t *testing.T) {
+	certFile, keyFile := tokenPair(t, testNrfId)
+	factory.NrfConfig = nrfConfig(certFile, keyFile)
+	require.NoError(t, InitNrfContext())
+
+	ctx, pd, err := GetSelf().GetTokenCtx(models.ServiceName_NNRF_NFM, models.NrfNfManagementNfType_AMF)
+	require.NoError(t, err)
+	require.Nil(t, pd)
+	source, ok := ctx.Value(openapi.ContextOAuth2).(oauth2.TokenSource)
+	require.True(t, ok)
+	token, err := source.Token()
+	require.NoError(t, err)
+
+	claims := jwt.MapClaims{}
+	parsed, _, err := jwt.NewParser().ParseUnverified(token.AccessToken, claims)
+	require.NoError(t, err)
+	require.Equal(t, "ES256", parsed.Header["alg"])
+	require.NotEmpty(t, parsed.Header["kid"])
+	require.NotEmpty(t, parsed.Header["x5t#S256"])
+	require.Equal(t, testNrfId, claims["iss"])
+	require.Equal(t, testNrfId, claims["sub"])
+	require.Equal(t, "AMF", claims["aud"])
+}
+
+func TestInitNrfContextAnotherIssuer(t *testing.T) {
+	certFile, keyFile := tokenPair(t, "5a6d7127-edf7-4edc-960c-e4105ff023d8")
+	factory.NrfConfig = nrfConfig(certFile, keyFile)
+	require.ErrorContains(t, InitNrfContext(), "of NF instance 5a6d7127")
+}
