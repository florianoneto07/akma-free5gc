+++ b/internal/util/peer_test.go
@@ -0,0 +1,59 @@
+package util
+
+import (
+	"crypto/tls"
+	"crypto/x509"
+	"crypto/x509/pkix"
+	"encoding/asn1"
+	"net/url"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+
+	"github.com/free5gc/openapi/models"
+)
+
+const peerId = "0383f793-0b51-4fc6-996e-a9a8bafc4ce1"
+
+func peerState(t *testing.T, id, nfType, organization string) *tls.ConnectionState {
+	t.Helper()
+	cert := &x509.Certificate{Subject: pkix.Name{Organization: []string{organization}}}
+	if id != "" {
+		uri, err := url.Parse("urn:uuid:" + id)
+		require.NoError(t, err)
+		cert.URIs = []*url.URL{uri}
+	}
+	if nfType != "" {
+		value, err := asn1.Marshal([]string{nfType})
+		require.NoError(t, err)
+		value[2] = asn1.TagIA5String
+		cert.Extensions = []pkix.Extension{{Id: asn1.ObjectIdentifier{1, 3, 6, 1, 5, 5, 7, 1, 34}, Value: value}}
+	}
+	return &tls.ConnectionState{PeerCertificates: []*x509.Certificate{cert}}
+}
+
+func TestCheckPeer(t *testing.T) {
+	state := peerState(t, peerId, "AF", "5gc.mnc093.mcc208.3gppnetwork.org")
+	require.NoError(t, CheckPeer(state, peerId, "AF"))
+	require.NoError(t, CheckPeer(state, "0383F793-0B51-4FC6-996E-A9A8BAFC4CE1", "af"))
+	require.NoError(t, CheckPeer(state, "", "AF"), "without the NF instance ID")
+	require.NoError(t, CheckPeer(state, peerId, ""), "without the NF type")
+	require.NoError(t, CheckPeer(nil, peerId, "AF"), "without TLS")
+
+	require.Error(t, CheckPeer(state, "5a6d7127-edf7-4edc-960c-e4105ff023d8", "AF"), "another NF instance")
+	require.Error(t, CheckPeer(state, peerId, "AUSF"), "another NF type")
+	require.Error(t, CheckPeer(peerState(t, "", "AF", ""), peerId, ""), "no NF instance in the certificate")
+	require.Error(t, CheckPeer(peerState(t, peerId, "", ""), "", "AF"), "no NF type in the certificate")
+}
+
+func TestCheckPeerPlmn(t *testing.T) {
+	state := peerState(t, peerId, "AF", "5gc.mnc093.mcc208.3gppnetwork.org")
+	require.NoError(t, CheckPeerPlmn(state, nil), "without the PLMN")
+	require.NoError(t, CheckPeerPlmn(nil, &models.PlmnId{Mcc: "208", Mnc: "93"}), "without TLS")
+	require.NoError(t, CheckPeerPlmn(state, &models.PlmnId{Mcc: "208", Mnc: "93"}), "two-digit MNC")
+	require.NoError(t, CheckPeerPlmn(state, &models.PlmnId{Mcc: "208", Mnc: "093"}), "three-digit MNC")
+
+	require.Error(t, CheckPeerPlmn(state, &models.PlmnId{Mcc: "208", Mnc: "94"}))
+	require.Error(t, CheckPeerPlmn(state, &models.PlmnId{Mcc: "209", Mnc: "93"}))
+	require.Error(t, CheckPeerPlmn(peerState(t, peerId, "AF", "free5GC"), &models.PlmnId{Mcc: "208", Mnc: "93"}))
+}
