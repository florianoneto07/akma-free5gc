--- /dev/null
+++ b/internal/sbi/peer_test.go
@@ -0,0 +1,76 @@
+package sbi
+
+import (
+	"crypto/tls"
+	"crypto/x509"
+	"crypto/x509/pkix"
+	"encoding/asn1"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"testing"
+
+	"github.com/gin-gonic/gin"
+	"github.com/stretchr/testify/require"
+
+	"github.com/free5gc/nrf/internal/sbi/processor"
+	"github.com/free5gc/openapi/models"
+)
+
+const peerId = "0383f793-0b51-4fc6-996e-a9a8bafc4ce1"
+
+func peerContext(t *testing.T, method, target string) (*gin.Context, *httptest.ResponseRecorder) {
+	t.Helper()
+	gin.SetMode(gin.TestMode)
+	uri, err := url.Parse("urn:uuid:" + peerId)
+	require.NoError(t, err)
+	value, err := asn1.Marshal([]string{"AF"})
+	require.NoError(t, err)
+	value[2] = asn1.TagIA5String
+	w := httptest.NewRecorder()
+	c, _ := gin.CreateTestContext(w)
+	c.Request = httptest.NewRequest(method, target, nil)
+	c.Request.TLS = &tls.ConnectionState{PeerCertificates: []*x509.Certificate{{
+		URIs:       []*url.URL{uri},
+		Extensions: []pkix.Extension{{Id: asn1.ObjectIdentifier{1, 3, 6, 1, 5, 5, 7, 1, 34}, Value: value}},
+	}}}
+	return c, w
+}
+
+func TestPeerMatches(t *testing.T) {
+	c, w := peerContext(t, http.MethodPut, "/nnrf-nfm/v1/nf-instances/"+peerId)
+	require.True(t, peerMatches(c, peerId, "AF"))
+	require.Equal(t, http.StatusOK, w.Code)
+
+	for name, args := range map[string][2]string{
+		"another NF instance": {"5a6d7127-edf7-4edc-960c-e4105ff023d8", "AF"},
+		"another NF type":     {peerId, "AUSF"},
+	} {
+		t.Run(name, func(t *testing.T) {
+			c, w := peerContext(t, http.MethodPut, "/nnrf-nfm/v1/nf-instances/"+args[0])
+			require.False(t, peerMatches(c, args[0], args[1]))
+			require.Equal(t, http.StatusForbidden, w.Code)
+			require.Equal(t, "application/problem+json", w.Header().Get("Content-Type"))
+			var pd models.ProblemDetails
+			require.NoError(t, json.Unmarshal(w.Body.Bytes(), &pd))
+			require.Empty(t, pd.Cause, "TS 29.500 table 5.2.7.1-1: 403 without cause")
+		})
+	}
+}
+
+func TestAccessTokenRequestOfAnotherNf(t *testing.T) {
+	for name, req := range map[string]models.NrfAccessTokenAccessTokenReq{
+		"NF instance": {NfInstanceId: "5a6d7127-edf7-4edc-960c-e4105ff023d8", NfType: "AF"},
+		"NF type":     {NfInstanceId: peerId, NfType: "AUSF"},
+	} {
+		t.Run(name, func(t *testing.T) {
+			c, w := peerContext(t, http.MethodPost, "/oauth2/token")
+			(&processor.Processor{}).HandleAccessTokenRequest(c, req)
+			require.Equal(t, http.StatusBadRequest, w.Code)
+			require.JSONEq(t, `{"error":"invalid_client"}`, w.Body.String())
+			require.Equal(t, "no-store", w.Header().Get("Cache-Control"))
+			require.Equal(t, "no-cache", w.Header().Get("Pragma"))
+		})
+	}
+}
