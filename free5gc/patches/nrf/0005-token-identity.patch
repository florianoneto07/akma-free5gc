+package processor
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/require"
+
+	"github.com/free5gc/openapi/models"
+)
+
+func TestScopeGranted(t *testing.T) {
+	services := []models.NrfNfManagementNfService{{
+		ServiceName: models.ServiceName_NAANF_AKMA,
+		AllowedOperationsPerNfType: map[string][]string{
+			"AUSF": {"naanf-akma", "naanf-akma:anchorkey"},
+			"NEF":  {"naanf-akma", "naanf-akma:applicationkeyget"},
+		},
+	}}
+	require.True(t, scopeGranted(services, "naanf-akma", "AUSF"))
+	require.True(t, scopeGranted(services, "naanf-akma:anchorkey", "AUSF"))
+	require.False(t, scopeGranted(services, "naanf-akma:applicationkeyget", "AUSF"), "outside the list of the type")
+	require.False(t, scopeGranted(services, "naanf-akma", "AMF"), "a type outside the lists is disallowed")
+
+	// Without the list: the name of the service, for allowedNfTypes.
+	services = []models.NrfNfManagementNfService{{
+		ServiceName:    models.ServiceName_NUDM_SDM,
+		AllowedNfTypes: []models.NrfNfManagementNfType{models.NrfNfManagementNfType_AMF},
+	}, {
+		ServiceName: models.ServiceName_NUDM_UECM,
+	}}
+	require.True(t, scopeGranted(services, "nudm-sdm", "AMF"))
+	require.False(t, scopeGranted(services, "nudm-sdm", "SMF"))
+	require.True(t, scopeGranted(services, "nudm-uecm", "SMF"), "no allowedNfTypes")
+	require.False(t, scopeGranted(services, "nudm-sdm:read", "AMF"), "no operation scope without the list")
+}
