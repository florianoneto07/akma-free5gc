@@ -0,0 +1,30 @@
+package factory
+
+import (
+	"testing"
+
+	"github.com/asaskevich/govalidator"
+)
+
+// With https, the FQDN is mandatory (TS 29.510 table 6.1.6.2.2-1 NOTE 1;
+// F24); with http, the URIs may go by IP address.
+func TestSbiFqdnRequiredWithHttps(t *testing.T) {
+	govalidator.TagMap["scheme"] = func(str string) bool { return str == "https" || str == "http" }
+	sbi := &Sbi{Scheme: "https", RegisterIPv4: "127.0.0.10", BindingIPv4: "127.0.0.10", Port: 8000}
+	_, err := sbi.validate()
+	if err == nil {
+		t.Fatal("https without fqdn accepted")
+	}
+	// The factory of the NF reads the errors as govalidator.Errors.
+	if _, ok := err.(govalidator.Errors); !ok {
+		t.Fatalf("error of type %T, not govalidator.Errors", err)
+	}
+	sbi.Fqdn = "nrf.5gc.mnc093.mcc208.3gppnetwork.org"
+	if _, err := sbi.validate(); err != nil {
+		t.Fatalf("https with fqdn refused: %v", err)
+	}
+	sbi = &Sbi{Scheme: "http", RegisterIPv4: "127.0.0.10", BindingIPv4: "127.0.0.10", Port: 8000}
+	if _, err := sbi.validate(); err != nil {
+		t.Fatalf("http without fqdn refused: %v", err)
+	}
+}
