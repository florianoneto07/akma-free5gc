+// GetSbiFqdn returns the FQDN of the NRF (TS 23.003 cl. 28.3.2.3.2), empty when
+// the URIs go by IP address.
+func (c *Config) GetSbiFqdn() string {
+	if c == nil || c.Configuration == nil || c.Configuration.Sbi == nil {
+		return ""
+	}
+	c.RLock()
+	defer c.RUnlock()
+	return c.Configuration.Sbi.Fqdn
+}
+
+// GetSbiTls returns the TLS section of the SBI, nil without it.
