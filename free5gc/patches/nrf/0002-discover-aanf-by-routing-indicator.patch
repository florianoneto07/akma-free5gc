+
+// aanfRoutingIndicatorFilter matches the AAnF profiles that serve the Routing
+// Indicator ri (TS 29.510 table 6.1.6.2.73-1): profiles without aanfInfoList,
+// and profiles with an AanfInfo entry that lists ri or has no
+// routingIndicators ("If not provided, the AAnf can serve any Routing
+// Indicator"). aanfInfoList is a map with arbitrary keys, so its entries are
+// visited with $objectToArray.
+func aanfRoutingIndicatorFilter(ri string) bson.M {
+	return bson.M{
+		"$or": []bson.M{
+			{
+				"aanfInfoList": bson.M{
+					"$exists": false,
+				},
+			},
+			{
+				"$expr": bson.M{
+					"$gt": []interface{}{
+						bson.M{"$size": bson.M{"$filter": bson.M{
+							"input": bson.M{"$objectToArray": bson.M{"$ifNull": []interface{}{"$aanfInfoList", bson.M{}}}},
+							"as":    "entry",
+							"cond": bson.M{"$or": []interface{}{
+								bson.M{"$not": []interface{}{bson.M{"$isArray": "$$entry.v.routingIndicators"}}},
+								bson.M{"$in": []interface{}{ri, "$$entry.v.routingIndicators"}},
+							}},
+						}}},
+						0,
+					},
+				},
+			},
+		},
+	}
+}
diff --git a/internal/sbi/processor/nf_discovery_aanf_test.go b/internal/sbi/processor/nf_discovery_aanf_test.go
