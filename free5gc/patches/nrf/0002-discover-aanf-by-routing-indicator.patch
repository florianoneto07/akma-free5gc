@@ -0,0 +1,63 @@
+package processor
+
+import (
+	"net/url"
+	"reflect"
+	"testing"
+
+	"go.mongodb.org/mongo-driver/bson"
+)
+
+func TestValidateQueryParametersNfTypes(t *testing.T) {
+	cases := []struct {
+		target, requester string
+		want              bool
+	}{
+		{"AANF", "AUSF", true},
+		{"AANF", "AF", true},
+		{"AUSF", "AANF", true},
+		{"UDM", "AUSF", true},
+		{"N3IWF", "AMF", true},
+		{"NOT_AN_NF", "AUSF", false},
+		{"AANF", "", false},
+		{"", "AUSF", false},
+	}
+	for _, c := range cases {
+		q := url.Values{}
+		if c.target != "" {
+			q.Set("target-nf-type", c.target)
+		}
+		if c.requester != "" {
+			q.Set("requester-nf-type", c.requester)
+		}
+		if got := validateQueryParameters(q); got != c.want {
+			t.Errorf("target %q requester %q: got %v, want %v", c.target, c.requester, got, c.want)
+		}
+	}
+}
+
+// TS 29.510 table 6.2.3.2.3.1-1: routing-indicator "may be included if the
+// target NF type is "AUSF", "AANF" or "UDM"".
+func TestBuildFilterAanfRoutingIndicator(t *testing.T) {
+	q := url.Values{}
+	q.Set("target-nf-type", "AANF")
+	q.Set("requester-nf-type", "AUSF")
+	q.Set("routing-indicator", "0000")
+	filter, err := buildFilter(q)
+	if err != nil {
+		t.Fatal(err)
+	}
+	want := aanfRoutingIndicatorFilter("0000")
+	found := false
+	for _, f := range filter["$and"].([]bson.M) {
+		found = found || reflect.DeepEqual(f, want)
+	}
+	if !found {
+		t.Errorf("filter %v lacks the AAnF routing indicator condition", filter)
+	}
+	// The Routing Indicator is compared as a string: "0000" stays "0000".
+	in := want["$or"].([]bson.M)[1]["$expr"].(bson.M)["$gt"].([]interface{})[0].(bson.M)["$size"].(bson.M)["$filter"].(bson.M)["cond"].(bson.M)["$or"].([]interface{})[1].(bson.M)["$in"].([]interface{})
+	if s, ok := in[0].(string); !ok || s != "0000" {
+		t.Errorf("routing indicator in the filter = %#v", in[0])
+	}
+}
