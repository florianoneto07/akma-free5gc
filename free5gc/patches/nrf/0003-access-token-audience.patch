index 0000000..48d74aa
--- /dev/null
+++ b/internal/sbi/processor/access_token_aud_test.go
@@ -0,0 +1,26 @@
+package processor
+
+import (
+	"testing"
+
+	"github.com/free5gc/openapi/models"
+)
+
+// TS 29.510 table 6.3.5.2.4-1: "aud" is mandatory; NF instance ID of the
+// producer when known, otherwise its NF type.
+func TestAccessTokenAudience(t *testing.T) {
+	byType := models.NrfAccessTokenAccessTokenReq{TargetNfType: "AANF"}
+	if got := accessTokenAudience(byType); got != "AANF" {
+		t.Errorf("by type: %v", got)
+	}
+	lower := models.NrfAccessTokenAccessTokenReq{TargetNfType: "aanf"}
+	if got := accessTokenAudience(lower); got != "AANF" {
+		t.Errorf("lower case type: %v", got)
+	}
+	byID := models.NrfAccessTokenAccessTokenReq{
+		TargetNfType: "AANF", TargetNfInstanceId: "b6f417f0-06fa-4c38-b291-33066f5a5fe7",
+	}
+	if got := accessTokenAudience(byID); got != "b6f417f0-06fa-4c38-b291-33066f5a5fe7" {
+		t.Errorf("by instance: %v", got)
+	}
+}
