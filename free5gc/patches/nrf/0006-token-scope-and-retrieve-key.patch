+
+// F27: the scope is checked on every REGISTERED profile of the target NF
+// type, or on the profile of targetNfInstanceId; an old profile without the
+// service does not block the token.
+func TestScopesGranted(t *testing.T) {
+	akma := []models.NrfNfManagementNfService{{
+		ServiceName:    models.ServiceName("3gpp-akma"),
+		AllowedNfTypes: []models.NrfNfManagementNfType{models.NrfNfManagementNfType_AF},
+	}}
+	stale := models.NrfNfManagementNfProfile{
+		NfInstanceId: "11111111-1111-4111-8111-111111111111", NfType: models.NrfNfManagementNfType_NEF,
+		NfStatus: models.NrfNfManagementNfStatus_REGISTERED,
+	}
+	current := models.NrfNfManagementNfProfile{
+		NfInstanceId: "22222222-2222-4222-8222-222222222222", NfType: models.NrfNfManagementNfType_NEF,
+		NfStatus: models.NrfNfManagementNfStatus_REGISTERED, NfServices: akma,
+	}
+	suspended := current
+	suspended.NfInstanceId = "33333333-3333-4333-8333-333333333333"
+	suspended.NfStatus = models.NrfNfManagementNfStatus_SUSPENDED
+	req := models.NrfAccessTokenAccessTokenReq{TargetNfType: models.NrfNfManagementNfType_NEF, Scope: "3gpp-akma"}
+
+	require.True(t, scopesGranted([]models.NrfNfManagementNfProfile{stale, current}, req, "AF"),
+		"the old profile, first, does not block")
+	require.False(t, scopesGranted([]models.NrfNfManagementNfProfile{stale}, req, "AF"))
+	require.False(t, scopesGranted([]models.NrfNfManagementNfProfile{stale, current}, req, "SMF"),
+		"allowedNfTypes of the service")
+	require.False(t, scopesGranted([]models.NrfNfManagementNfProfile{suspended}, req, "AF"),
+		"without targetNfInstanceId, only REGISTERED profiles")
+
+	req.TargetNfInstanceId = stale.NfInstanceId
+	require.False(t, scopesGranted([]models.NrfNfManagementNfProfile{stale, current}, req, "AF"),
+		"only the profile of the instance")
+	req.TargetNfInstanceId = suspended.NfInstanceId
+	require.True(t, scopesGranted([]models.NrfNfManagementNfProfile{stale, suspended}, req, "AF"),
+		"the instance asked for")
+
+	req = models.NrfAccessTokenAccessTokenReq{TargetNfType: models.NrfNfManagementNfType_NEF, Scope: "3gpp-akma nnef-pfdmanagement"}
+	require.False(t, scopesGranted([]models.NrfNfManagementNfProfile{current}, req, "AF"), "every scope")
+}
diff --git a/internal/sbi/processor/retrieve_key.go b/internal/sbi/processor/retrieve_key.go
new file mode 100644
index 0000000..83d9dd3
--- /dev/null
+++ b/internal/sbi/processor/retrieve_key.go
@@ -0,0 +1,102 @@
+package processor
+
+import (
+	"bytes"
+	"crypto/x509"
+	"encoding/json"
+	"mime/multipart"
+	"net/http"
+	"net/textproto"
+	"strings"
+
+	"github.com/gin-gonic/gin"
+
+	nrf_context "github.com/free5gc/nrf/internal/context"
+	"github.com/free5gc/nrf/internal/logger"
+	"github.com/free5gc/nrf/internal/util"
+	"github.com/free5gc/openapi/models"
+	"github.com/free5gc/util/metrics/sbi"
+)
+
+// x509CertContentId is the Content-ID of the binary body part with the
+// certificate (TS 29.510 cl. 6.3.3.4).
+const x509CertContentId = "x509Cert"
+
+// HandleRetrieveKeyRequest serves the Retrieve Key Request custom operation
+// (TS 29.510 cl. 5.4.2.3 and 6.3.4.3; TS 33.501 cl. 14.3.3): the certificate
+// that validates the signature of the access tokens of this NRF, found by the
+// header parameters of a token.
+func (p *Processor) HandleRetrieveKeyRequest(c *gin.Context, req models.RetrieveKeyReq) {
+	signer := nrf_context.GetSelf().TokenSigner
+	if signer == nil || !strings.EqualFold(req.Issuer, signer.Issuer()) {
+		logger.AccTokenLog.Warnf("Retrieve Key Request for unknown issuer %q", req.Issuer)
+		writeRetrieveKeyProblem(c, http.StatusNotFound, "UNKNOWN_ISSUER", "the issuer is not this NRF")
+		return
+	}
+	if !signer.Identifies(req.HeaderParameters) {
+		logger.AccTokenLog.Warnf("Retrieve Key Request: header parameters %v identify no key", req.HeaderParameters)
+		writeRetrieveKeyProblem(c, http.StatusBadRequest, "KEY_IDENTIFICATION_FAIL",
+			"the header parameters do not identify the signing key")
+		return
+	}
+	body, contentType, err := retrieveKeyRsp(signer.Certificate())
+	if err != nil {
+		logger.AccTokenLog.Errorf("Retrieve Key Request: %v", err)
+		util.GinProblemJson(c, &models.ProblemDetails{
+			Status: http.StatusInternalServerError,
+			Cause:  "SYSTEM_FAILURE",
+		})
+		return
+	}
+	logger.AccTokenLog.Infof("Retrieve Key Request: signing certificate of %s returned", signer.Issuer())
+	c.Data(http.StatusOK, contentType, body)
+}
+
+// retrieveKeyRsp encodes the response as a multipart message
+// (TS 29.510 cl. 6.3.3.2.2 and 6.3.3.4): the RetrieveKeyRsp JSON body part
+// first, as the root, with a "type" parameter, and the certificate in ASN.1
+// DER as an "application/pkix-cert" binary body part (cl. 6.3.5.5.2).
+func retrieveKeyRsp(cert *x509.Certificate) (body []byte, contentType string, err error) {
+	rsp, err := json.Marshal(models.RetrieveKeyRsp{
+		X509Cert: &models.RefToBinaryData{ContentId: x509CertContentId},
+	})
+	if err != nil {
+		return nil, "", err
+	}
+	var buf bytes.Buffer
+	w := multipart.NewWriter(&buf)
+	h := textproto.MIMEHeader{}
+	h.Set("Content-Type", "application/json")
+	part, err := w.CreatePart(h)
+	if err != nil {
+		return nil, "", err
+	}
+	if _, err = part.Write(rsp); err != nil {
+		return nil, "", err
+	}
+	h = textproto.MIMEHeader{}
+	h.Set("Content-Type", "application/pkix-cert")
+	h.Set("Content-ID", x509CertContentId)
+	if part, err = w.CreatePart(h); err != nil {
+		return nil, "", err
+	}
+	if _, err = part.Write(cert.Raw); err != nil {
+		return nil, "", err
+	}
+	if err = w.Close(); err != nil {
+		return nil, "", err
+	}
+	return buf.Bytes(), `multipart/related; type="application/json"; boundary=` + w.Boundary(), nil
+}
+
+// writeRetrieveKeyProblem answers with the ProblemDetails of
+// TS 29.510 table 6.3.4.3.2-2.
+func writeRetrieveKeyProblem(c *gin.Context, status int, cause, detail string) {
+	c.Set(sbi.IN_PB_DETAILS_CTX_STR, cause)
+	util.GinProblemJson(c, &models.ProblemDetails{
+		Title:  http.StatusText(status),
+		Status: int32(status),
+		Cause:  cause,
+		Detail: detail,
+	})
+}
diff --git a/internal/sbi/processor/retrieve_key_test.go b/internal/sbi/processor/retrieve_key_test.go
new file mode 100644
index 0000000..55db3f6
--- /dev/null
+++ b/internal/sbi/processor/retrieve_key_test.go
@@ -0,0 +1,138 @@
+package processor
+
+import (
+	"bytes"
+	"crypto/ecdsa"
+	"crypto/elliptic"
+	"crypto/rand"
+	"crypto/sha256"
+	"crypto/x509"
+	"crypto/x509/pkix"
+	"encoding/asn1"
+	"encoding/base64"
+	"encoding/json"
+	"encoding/pem"
+	"io"
+	"math/big"
+	"mime"
+	"mime/multipart"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"github.com/gin-gonic/gin"
+	"github.com/stretchr/testify/require"
+
+	nrf_context "github.com/free5gc/nrf/internal/context"
+	"github.com/free5gc/openapi/models"
+	"github.com/free5gc/openapi/oauth"
+)
+
+const retrieveKeyNrfId = "cdee1983-45ab-41a6-8f5b-6f832d5206e8"
+
+// tokenSigner makes the key pair of the access tokens of the NRF: a
+// certificate with id-kp-oauthAccessTokenSigning and the URI of the NF
+// instance ID (TS 33.310 table 6.1.3c.3-2).
+func tokenSigner(t *testing.T) (*oauth.Signer, *x509.Certificate) {
+	t.Helper()
+	key, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	require.NoError(t, err)
+	uri, err := url.Parse("urn:uuid:" + retrieveKeyNrfId)
+	require.NoError(t, err)
+	template := &x509.Certificate{
+		SerialNumber: big.NewInt(1), Subject: pkix.Name{CommonName: "NRF access token signing"},
+		NotBefore: time.Now().Add(-time.Hour), NotAfter: time.Now().Add(time.Hour),
+		URIs:               []*url.URL{uri},
+		UnknownExtKeyUsage: []asn1.ObjectIdentifier{{1, 3, 6, 1, 5, 5, 7, 3, 39}},
+	}
+	der, err := x509.CreateCertificate(rand.Reader, template, template, &key.PublicKey, key)
+	require.NoError(t, err)
+	cert, err := x509.ParseCertificate(der)
+	require.NoError(t, err)
+	pkcs8, err := x509.MarshalPKCS8PrivateKey(key)
+	require.NoError(t, err)
+	dir := t.TempDir()
+	certFile, keyFile := filepath.Join(dir, "nrf-token.pem"), filepath.Join(dir, "nrf-token.key")
+	require.NoError(t, os.WriteFile(certFile, pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: der}), 0o600))
+	require.NoError(t, os.WriteFile(keyFile, pem.EncodeToMemory(&pem.Block{Type: "PRIVATE KEY", Bytes: pkcs8}), 0o600))
+	signer, err := oauth.NewSigner(certFile, keyFile)
+	require.NoError(t, err)
+	return signer, cert
+}
+
+func retrieveKey(t *testing.T, req models.RetrieveKeyReq) *httptest.ResponseRecorder {
+	t.Helper()
+	gin.SetMode(gin.TestMode)
+	w := httptest.NewRecorder()
+	c, _ := gin.CreateTestContext(w)
+	c.Request = httptest.NewRequest(http.MethodPost, "/oauth2/retrieve-key", nil)
+	(&Processor{}).HandleRetrieveKeyRequest(c, req)
+	return w
+}
+
+func requireProblem(t *testing.T, w *httptest.ResponseRecorder, status int, cause string) {
+	t.Helper()
+	require.Equal(t, status, w.Code)
+	require.Equal(t, "application/problem+json", w.Header().Get("Content-Type"))
+	var pd models.ProblemDetails
+	require.NoError(t, json.Unmarshal(w.Body.Bytes(), &pd))
+	require.Equal(t, cause, pd.Cause)
+}
+
+// TS 29.510 cl. 5.4.2.3 and 6.3.4.3: the certificate in a multipart response
+// (cl. 6.3.3.4), KEY_IDENTIFICATION_FAIL and UNKNOWN_ISSUER.
+func TestRetrieveKey(t *testing.T) {
+	signer, cert := tokenSigner(t)
+	self := nrf_context.GetSelf()
+	saved := self.TokenSigner
+	t.Cleanup(func() { self.TokenSigner = saved })
+
+	self.TokenSigner = nil
+	requireProblem(t, retrieveKey(t, models.RetrieveKeyReq{
+		Issuer: retrieveKeyNrfId, HeaderParameters: map[string]string{"kid": "k"},
+	}), http.StatusNotFound, "UNKNOWN_ISSUER")
+
+	self.TokenSigner = signer
+	sum := sha256.Sum256(cert.Raw)
+	x5t := base64.RawURLEncoding.EncodeToString(sum[:])
+
+	w := retrieveKey(t, models.RetrieveKeyReq{
+		Issuer: retrieveKeyNrfId, HeaderParameters: map[string]string{"x5t#S256": x5t, "alg": "ES256"},
+	})
+	require.Equal(t, http.StatusOK, w.Code)
+	mediaType, params, err := mime.ParseMediaType(w.Header().Get("Content-Type"))
+	require.NoError(t, err)
+	require.Equal(t, "multipart/related", mediaType)
+	require.Equal(t, "application/json", params["type"])
+	r := multipart.NewReader(bytes.NewReader(w.Body.Bytes()), params["boundary"])
+
+	root, err := r.NextPart()
+	require.NoError(t, err)
+	require.Equal(t, "application/json", root.Header.Get("Content-Type"))
+	var rsp models.RetrieveKeyRsp
+	require.NoError(t, json.NewDecoder(root).Decode(&rsp))
+	require.NotNil(t, rsp.X509Cert)
+	require.Empty(t, rsp.RawPubKey)
+	require.Nil(t, rsp.CertChain)
+
+	part, err := r.NextPart()
+	require.NoError(t, err)
+	require.Equal(t, "application/pkix-cert", part.Header.Get("Content-Type"))
+	require.Equal(t, rsp.X509Cert.ContentId, part.Header.Get("Content-ID"))
+	der, err := io.ReadAll(part)
+	require.NoError(t, err)
+	require.Equal(t, cert.Raw, der)
+	_, err = r.NextPart()
+	require.Equal(t, io.EOF, err)
+
+	requireProblem(t, retrieveKey(t, models.RetrieveKeyReq{
+		Issuer: "0b5fa9c6-8f3c-4bb4-a3a3-6d3c4a7d0e51", HeaderParameters: map[string]string{"x5t#S256": x5t},
+	}), http.StatusNotFound, "UNKNOWN_ISSUER")
+	requireProblem(t, retrieveKey(t, models.RetrieveKeyReq{
+		Issuer: retrieveKeyNrfId, HeaderParameters: map[string]string{"kid": "another key"},
+	}), http.StatusBadRequest, "KEY_IDENTIFICATION_FAIL")
+}
