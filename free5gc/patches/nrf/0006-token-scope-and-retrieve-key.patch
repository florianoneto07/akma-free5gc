--- a/internal/sbi/api_accesstoken.go
+++ b/internal/sbi/api_accesstoken.go
@@ -11,6 +11,7 @@ package sbi
 
 import (
 	"encoding/json"
+	"mime"
 	"net/http"
 	"reflect"
 
@@ -38,7 +39,64 @@ func (s *Server) getAccesstokenRoutes() []Route {
 			"/oauth2/token",
 			s.HTTPAccessTokenRequest,
 		},
+		{
+			"RetrieveKeyRequest",
+			http.MethodPost,
+			"/oauth2/retrieve-key",
+			s.HTTPRetrieveKeyRequest,
+		},
+	}
+}
+
+// HTTPRetrieveKeyRequest is POST {nrfApiRoot}/oauth2/retrieve-key, the
+// Retrieve Key Request custom operation (TS 29.510 cl. 6.3.4.3): the request
+// body is a RetrieveKeyReq in JSON (cl. 6.3.3.2.2).
+func (s *Server) HTTPRetrieveKeyRequest(c *gin.Context) {
+	if mt, _, err := mime.ParseMediaType(c.GetHeader("Content-Type")); err != nil || mt != "application/json" {
+		util.GinProblemJson(c, &models.ProblemDetails{
+			Title:  "Unsupported Media Type",
+			Status: http.StatusUnsupportedMediaType,
+			Detail: "the request body shall be application/json",
+		})
+		return
+	}
+	body, err := c.GetRawData()
+	if err != nil {
+		util.GinProblemJson(c, &models.ProblemDetails{
+			Title:  "System failure",
+			Status: http.StatusInternalServerError,
+			Cause:  "SYSTEM_FAILURE",
+		})
+		return
+	}
+	var req models.RetrieveKeyReq
+	if err = json.Unmarshal(body, &req); err != nil {
+		util.GinProblemJson(c, &models.ProblemDetails{
+			Title:  "Malformed request syntax",
+			Status: http.StatusBadRequest,
+			Cause:  "INVALID_MSG_FORMAT",
+			Detail: "the body is not a RetrieveKeyReq",
+		})
+		return
+	}
+	// Both attributes are mandatory (TS 29.510 table 6.3.5.2.7-1).
+	var missing []models.InvalidParam
+	if req.Issuer == "" {
+		missing = append(missing, models.InvalidParam{Param: "/issuer", Reason: "required"})
+	}
+	if len(req.HeaderParameters) == 0 {
+		missing = append(missing, models.InvalidParam{Param: "/headerParameters", Reason: "required"})
+	}
+	if len(missing) > 0 {
+		util.GinProblemJson(c, &models.ProblemDetails{
+			Title:         "Bad Request",
+			Status:        http.StatusBadRequest,
+			Cause:         "MANDATORY_IE_MISSING",
+			InvalidParams: missing,
+		})
+		return
 	}
+	s.Processor().HandleRetrieveKeyRequest(c, req)
 }
 
