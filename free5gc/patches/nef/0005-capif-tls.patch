+// issuedBy reports whether the client certificate of a session was issued by
+// the CA in caPEM.
+func issuedBy(state *tls.ConnectionState, caPEM string) bool {
+	if state == nil || len(state.VerifiedChains) == 0 || len(state.VerifiedChains[0]) < 2 {
+		return false
+	}
+	block, _ := pem.Decode([]byte(caPEM))
+	if block == nil {
+		return false
+	}
+	ca, err := x509.ParseCertificate(block.Bytes)
+	return err == nil && ca.Equal(state.VerifiedChains[0][1])
+}
