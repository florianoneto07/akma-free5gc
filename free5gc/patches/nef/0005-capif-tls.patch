+func TestIssuedBy(t *testing.T) {
+	own, caPEM := capifPeer(t, capifInvokerId)
+	_, otherPEM := capifPeer(t, capifInvokerId)
+	require.True(t, issuedBy(own, caPEM))
+	require.False(t, issuedBy(own, otherPEM))
+	require.False(t, issuedBy(own, capifCaCertPEM))
+	require.False(t, issuedBy(own, ""))
+	require.False(t, issuedBy(nil, caPEM))
