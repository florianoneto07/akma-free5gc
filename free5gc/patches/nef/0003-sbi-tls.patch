diff --git a/internal/sbi/client_ca.go b/internal/sbi/client_ca.go
new file mode 100644
index 0000000..c53f426
--- /dev/null
+++ b/internal/sbi/client_ca.go
@@ -0,0 +1,36 @@
+package sbi
+
+import (
+	"net/http"
+	"strings"
+
+	"github.com/gin-gonic/gin"
+
+	"github.com/free5gc/nef/internal/sbi/processor"
+	"github.com/free5gc/nef/pkg/factory"
+	"github.com/free5gc/openapi/models"
+	"github.com/free5gc/openapi/sbitls"
+)
+
+// capifRequest says whether a request is on CAPIF-2e: the APIs of the API
+// invokers, as API exposing function (3GPP TS 29.522 clause 7.1).
+func capifRequest(path string) bool {
+	return strings.HasPrefix(path, factory.AkmaResUriPrefix) ||
+		strings.HasPrefix(path, factory.AefSecurityResUriPrefix)
+}
+
+// checkClientCA keeps each client on its side of the NEF: a certificate of the
+// CA of the API invokers only on CAPIF-2e, and a certificate of the CA of the
+// operator only on the SBI. The server accepts both in the handshake, before
+// it knows the API. Without TLS, there is no certificate to check.
+func checkClientCA(c *gin.Context) {
+	if c.Request.TLS == nil || sbitls.IsExtraClient(c.Request.TLS) == capifRequest(c.Request.URL.Path) {
+		return
+	}
+	processor.WriteAkmaProblem(c, &models.ProblemDetails{
+		Title:  "Forbidden",
+		Status: http.StatusForbidden,
+		Detail: "client certificate of another CA for this API",
+	})
+	c.Abort()
+}
diff --git a/internal/sbi/client_ca_test.go b/internal/sbi/client_ca_test.go
new file mode 100644
index 0000000..b7f6ebf
--- /dev/null
+++ b/internal/sbi/client_ca_test.go
@@ -0,0 +1,41 @@
+package sbi
+
+import (
+	"crypto/tls"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+
+	"github.com/gin-gonic/gin"
+)
+
+func TestCheckClientCA(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	cases := []struct {
+		name   string
+		path   string
+		tls    *tls.ConnectionState
+		status int
+	}{
+		{"http, CAPIF-2e", "/3gpp-akma/v1/retrieve", nil, http.StatusOK},
+		{"http, SBI", "/nnef-pfdmanagement/v1/x", nil, http.StatusOK},
+		{"operator certificate on the AKMA API", "/3gpp-akma/v1/retrieve", &tls.ConnectionState{}, http.StatusForbidden},
+		{"operator certificate on AEF_Security_API", "/aef-security/v1/check-authentication",
+			&tls.ConnectionState{}, http.StatusForbidden},
+		{"operator certificate on the SBI", "/nnef-pfdmanagement/v1/x", &tls.ConnectionState{}, http.StatusOK},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			router := gin.New()
+			router.Use(checkClientCA)
+			router.POST(c.path, func(gc *gin.Context) { gc.Status(http.StatusOK) })
+			req := httptest.NewRequest(http.MethodPost, c.path, nil)
+			req.TLS = c.tls
+			rec := httptest.NewRecorder()
+			router.ServeHTTP(rec, req)
+			if rec.Code != c.status {
+				t.Errorf("status %d, want %d", rec.Code, c.status)
+			}
+		})
+	}
+}
