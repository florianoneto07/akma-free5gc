+// TestCapifPublication covers the publication of the AKMA API at the CAPIF
+// core function, again after a failure, and its withdrawal (3GPP TS 29.222
+// clauses 5.3.2.2 and 5.3.2.3).
+func TestCapifPublication(t *testing.T) {
+	setCapif(t, true)
+	interval := capifRetryInterval
+	capifRetryInterval = 10 * time.Millisecond
+	defer func() { capifRetryInterval = interval }()
+	var buf bytes.Buffer
+	out := logger.Log.Out
+	logger.Log.SetOutput(&buf)
+	defer logger.Log.SetOutput(out)
+
+	published := akmaServiceAPI(nefApp.Config().Capif())
+	require.Equal(t, int32(8000), published.AefProfiles[0].InterfaceDescriptions[0].Port)
+	publish := func() *gock.Request {
+		return gock.New(capifCcfUri + "/published-apis/v1").
+			Post("/nef-apf/service-apis").
+			MatchType("json").
+			JSON(published)
+	}
+	publish().Times(2).Reply(http.StatusServiceUnavailable)
+	stored := published
+	stored.ApiId = "api-1"
+	publish().Reply(http.StatusCreated).
+		SetHeader("Location", capifCcfUri+"/published-apis/v1/nef-apf/service-apis/api-1").
+		JSON(stored)
+
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	nefApp.Processor().RunCapifPublication(ctx)
+	require.NoError(t, ctx.Err())
+	logs := buf.String()
+	require.Equal(t, 1, strings.Count(logs, "Publication of 3gpp-akma at the CCF failed"))
+	require.Contains(t, logs, "3gpp-akma published at the CCF as api-1")
+
+	gock.New(capifCcfUri + "/published-apis/v1").
+		Delete("/nef-apf/service-apis/api-1").
+		Reply(http.StatusNoContent)
+	nefApp.Processor().CapifUnpublish()
+	require.Contains(t, buf.String(), "3gpp-akma api-1 unpublished at the CCF")
+	// Nothing published any more.
+	nefApp.Processor().CapifUnpublish()
+	require.Equal(t, 1, strings.Count(buf.String(), "unpublished"))
+
+	// The publication stops with the NEF.
+	ctx, cancel = context.WithCancel(context.Background())
+	go func() {
+		time.Sleep(50 * time.Millisecond)
+		cancel()
+	}()
+	done := make(chan struct{})
+	go func() {
+		nefApp.Processor().RunCapifPublication(ctx)
+		close(done)
+	}()
+	select {
+	case <-done:
+	case <-time.After(5 * time.Second):
+		t.Fatal("the publication did not stop")
+	}
+}
