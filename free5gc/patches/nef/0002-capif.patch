+// TestCapifRetrieve covers the AF_ID of a K_AF request with an access token
+// of the CAPIF core function: in the profile of the API invoker and in the
+// address policy (3GPP TS 29.522 clause 7.2; TS 33.535 clause 6.3 step 2).
+func TestCapifRetrieve(t *testing.T) {
+	setCapif(t, true)
+	var buf bytes.Buffer
+	out := logger.Log.Out
+	logger.Log.SetOutput(&buf)
+	defer logger.Log.SetOutput(out)
+
+	inv := nef_context.CapifInvoker{Id: capifInvokerId, AkmaAfIds: map[string]struct{}{akmaAfId: {}}}
+	retrieve := func(req models.AkmaAfKeyRequest, remote string) *httptest.ResponseRecorder {
+		w := httptest.NewRecorder()
+		c, _ := gin.CreateTestContext(w)
+		c.Request = httptest.NewRequest(http.MethodPost, factory.AkmaResUriPrefix+"/retrieve", nil)
+		c.Set(capifInvokerKey, inv)
+		nefApp.Processor().RetrieveAkmaApplicationKey(c, &req, netip.MustParseAddr(remote))
+		c.Writer.WriteHeaderNow()
+		return w
+	}
+
+	initNRFDiscAANFStub(true)
+	initAANFRetrieveStub(false, http.StatusOK, `{"kaf":"`+akmaKaf+`","expiry":"2026-10-19T20:00:00Z"}`)
+	w := retrieve(models.AkmaAfKeyRequest{AfId: akmaAfId, AKId: akmaAKId}, akmaAfAddr)
+	require.Equal(t, http.StatusOK, w.Code)
+	require.Contains(t, buf.String(), "Access token of API invoker "+capifInvokerId+" accepted for AF_ID "+akmaAfId)
+
+	// In the address policy, outside the profile of the API invoker.
+	w = retrieve(models.AkmaAfKeyRequest{AfId: capifOtherAfId, AKId: akmaAKId}, akmaAfAddr)
+	require.Equal(t, http.StatusForbidden, w.Code)
+	pd := akmaProblem(t, w)
+	require.Empty(t, pd.Cause)
+	require.Equal(t, "AF_ID not authorized for the API invoker", pd.Detail)
+	require.Contains(t, buf.String(), "AF_ID "+capifOtherAfId+" outside the profile of API invoker "+capifInvokerId)
+
+	// In the profile, from an address outside the policy.
+	w = retrieve(models.AkmaAfKeyRequest{AfId: akmaAfId, AKId: akmaAKId}, "192.0.2.99")
+	require.Equal(t, http.StatusForbidden, w.Code)
+	pd = akmaProblem(t, w)
+	require.Empty(t, pd.Cause)
+	require.Equal(t, "AF not authorized by local policy", pd.Detail)
+}
