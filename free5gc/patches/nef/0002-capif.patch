+// TestCapifCheckAuthentication covers the check-authentication operation of
+// AEF_Security_API (3GPP TS 29.222 clauses 6.2.2.2 and 9.1).
+func TestCapifCheckAuthentication(t *testing.T) {
+	setCapif(t, true)
+	var buf bytes.Buffer
+	out := logger.Log.Out
+	logger.Log.SetOutput(&buf)
+	defer logger.Log.SetOutput(out)
+
+	check := func(req models.CapifCheckAuthenticationReq, remote string) *httptest.ResponseRecorder {
+		w := httptest.NewRecorder()
+		c, _ := gin.CreateTestContext(w)
+		c.Request = httptest.NewRequest(http.MethodPost, factory.AefSecurityResUriPrefix+"/check-authentication", nil)
+		nefApp.Processor().CheckAuthentication(c, &req, netip.MustParseAddr(remote))
+		c.Writer.WriteHeaderNow()
+		return w
+	}
+
+	initCCFInvokerInfoStub(capifInvokerId, http.StatusOK, akmaAfId)
+	w := check(models.CapifCheckAuthenticationReq{ApiInvokerId: capifInvokerId, SupportedFeatures: "0"}, akmaAfAddr)
+	require.Equal(t, http.StatusOK, w.Code)
+	require.JSONEq(t, `{"supportedFeatures":"0"}`, w.Body.String())
+	require.Contains(t, buf.String(), "check-authentication of API invoker "+capifInvokerId+": 1 AF_IDs from the CCF")
+
+	for _, tc := range []struct {
+		req   models.CapifCheckAuthenticationReq
+		cause string
+	}{
+		{models.CapifCheckAuthenticationReq{SupportedFeatures: "0"}, "MANDATORY_IE_MISSING"},
+		{models.CapifCheckAuthenticationReq{ApiInvokerId: capifInvokerId}, "MANDATORY_IE_MISSING"},
+		{models.CapifCheckAuthenticationReq{ApiInvokerId: capifInvokerId, SupportedFeatures: "xyz"},
+			"MANDATORY_IE_INCORRECT"},
+	} {
+		w := check(tc.req, akmaAfAddr)
+		require.Equal(t, http.StatusBadRequest, w.Code)
+		require.Equal(t, tc.cause, akmaProblem(t, w).Cause)
+	}
+
+	w = check(models.CapifCheckAuthenticationReq{ApiInvokerId: capifInvokerId, SupportedFeatures: "0"}, "192.0.2.99")
+	require.Equal(t, http.StatusForbidden, w.Code)
+
+	const gone = "0b4a3c2d-1e0f-4a5b-8c7d-6e5f4a3b2c1d"
+	initCCFInvokerInfoStub(gone, http.StatusNotFound)
+	w = check(models.CapifCheckAuthenticationReq{ApiInvokerId: gone, SupportedFeatures: "0"}, akmaAfAddr)
+	require.Equal(t, http.StatusForbidden, w.Code)
+
+	const fresh = "7c6b5a49-3827-4615-a4b3-c2d1e0f9a8b7"
+	gock.New(capifCcfUri + "/capif-security/v1").Get("/trustedInvokers/" + fresh).
+		ReplyError(errors.New("connection refused"))
+	w = check(models.CapifCheckAuthenticationReq{ApiInvokerId: fresh, SupportedFeatures: "0"}, akmaAfAddr)
+	require.Equal(t, http.StatusServiceUnavailable, w.Code)
+}
