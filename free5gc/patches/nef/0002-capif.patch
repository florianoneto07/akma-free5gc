+// Capif configures the NEF as API publishing function and API exposing
+// function of CAPIF for the AKMA API (3GPP TS 29.522 clause 7; TS 29.222).
+type Capif struct {
+	// CcfUri is the apiRoot of the CAPIF core function on CAPIF-3 and
+	// CAPIF-4.
+	CcfUri string `yaml:"ccfUri" valid:"required"`
+	ApfId  string `yaml:"apfId" valid:"required"`
+	AefId  string `yaml:"aefId" valid:"required"`
+	// TokenPublicKey is the PEM file of the ECDSA P-256 public key with which
+	// the CAPIF core function signs the access tokens (ES256, 3GPP TS 33.210
+	// clause 6.3.3.1).
+	TokenPublicKey string `yaml:"tokenPublicKey" valid:"required"`
+	// Interface is the address at which the AKMA API is published
+	// (InterfaceDescription, 3GPP TS 29.222 table 8.2.4.2.3-1).
+	Interface *CapifInterface `yaml:"interface" valid:"required"`
+	// InvokerInfoLifetime is how long the NEF keeps the data of an API
+	// invoker, a Go duration ("10m").
+	InvokerInfoLifetime string `yaml:"invokerInfoLifetime,omitempty" valid:"optional"`
+	// AllowNrfTokens keeps the AKMA API open to the access tokens of the NRF,
+	// as when CAPIF is not used (3GPP TS 29.522 clause 6).
+	AllowNrfTokens bool `yaml:"allowNrfTokens,omitempty" valid:"optional"`
+}
+
+type CapifInterface struct {
+	Ipv4Addr string `yaml:"ipv4Addr" valid:"required,ipv4"`
+	Port     int    `yaml:"port" valid:"required,port"`
+}
+
+// capifIdentifier matches the identifiers that go in a "scope" of CAPIF,
+// "3gpp#<aefId>:<API name>" (3GPP TS 29.222 table 8.5.4.2.6-1): no delimiter
+// of the scope and no white space.
+func capifIdentifier(s string) bool {
+	return s != "" && !strings.ContainsAny(s, "#:,; \t\r\n")
+}
+
+func (c *Capif) validate() error {
+	u, err := url.Parse(c.CcfUri)
+	if err != nil || (u.Scheme != "http" && u.Scheme != "https") || u.Host == "" ||
+		(u.Path != "" && u.Path != "/") {
+		return fmt.Errorf("invalid capif.ccfUri: expected \"http(s)://<host>:<port>\"")
+	}
+	if !capifIdentifier(c.ApfId) {
+		return errors.New("invalid capif.apfId")
+	}
+	if !capifIdentifier(c.AefId) {
+		return errors.New("invalid capif.aefId")
+	}
+	if c.Interface == nil || c.Interface.Ipv4Addr == "0.0.0.0" {
+		return errors.New("invalid capif.interface: an address the AFs can reach is required")
+	}
+	if _, err := c.GetInvokerInfoLifetime(); err != nil {
+		return err
+	}
+	return nil
+}
+
+// GetInvokerInfoLifetime returns how long the NEF keeps the data of an API
+// invoker.
+func (c *Capif) GetInvokerInfoLifetime() (time.Duration, error) {
+	if c.InvokerInfoLifetime == "" {
+		return NefCapifDefaultInvokerInfoLifetime, nil
+	}
+	d, err := time.ParseDuration(c.InvokerInfoLifetime)
+	if err != nil || d < time.Second {
+		return 0, fmt.Errorf("invalid capif.invokerInfoLifetime: a Go duration of at least 1s")
+	}
+	return d, nil
+}
