 	}
+	if capif {
+		logger.CapifLog.Infof("Access token of API invoker %s accepted for AF_ID %s", inv.Id, af.Transport())
+	}
 
 	// TS 33.535 clause 6.3 step 2 and clause 6.7: AAnF selection with the
 	// Routing Indicator of the A-KID.
diff --git a/internal/sbi/processor/capif.go b/internal/sbi/processor/capif.go
new file mode 100644
index 0000000..3615a16
--- /dev/null
+++ b/internal/sbi/processor/capif.go
@@ -0,0 +1,401 @@
+package processor
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"net/http"
+	"net/netip"
+	"regexp"
+	"strings"
+	"time"
+
+	"github.com/florianoneto07/akma-free5gc/shared/akma/afid"
+	nef_context "github.com/free5gc/nef/internal/context"
+	"github.com/free5gc/nef/internal/logger"
+	"github.com/free5gc/nef/pkg/factory"
+	"github.com/free5gc/openapi"
+	"github.com/free5gc/openapi/models"
+	"github.com/gin-gonic/gin"
+	"github.com/golang-jwt/jwt/v5"
+)
+
+const (
+	// capifLeeway is the clock skew accepted on the exp of an access token
+	// of the CAPIF core function (3GPP TS 33.122 Annex C.2.2: no more than
+	// 30 seconds).
+	capifLeeway = 30 * time.Second
+	// capifAlg is the JWS algorithm of the access tokens (3GPP TS 33.210
+	// clause 6.3.3.1).
+	capifAlg = "ES256"
+	// capifInvokerKey keeps, in the gin context, the API invoker of an
+	// accepted access token of the CAPIF core function.
+	capifInvokerKey = "capifInvoker"
+)
+
+// capifRetryInterval is the wait between two attempts to publish the AKMA
+// API at the CAPIF core function.
+var capifRetryInterval = 5 * time.Second
+
+// errCapifUnknownInvoker is the answer 404 of the CAPIF core function to
+// Obtain_API_Invoker_Info: the API invoker was offboarded, or the CAPIF core
+// function was restarted.
+var errCapifUnknownInvoker = errors.New("API invoker unknown at the CAPIF core function")
+
+// supportedFeaturesPattern is the SupportedFeatures type of 3GPP TS 29.571.
+var supportedFeaturesPattern = regexp.MustCompile(`^[A-Fa-f0-9]*$`)
+
+type capifResult int
+
+const (
+	// capifNotUsed: the request carries no access token of the CAPIF core
+	// function.
+	capifNotUsed capifResult = iota
+	capifAccepted
+	// capifRefused: the response is written.
+	capifRefused
+)
+
+// AkmaAuthorization authorizes a request of the AKMA API. With CAPIF, an
+// access token of the CAPIF core function is checked as 3GPP TS 29.522
+// clause 7.2 asks; any other request goes to nrfCheck, the access tokens of
+// the NRF of CAPIF not used (clause 6), when the configuration allows them.
+func (p *Processor) AkmaAuthorization(c *gin.Context, nrfCheck func(*gin.Context)) {
+	if p.Context().Capif == nil {
+		nrfCheck(c)
+		return
+	}
+	raw := bearerToken(c.GetHeader("Authorization"))
+	switch p.capifAuthorize(c, raw) {
+	case capifAccepted:
+		return
+	case capifRefused:
+		c.Abort()
+		return
+	}
+	if p.Config().Capif().AllowNrfTokens {
+		nrfCheck(c)
+		return
+	}
+	// RFC 6750 clause 3 and 3.1.
+	if raw == "" {
+		writeBearerChallenge(c, http.StatusUnauthorized, "Bearer", "no access token")
+	} else {
+		writeBearerChallenge(c, http.StatusUnauthorized, `Bearer error="invalid_token"`,
+			"not an access token of the CAPIF core function")
+	}
+	c.Abort()
+}
+
+// bearerToken returns the access token of an Authorization header value
+// (RFC 6750 clause 2.1), or "".
+func bearerToken(header string) string {
+	scheme, value, ok := strings.Cut(strings.TrimSpace(header), " ")
+	if !ok || !strings.EqualFold(scheme, "Bearer") {
+		return ""
+	}
+	return strings.TrimSpace(value)
+}
+
+// capifAuthorize checks an access token of the CAPIF core function
+// (3GPP TS 29.522 clause 7.2; TS 33.122 clause 6.5.2.3 step 7 and Annex C):
+// the ES256 signature with the key of the CAPIF core function and its "kid"
+// (TS 33.210 clause 6.3.3.1), exp, iss and client_id, the scope, and the API
+// invoker at the CAPIF core function. A token not signed by the CAPIF core
+// function is not used here.
+func (p *Processor) capifAuthorize(c *gin.Context, raw string) capifResult {
+	capif := p.Context().Capif
+	if raw == "" {
+		return capifNotUsed
+	}
+	var claims models.CapifAccessTokenClaims
+	parser := jwt.NewParser(jwt.WithValidMethods([]string{capifAlg}), jwt.WithoutClaimsValidation())
+	if _, err := parser.ParseWithClaims(raw, &claims, func(t *jwt.Token) (any, error) {
+		// RFC 7515 clause 4.1.11: no extension is understood.
+		if _, ok := t.Header["crit"]; ok {
+			return nil, errors.New("crit is not supported")
+		}
+		if v, ok := t.Header["kid"]; ok {
+			if kid, _ := v.(string); kid != capif.TokenKid {
+				return nil, errors.New("unknown kid")
+			}
+		}
+		return capif.TokenKey, nil
+	}); err != nil {
+		return capifNotUsed
+	}
+
+	// TS 33.122 Annex C.6: "If the current time is beyond the time specified
+	// by the "exp" parameter, the associated token shall no longer be
+	// considered valid".
+	switch {
+	case claims.Exp == 0:
+		return capifInvalidToken(c, claims.ClientId, "no exp")
+	case capif.Now().After(time.Unix(claims.Exp, 0).Add(capifLeeway)):
+		return capifInvalidToken(c, claims.ClientId, "expired")
+	case claims.ClientId == "" || claims.Iss != claims.ClientId:
+		return capifInvalidToken(c, claims.ClientId, "iss and client_id are not the same API invoker")
+	}
+
+	cfg := p.Config().Capif()
+	if !scopeGrants(claims.Scope, cfg.AefId, factory.ServiceAkma) {
+		logger.CapifLog.Warnf("Access token of API invoker %s refused: scope %q does not grant %s at %s",
+			claims.ClientId, claims.Scope, factory.ServiceAkma, cfg.AefId)
+		writeBearerChallenge(c, http.StatusForbidden, fmt.Sprintf(`Bearer error="insufficient_scope", scope="3gpp#%s:%s"`,
+			cfg.AefId, factory.ServiceAkma), "the scope does not grant this API")
+		return capifRefused
+	}
+
+	inv, err := p.capifInvoker(c.Request.Context(), claims.ClientId)
+	switch {
+	case errors.Is(err, errCapifUnknownInvoker):
+		return capifInvalidToken(c, claims.ClientId, "unknown at the CAPIF core function")
+	case err != nil:
+		logger.CapifLog.Warnf("CAPIF core function not reachable: %v", err)
+		WriteAkmaProblem(c, serviceUnavailable("CAPIF core function not reachable"))
+		return capifRefused
+	}
+	c.Set(capifInvokerKey, inv)
+	return capifAccepted
+}
+
+func capifInvalidToken(c *gin.Context, invoker, reason string) capifResult {
+	logger.CapifLog.Warnf("Access token of API invoker %q refused: %s", invoker, reason)
+	writeBearerChallenge(c, http.StatusUnauthorized, `Bearer error="invalid_token"`, "access token "+reason)
+	return capifRefused
+}
+
+// scopeGrants reports whether a scope of CAPIF,
+// "3gpp#<aefId>:<API name>[,<API name>]...[;<aefId>:...]" (3GPP TS 29.222
+// table 8.5.4.2.6-1), grants api at aefId.
+func scopeGrants(scope, aefId, api string) bool {
+	rest, ok := strings.CutPrefix(scope, "3gpp#")
+	if !ok {
+		return false
+	}
+	for _, item := range strings.Split(rest, ";") {
+		aef, apis, ok := strings.Cut(item, ":")
+		if !ok || aef != aefId {
+			continue
+		}
+		for _, a := range strings.Split(apis, ",") {
+			if a == api {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// capifInvoker returns the data of an API invoker: kept by the NEF, or
+// obtained from the CAPIF core function (Obtain_API_Invoker_Info,
+// 3GPP TS 29.222 clause 5.6.2.4; TS 23.222 clause 8.16.3 step 2a).
+func (p *Processor) capifInvoker(ctx context.Context, id string) (nef_context.CapifInvoker, error) {
+	capif := p.Context().Capif
+	if inv, ok := capif.Invoker(id); ok {
+		return inv, nil
+	}
+	cfg := p.Config().Capif()
+	sec, err := p.Consumer().ObtainApiInvokerInfo(ctx, cfg.CcfUri, id)
+	if err != nil {
+		var apiErr openapi.GenericOpenAPIError
+		if errors.As(err, &apiErr) && apiErr.ErrorStatus == http.StatusNotFound {
+			capif.ForgetInvoker(id)
+			return nef_context.CapifInvoker{}, errCapifUnknownInvoker
+		}
+		return nef_context.CapifInvoker{}, err
+	}
+	inv := nef_context.CapifInvoker{Id: id, AkmaAfIds: make(map[string]struct{})}
+	for _, item := range sec.SecurityInfo {
+		// The item of this AEF, with the access token as security method
+		// (3GPP TS 33.122 clause 6.5.2.3).
+		if item.AefId != cfg.AefId || item.SelSecurityMethod != models.CapifSecurityMethod_OAUTH {
+			continue
+		}
+		inv.AuthenticationInfo = item.AuthenticationInfo
+		if item.AuthorizationInfo == "" {
+			continue
+		}
+		var authz struct {
+			AkmaAfIds []string `json:"akmaAfIds"`
+		}
+		if err := json.Unmarshal([]byte(item.AuthorizationInfo), &authz); err != nil {
+			return nef_context.CapifInvoker{}, fmt.Errorf("authorizationInfo of API invoker %s: %w", id, err)
+		}
+		for _, s := range authz.AkmaAfIds {
+			af, err := afid.Parse(s)
+			if err != nil {
+				logger.CapifLog.Warnf("AF_ID %q of API invoker %s ignored: %v", s, id, err)
+				continue
+			}
+			inv.AkmaAfIds[af.Transport()] = struct{}{}
+		}
+	}
+	capif.SetInvoker(inv)
+	return inv, nil
+}
+
+// capifInvokerOf returns the API invoker of an accepted access token of the
+// CAPIF core function, if the request carried one.
+func capifInvokerOf(c *gin.Context) (nef_context.CapifInvoker, bool) {
+	v, ok := c.Get(capifInvokerKey)
+	if !ok {
+		return nef_context.CapifInvoker{}, false
+	}
+	inv, ok := v.(nef_context.CapifInvoker)
+	return inv, ok
+}
+
+// CheckAuthentication serves the check-authentication custom operation of
+// AEF_Security_API (3GPP TS 29.222 clauses 6.2.2.2 and 9.1): the API invoker
+// asks the API exposing function to obtain its authentication information
+// from the CAPIF core function (TS 33.122 clause 6.5.2.3 step 5). remote is
+// the source address of the request.
+func (p *Processor) CheckAuthentication(c *gin.Context, req *models.CapifCheckAuthenticationReq, remote netip.Addr) {
+	// Table 9.1.4.2.2-1: both attributes are mandatory.
+	switch {
+	case req.ApiInvokerId == "":
+		WriteAkmaProblem(c, capifBadRequest("MANDATORY_IE_MISSING", "/apiInvokerId", "required"))
+		return
+	case req.SupportedFeatures == "":
+		WriteAkmaProblem(c, capifBadRequest("MANDATORY_IE_MISSING", "/supportedFeatures", "required"))
+		return
+	case !supportedFeaturesPattern.MatchString(req.SupportedFeatures):
+		WriteAkmaProblem(c, capifBadRequest("MANDATORY_IE_INCORRECT", "/supportedFeatures",
+			"not a SupportedFeatures string"))
+		return
+	}
+	// Without TLS on CAPIF-2e, the operation is accepted only from the
+	// source addresses of the AFs of the AKMA policy.
+	if !p.Context().AkmaAfs.KnownSource(remote) {
+		logger.CapifLog.Warnf("check-authentication from %s refused: not an address of an authorized AF", remote)
+		WriteAkmaProblem(c, &models.ProblemDetails{
+			Title:  "Forbidden",
+			Status: http.StatusForbidden,
+			Detail: "source address not authorized",
+		})
+		return
+	}
+	inv, err := p.capifInvoker(c.Request.Context(), req.ApiInvokerId)
+	switch {
+	case errors.Is(err, errCapifUnknownInvoker):
+		logger.CapifLog.Warnf("check-authentication of API invoker %s refused: unknown at the CCF", req.ApiInvokerId)
+		WriteAkmaProblem(c, &models.ProblemDetails{
+			Title:  "Forbidden",
+			Status: http.StatusForbidden,
+			Detail: "API invoker unknown at the CAPIF core function",
+		})
+		return
+	case err != nil:
+		logger.CapifLog.Warnf("CAPIF core function not reachable: %v", err)
+		WriteAkmaProblem(c, serviceUnavailable("CAPIF core function not reachable"))
+		return
+	}
+	logger.CapifLog.Infof("check-authentication of API invoker %s: %d AF_IDs from the CCF", inv.Id, len(inv.AkmaAfIds))
+	// The NEF supports none of the features of table 9.1.6-1.
+	c.JSON(http.StatusOK, models.CapifCheckAuthenticationRsp{SupportedFeatures: "0"})
+}
+
+func capifBadRequest(cause, param, reason string) *models.ProblemDetails {
+	return &models.ProblemDetails{
+		Title:         "Bad Request",
+		Status:        http.StatusBadRequest,
+		Cause:         cause,
+		InvalidParams: []models.InvalidParam{{Param: param, Reason: reason}},
+	}
+}
+
+// writeBearerChallenge answers a refused access token with a ProblemDetails
+// and the WWW-Authenticate header (RFC 6750 clause 3; 3GPP TS 29.122
+// table 5.2.6-1).
+func writeBearerChallenge(c *gin.Context, status int, challenge, detail string) {
+	c.Header("WWW-Authenticate", challenge)
+	WriteAkmaProblem(c, &models.ProblemDetails{
+		Title:  http.StatusText(status),
+		Status: int32(status),
+		Detail: detail,
+	})
+}
+
+// akmaServiceAPI is the AKMA API as the NEF publishes it at the CAPIF core
+// function (3GPP TS 29.222 tables 8.2.4.2.2-1 to 8.2.4.2.4-1; TS 29.522
+// clause 5.14.1 and table 5.14.3.1-1).
+func akmaServiceAPI(cfg *factory.Capif) models.CapifServiceApiDescription {
+	methods := []models.CapifSecurityMethod{models.CapifSecurityMethod_OAUTH}
+	return models.CapifServiceApiDescription{
+		ApiName:           factory.ServiceAkma,
+		Description:       "AKMA API of the NEF (3GPP TS 29.522 clause 5.14)",
+		SupportedFeatures: "0",
+		AefProfiles: []models.CapifAefProfile{{
+			AefId: cfg.AefId,
+			Versions: []models.CapifVersion{{
+				ApiVersion: "v1",
+				CustOperations: []models.CapifCustomOperation{{
+					CommType:   models.CapifCommunicationType_REQUEST_RESPONSE,
+					CustOpName: "retrieve",
+					Operations: []models.CapifOperation{models.CapifOperation_POST},
+				}},
+			}},
+			Protocol:        models.CapifProtocol_HTTP_1_1,
+			DataFormat:      models.CapifDataFormat_JSON,
+			SecurityMethods: methods,
+			InterfaceDescriptions: []models.CapifInterfaceDescription{{
+				Ipv4Addr:        cfg.Interface.Ipv4Addr,
+				Port:            int32(cfg.Interface.Port),
+				SecurityMethods: methods,
+			}},
+		}},
+	}
+}
+
+// RunCapifPublication publishes the AKMA API at the CAPIF core function
+// (Publish_Service_API, 3GPP TS 29.222 clause 5.3.2.2), trying again every
+// capifRetryInterval until it succeeds or ctx ends.
+func (p *Processor) RunCapifPublication(ctx context.Context) {
+	cfg := p.Config().Capif()
+	if cfg == nil {
+		return
+	}
+	d := akmaServiceAPI(cfg)
+	for attempt := 1; ; attempt++ {
+		apiId, err := p.Consumer().PublishServiceAPI(ctx, cfg.CcfUri, cfg.ApfId, d)
+		if err == nil {
+			p.Context().Capif.SetApiId(apiId)
+			logger.CapifLog.Infof("%s published at the CCF as %s", factory.ServiceAkma, apiId)
+			return
+		}
+		if attempt == 1 {
+			logger.CapifLog.Warnf("Publication of %s at the CCF failed, trying again every %s: %v",
+				factory.ServiceAkma, capifRetryInterval, err)
+		} else {
+			logger.CapifLog.Debugf("Publication of %s at the CCF failed: %v", factory.ServiceAkma, err)
+		}
+		select {
+		case <-ctx.Done():
+			return
+		case <-time.After(capifRetryInterval):
+		}
+	}
+}
+
+// CapifUnpublish withdraws the AKMA API from the CAPIF core function
+// (Unpublish_Service_API, 3GPP TS 29.222 clause 5.3.2.3).
+func (p *Processor) CapifUnpublish() {
+	capif := p.Context().Capif
+	if capif == nil {
+		return
+	}
+	apiId := capif.TakeApiId()
+	if apiId == "" {
+		return
+	}
+	cfg := p.Config().Capif()
+	ctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)
+	defer cancel()
+	if err := p.Consumer().UnpublishServiceAPI(ctx, cfg.CcfUri, cfg.ApfId, apiId); err != nil {
+		logger.CapifLog.Warnf("Unpublication of %s %s at the CCF failed: %v", factory.ServiceAkma, apiId, err)
+		return
+	}
+	logger.CapifLog.Infof("%s %s unpublished at the CCF", factory.ServiceAkma, apiId)
+}
