+package processor
+
+import (
+	"bytes"
+	"context"
+	"crypto/ecdsa"
+	"crypto/elliptic"
+	"crypto/rand"
+	"crypto/rsa"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"net/netip"
+	"strings"
+	"testing"
+	"time"
+
+	nef_context "github.com/free5gc/nef/internal/context"
+	"github.com/free5gc/nef/internal/logger"
+	"github.com/free5gc/nef/pkg/factory"
+	"github.com/free5gc/openapi/models"
+	"github.com/gin-gonic/gin"
+	"github.com/golang-jwt/jwt/v5"
+	"github.com/stretchr/testify/require"
+	"gopkg.in/h2non/gock.v1"
+)
+
+const (
+	capifCcfUri     = "http://127.0.0.1:8020"
+	capifInvokerId  = "5a9c9a3e-4ee4-4a2f-8a6b-0f2c1d7e9b10"
+	capifOtherAfId  = "af2.akma.example.FF00000001"
+	capifCaCertPEM  = "-----BEGIN CERTIFICATE-----\nMA==\n-----END CERTIFICATE-----\n"
+	capifAkmaScope  = "3gpp#nef-aef:3gpp-akma"
+	capifInsuffHdr  = `Bearer error="insufficient_scope", scope="3gpp#nef-aef:3gpp-akma"`
+	capifInvalidHdr = `Bearer error="invalid_token"`
+)
+
+// setCapif configures the NEF with CAPIF and returns the key of the access
+// tokens of the CAPIF core function. The AKMA policy has akmaAfId and
+// capifOtherAfId at akmaAfAddr.
+func setCapif(t *testing.T, allowNrfTokens bool) *ecdsa.PrivateKey {
+	t.Helper()
+	key, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	require.NoError(t, err)
+	capif, err := nef_context.NewCapifWithKey(&key.PublicKey, time.Minute)
+	require.NoError(t, err)
+	policy, err := nef_context.NewAkmaAfPolicy([]factory.AkmaAuthorizedAf{
+		{AfId: akmaAfId, SourceAddresses: []string{akmaAfAddr}},
+		{AfId: capifOtherAfId, SourceAddresses: []string{akmaAfAddr}},
+	})
+	require.NoError(t, err)
+	nefApp.Config().Configuration.Capif = &factory.Capif{
+		CcfUri:         capifCcfUri,
+		ApfId:          "nef-apf",
+		AefId:          "nef-aef",
+		Interface:      &factory.CapifInterface{Ipv4Addr: "192.0.2.1", Port: 8000},
+		AllowNrfTokens: allowNrfTokens,
+	}
+	nefApp.Context().Capif = capif
+	nefApp.Context().AkmaAfs = policy
+	t.Cleanup(func() {
+		nefApp.Config().Configuration.Capif = nil
+		nefApp.Context().Capif = nil
+	})
+	return key
+}
+
+func capifClaims() models.CapifAccessTokenClaims {
+	return models.CapifAccessTokenClaims{
+		Iss:      capifInvokerId,
+		ClientId: capifInvokerId,
+		Scope:    capifAkmaScope,
+		Exp:      time.Now().Add(10 * time.Minute).Unix(),
+	}
+}
+
+// capifToken signs claims with ES256 and the "kid" of key, as the CAPIF core
+// function does; header changes the JWS header (nil deletes a member).
+func capifToken(t *testing.T, key *ecdsa.PrivateKey, header map[string]any, claims models.CapifAccessTokenClaims) string {
+	t.Helper()
+	tok := jwt.NewWithClaims(jwt.SigningMethodES256, claims)
+	kid, err := nef_context.Thumbprint(&key.PublicKey)
+	require.NoError(t, err)
+	tok.Header["kid"] = kid
+	for name, v := range header {
+		if v == nil {
+			delete(tok.Header, name)
+		} else {
+			tok.Header[name] = v
+		}
+	}
+	s, err := tok.SignedString(key)
+	require.NoError(t, err)
+	return s
+}
+
+// initCCFInvokerInfoStub answers Obtain_API_Invoker_Info for id
+// (3GPP TS 29.222 clause 5.6.2.4).
+func initCCFInvokerInfoStub(id string, status int, afIds ...string) {
+	r := gock.New(capifCcfUri+"/capif-security/v1").
+		Get("/trustedInvokers/"+id).
+		MatchParam("authenticationInfo", "true").
+		MatchParam("authorizationInfo", "true")
+	if status != http.StatusOK {
+		r.Reply(status).SetHeader("Content-Type", "application/problem+json").
+			BodyString(fmt.Sprintf(`{"status":%d}`, status))
+		return
+	}
+	authz, _ := json.Marshal(map[string][]string{"akmaAfIds": afIds})
+	oauth := []models.CapifSecurityMethod{models.CapifSecurityMethod_OAUTH}
+	r.Reply(http.StatusOK).JSON(models.CapifServiceSecurity{
+		SecurityInfo: []models.CapifSecurityInformation{
+			{AefId: "other-aef", PrefSecurityMethods: oauth, SelSecurityMethod: models.CapifSecurityMethod_OAUTH,
+				AuthorizationInfo: `{"akmaAfIds":["af9.akma.example.FF00000001"]}`},
+			{AefId: "nef-aef", PrefSecurityMethods: oauth, SelSecurityMethod: models.CapifSecurityMethod_OAUTH,
+				AuthenticationInfo: capifCaCertPEM, AuthorizationInfo: string(authz)},
+		},
+		NotificationDestination: "https://192.0.2.10/capif/notify",
+		SupportedFeatures:       "0",
+	})
+}
+
+// akmaAuthorize runs the authorization of the AKMA API on a request with
+// the Authorization header auth; nrf tells whether the check of the access
+// tokens of the NRF ran.
+func akmaAuthorize(auth string) (w *httptest.ResponseRecorder, c *gin.Context, nrf bool) {
+	w = httptest.NewRecorder()
+	c, _ = gin.CreateTestContext(w)
+	c.Request = httptest.NewRequest(http.MethodPost, factory.AkmaResUriPrefix+"/retrieve", nil)
+	if auth != "" {
+		c.Request.Header.Set("Authorization", auth)
+	}
+	nefApp.Processor().AkmaAuthorization(c, func(*gin.Context) { nrf = true })
+	c.Writer.WriteHeaderNow()
+	return w, c, nrf
+}
+
+func requireRefused(t *testing.T, name string, w *httptest.ResponseRecorder, c *gin.Context, nrf bool,
+	status int, challenge string,
+) {
+	t.Helper()
+	require.True(t, c.IsAborted(), name)
+	require.False(t, nrf, name)
+	require.Equal(t, status, w.Code, name)
+	require.Equal(t, challenge, w.Header().Get("WWW-Authenticate"), name)
+	require.Empty(t, akmaProblem(t, w).Cause, name)
+}
+
+// TestCapifAccessToken covers the access token of the CAPIF core function on
+// the AKMA API (3GPP TS 29.522 clause 7.2; TS 33.122 clause 6.5.2.3 and
+// Annex C; TS 33.210 clause 6.3.3.1).
+func TestCapifAccessToken(t *testing.T) {
+	key := setCapif(t, true)
+	other, _ := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	rsaKey, _ := rsa.GenerateKey(rand.Reader, 2048)
+
+	// A valid token: the NEF asks the CAPIF core function for the API
+	// invoker once, then keeps its data.
+	initCCFInvokerInfoStub(capifInvokerId, http.StatusOK, akmaAfId)
+	for i := 0; i < 2; i++ {
+		w, c, nrf := akmaAuthorize("Bearer " + capifToken(t, key, nil, capifClaims()))
+		require.False(t, c.IsAborted())
+		require.False(t, nrf)
+		require.Equal(t, http.StatusOK, w.Code)
+		inv, ok := capifInvokerOf(c)
+		require.True(t, ok)
+		require.Contains(t, inv.AkmaAfIds, akmaAfId)
+		require.NotContains(t, inv.AkmaAfIds, "af9.akma.example.FF00000001")
+		require.Equal(t, capifCaCertPEM, inv.AuthenticationInfo)
+	}
+	// Within the leeway of 30 s, and without "kid".
+	claims := capifClaims()
+	claims.Exp = time.Now().Add(-20 * time.Second).Unix()
+	_, c, _ := akmaAuthorize("Bearer " + capifToken(t, key, map[string]any{"kid": nil}, claims))
+	require.False(t, c.IsAborted())
+
+	// Tokens that are not of the CAPIF core function go to the NRF check.
+	hs256, _ := jwt.NewWithClaims(jwt.SigningMethodHS256, capifClaims()).SignedString([]byte("secret"))
+	none, _ := jwt.NewWithClaims(jwt.SigningMethodNone, capifClaims()).SignedString(jwt.UnsafeAllowNoneSignatureType)
+	rs512, _ := jwt.NewWithClaims(jwt.SigningMethodRS512, capifClaims()).SignedString(rsaKey)
+	for name, auth := range map[string]string{
+		"no token":         "",
+		"another key":      "Bearer " + capifToken(t, other, nil, capifClaims()),
+		"kid of the CCF":   "Bearer " + capifToken(t, other, map[string]any{"kid": nefApp.Context().Capif.TokenKid}, capifClaims()),
+		"HS256":            "Bearer " + hs256,
+		"none":             "Bearer " + none,
+		"RS512":            "Bearer " + rs512,
+		"crit":             "Bearer " + capifToken(t, key, map[string]any{"crit": []string{"b64"}, "b64": true}, capifClaims()),
+		"not a JWT":        "Bearer abc",
+		"another scheme":   "Basic " + capifToken(t, key, nil, capifClaims()),
+		"tampered payload": "Bearer " + tamper(capifToken(t, key, nil, capifClaims())),
+	} {
+		_, c, nrf := akmaAuthorize(auth)
+		require.True(t, nrf, name)
+		require.False(t, c.IsAborted(), name)
+	}
+
+	// Tokens of the CAPIF core function that are refused.
+	expired := capifClaims()
+	expired.Exp = time.Now().Add(-31 * time.Second).Unix()
+	noExp := capifClaims()
+	noExp.Exp = 0
+	otherIss := capifClaims()
+	otherIss.Iss = "ccf"
+	noClient := capifClaims()
+	noClient.Iss, noClient.ClientId = "", ""
+	for name, claims := range map[string]models.CapifAccessTokenClaims{
+		"expired": expired, "no exp": noExp, "iss is not client_id": otherIss, "no client_id": noClient,
+	} {
+		w, c, nrf := akmaAuthorize("Bearer " + capifToken(t, key, nil, claims))
+		requireRefused(t, name, w, c, nrf, http.StatusUnauthorized, capifInvalidHdr)
+	}
+	for _, scope := range []string{
+		"3gpp#other-aef:3gpp-akma", "3gpp#nef-aef:3gpp-traffic-influence", "nef-aef:3gpp-akma", "", "3gpp#nef-aef",
+	} {
+		claims := capifClaims()
+		claims.Scope = scope
+		w, c, nrf := akmaAuthorize("Bearer " + capifToken(t, key, nil, claims))
+		requireRefused(t, "scope "+scope, w, c, nrf, http.StatusForbidden, capifInsuffHdr)
+	}
+	claims = capifClaims()
+	claims.Scope = "3gpp#other-aef:x;nef-aef:3gpp-other,3gpp-akma"
+	_, c, _ = akmaAuthorize("Bearer " + capifToken(t, key, nil, claims))
+	require.False(t, c.IsAborted(), "the scope grants 3gpp-akma in its second item")
+
+	// The API invoker offboarded, or the CAPIF core function restarted.
+	const gone = "0b4a3c2d-1e0f-4a5b-8c7d-6e5f4a3b2c1d"
+	initCCFInvokerInfoStub(gone, http.StatusNotFound)
+	claims = capifClaims()
+	claims.Iss, claims.ClientId = gone, gone
+	w, c, nrf := akmaAuthorize("Bearer " + capifToken(t, key, nil, claims))
+	requireRefused(t, "unknown API invoker", w, c, nrf, http.StatusUnauthorized, capifInvalidHdr)
+
+	// The CAPIF core function down.
+	const fresh = "7c6b5a49-3827-4615-a4b3-c2d1e0f9a8b7"
+	gock.New(capifCcfUri + "/capif-security/v1").Get("/trustedInvokers/" + fresh).
+		ReplyError(errors.New("connection refused"))
+	claims.Iss, claims.ClientId = fresh, fresh
+	w, c, nrf = akmaAuthorize("Bearer " + capifToken(t, key, nil, claims))
+	require.True(t, c.IsAborted())
+	require.False(t, nrf)
+	require.Equal(t, http.StatusServiceUnavailable, w.Code)
+	akmaProblem(t, w)
+
+	// The data of the API invoker is asked again after its lifetime.
+	nefApp.Context().Capif.Now = func() time.Time { return time.Now().Add(2 * time.Minute) }
+	initCCFInvokerInfoStub(capifInvokerId, http.StatusNotFound)
+	w, c, nrf = akmaAuthorize("Bearer " + capifToken(t, key, nil, capifClaims()))
+	requireRefused(t, "data of the API invoker asked again", w, c, nrf, http.StatusUnauthorized, capifInvalidHdr)
+}
+
+// tamper changes the last character of the payload of a JWS.
+func tamper(s string) string {
+	parts := strings.Split(s, ".")
+	p := []byte(parts[1])
+	if p[len(p)-1] == 'A' {
+		p[len(p)-1] = 'B'
+	} else {
+		p[len(p)-1] = 'A'
+	}
+	parts[1] = string(p)
+	return strings.Join(parts, ".")
+}
+
+// TestCapifWithoutNrfTokens covers allowNrfTokens: false.
+func TestCapifWithoutNrfTokens(t *testing.T) {
+	key := setCapif(t, false)
