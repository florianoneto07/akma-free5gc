diff --git a/internal/context/capif.go b/internal/context/capif.go
new file mode 100644
index 0000000..71f4a7f
--- /dev/null
+++ b/internal/context/capif.go
@@ -0,0 +1,165 @@
+package context
+
+import (
+	"crypto/ecdsa"
+	"crypto/elliptic"
+	"crypto/sha256"
+	"crypto/x509"
+	"encoding/base64"
+	"encoding/pem"
+	"errors"
+	"fmt"
+	"os"
+	"sync"
+	"time"
+
+	"github.com/free5gc/nef/pkg/factory"
+)
+
+// CapifInvoker is what the NEF keeps of an API invoker: the answer of the
+// CAPIF core function to Obtain_API_Invoker_Info (3GPP TS 29.222
+// clause 5.6.2.4; TS 23.222 clause 8.16.3 step 2a).
+type CapifInvoker struct {
+	Id string
+	// AkmaAfIds are the AF_IDs, in transport form, that the API invoker may
+	// present: its authorization information.
+	AkmaAfIds map[string]struct{}
+	// AuthenticationInfo is the certificate of the CA that issues the client
+	// certificate of the API invoker (3GPP TS 33.122 clause 6.5.2.3 step 5),
+	// for TLS on CAPIF-2e.
+	AuthenticationInfo string
+
+	fetched time.Time
+}
+
+// Capif is the state of the NEF as API publishing function and API exposing
+// function of CAPIF (3GPP TS 29.522 clause 7).
+type Capif struct {
+	// TokenKey checks the access tokens of the CAPIF core function (ES256),
+	// and TokenKid is its JWK thumbprint, the "kid" of the tokens
+	// (3GPP TS 33.210 clause 6.3.3.1; RFC 7638).
+	TokenKey *ecdsa.PublicKey
+	TokenKid string
+
+	invokerInfoLifetime time.Duration
+
+	mu       sync.Mutex
+	invokers map[string]CapifInvoker
+	apiId    string
+
+	// Now returns the current time; tests replace it.
+	Now func() time.Time
+}
+
+// NewCapif loads the public key of the access tokens of the CAPIF core
+// function.
+func NewCapif(cfg *factory.Capif) (*Capif, error) {
+	key, err := loadES256PublicKey(cfg.TokenPublicKey)
+	if err != nil {
+		return nil, fmt.Errorf("capif.tokenPublicKey: %w", err)
+	}
+	lifetime, err := cfg.GetInvokerInfoLifetime()
+	if err != nil {
+		return nil, err
+	}
+	return NewCapifWithKey(key, lifetime)
+}
+
+// NewCapifWithKey builds the state with the public key of the access tokens.
+func NewCapifWithKey(key *ecdsa.PublicKey, invokerInfoLifetime time.Duration) (*Capif, error) {
+	kid, err := Thumbprint(key)
+	if err != nil {
+		return nil, err
+	}
+	return &Capif{
+		TokenKey:            key,
+		TokenKid:            kid,
+		invokerInfoLifetime: invokerInfoLifetime,
+		invokers:            make(map[string]CapifInvoker),
+		Now:                 time.Now,
+	}, nil
+}
+
+// loadES256PublicKey reads a PEM "PUBLIC KEY" with an ECDSA P-256 key.
+func loadES256PublicKey(path string) (*ecdsa.PublicKey, error) {
+	data, err := os.ReadFile(path)
+	if err != nil {
+		return nil, err
+	}
+	block, _ := pem.Decode(data)
+	if block == nil || block.Type != "PUBLIC KEY" {
+		return nil, errors.New("expected a PEM \"PUBLIC KEY\" block")
+	}
+	pub, err := x509.ParsePKIXPublicKey(block.Bytes)
+	if err != nil {
+		return nil, err
+	}
+	key, ok := pub.(*ecdsa.PublicKey)
+	if !ok || key.Curve != elliptic.P256() {
+		return nil, errors.New("an ECDSA P-256 key is required (ES256)")
+	}
+	return key, nil
+}
+
+// Thumbprint returns the JWK thumbprint of a P-256 public key (RFC 7638
+// clause 3): the base64url SHA-256 of its required members (RFC 7518
+// clause 6.2.1) in lexicographic order, without white space.
+func Thumbprint(pub *ecdsa.PublicKey) (string, error) {
+	if pub == nil || pub.Curve != elliptic.P256() {
+		return "", errors.New("an ECDSA P-256 key is required")
+	}
+	point, err := pub.Bytes()
+	if err != nil {
+		return "", err
+	}
+	// point is 0x04 || x || y, each coordinate in 32 octets.
+	enc := base64.RawURLEncoding
+	jwk := fmt.Sprintf(`{"crv":"P-256","kty":"EC","x":"%s","y":"%s"}`,
+		enc.EncodeToString(point[1:33]), enc.EncodeToString(point[33:65]))
+	sum := sha256.Sum256([]byte(jwk))
+	return enc.EncodeToString(sum[:]), nil
+}
+
+// Invoker returns the data of an API invoker, when the NEF has kept it for
+// less than the configured lifetime.
+func (c *Capif) Invoker(id string) (CapifInvoker, bool) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	inv, ok := c.invokers[id]
+	if !ok || c.Now().Sub(inv.fetched) >= c.invokerInfoLifetime {
+		return CapifInvoker{}, false
+	}
+	return inv, true
+}
+
+// SetInvoker keeps the data of an API invoker, obtained now.
+func (c *Capif) SetInvoker(inv CapifInvoker) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	inv.fetched = c.Now()
+	c.invokers[inv.Id] = inv
+}
+
+// ForgetInvoker drops the data of an API invoker.
+func (c *Capif) ForgetInvoker(id string) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	delete(c.invokers, id)
+}
+
+// SetApiId keeps the API identifier that the CAPIF core function assigned
+// to the AKMA API at its publication.
+func (c *Capif) SetApiId(apiId string) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.apiId = apiId
+}
+
+// TakeApiId returns the API identifier of the publication and forgets it.
+func (c *Capif) TakeApiId() string {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	apiId := c.apiId
+	c.apiId = ""
+	return apiId
+}
diff --git a/internal/context/capif_test.go b/internal/context/capif_test.go
new file mode 100644
index 0000000..5956c85
--- /dev/null
+++ b/internal/context/capif_test.go
@@ -0,0 +1,84 @@
+package context
+
+import (
+	"crypto/ecdsa"
+	"crypto/elliptic"
+	"crypto/rand"
+	"crypto/rsa"
+	"crypto/x509"
+	"encoding/base64"
+	"encoding/pem"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"github.com/free5gc/nef/pkg/factory"
+	"github.com/stretchr/testify/require"
+)
+
+// TestThumbprint checks the JWK thumbprint (RFC 7638) of the P-256 key of
+// RFC 7517 Appendix A.1 against a value computed apart.
+func TestThumbprint(t *testing.T) {
+	x, _ := base64.RawURLEncoding.DecodeString("MKBCTNIcKUSDii11ySs3526iDZ8AiTo7Tu6KPAqv7D4")
+	y, _ := base64.RawURLEncoding.DecodeString("4Etl6SRW2YiLUrN5vfvVHuhp7x8PxltmWWlbbM4IFyM")
+	pub, err := ecdsa.ParseUncompressedPublicKey(elliptic.P256(), append(append([]byte{4}, x...), y...))
+	require.NoError(t, err)
+	kid, err := Thumbprint(pub)
+	require.NoError(t, err)
+	require.Equal(t, "cn-I_WNMClehiVp51i_0VpOENW1upEerA8sEam5hn-s", kid)
+}
+
+func writePublicKey(t *testing.T, pub any) string {
+	t.Helper()
+	der, err := x509.MarshalPKIXPublicKey(pub)
+	require.NoError(t, err)
+	path := filepath.Join(t.TempDir(), "ccf-token.pub.pem")
+	require.NoError(t, os.WriteFile(path, pem.EncodeToMemory(&pem.Block{Type: "PUBLIC KEY", Bytes: der}), 0o600))
+	return path
+}
+
+func TestNewCapif(t *testing.T) {
+	p256, _ := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	p384, _ := ecdsa.GenerateKey(elliptic.P384(), rand.Reader)
+	rsaKey, _ := rsa.GenerateKey(rand.Reader, 2048)
+
+	capif, err := NewCapif(&factory.Capif{TokenPublicKey: writePublicKey(t, &p256.PublicKey)})
+	require.NoError(t, err)
+	require.True(t, capif.TokenKey.Equal(&p256.PublicKey))
+	kid, _ := Thumbprint(&p256.PublicKey)
+	require.Equal(t, kid, capif.TokenKid)
+
+	for name, pub := range map[string]any{"P-384": &p384.PublicKey, "RSA": &rsaKey.PublicKey} {
+		_, err := NewCapif(&factory.Capif{TokenPublicKey: writePublicKey(t, pub)})
+		require.Error(t, err, name)
+	}
+	_, err = NewCapif(&factory.Capif{TokenPublicKey: filepath.Join(t.TempDir(), "none.pem")})
+	require.Error(t, err)
+}
+
+// TestCapifInvokers covers the lifetime of the data of an API invoker.
+func TestCapifInvokers(t *testing.T) {
+	key, _ := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	capif, err := NewCapifWithKey(&key.PublicKey, time.Minute)
+	require.NoError(t, err)
+	now := time.Now()
+	capif.Now = func() time.Time { return now }
+
+	capif.SetInvoker(CapifInvoker{Id: "a", AkmaAfIds: map[string]struct{}{"af1.akma.example.FF00000001": {}}})
+	inv, ok := capif.Invoker("a")
+	require.True(t, ok)
+	require.Contains(t, inv.AkmaAfIds, "af1.akma.example.FF00000001")
+	now = now.Add(time.Minute)
+	_, ok = capif.Invoker("a")
+	require.False(t, ok, "kept beyond its lifetime")
+
+	capif.SetInvoker(CapifInvoker{Id: "b"})
+	capif.ForgetInvoker("b")
+	_, ok = capif.Invoker("b")
+	require.False(t, ok)
+
+	capif.SetApiId("api-1")
+	require.Equal(t, "api-1", capif.TakeApiId())
+	require.Empty(t, capif.TakeApiId())
+}
