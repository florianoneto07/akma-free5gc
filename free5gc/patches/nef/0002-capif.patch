+// TestCapifRoutes checks that the AKMA API goes through the check of the
+// access tokens of the CAPIF core function, and that AEF_Security_API is
+// served only with CAPIF (3GPP TS 29.522 clauses 7.1 and 7.2).
+func TestCapifRoutes(t *testing.T) {
+	key, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	require.NoError(t, err)
+	der, err := x509.MarshalPKIXPublicKey(&key.PublicKey)
+	require.NoError(t, err)
+	keyFile := filepath.Join(t.TempDir(), "ccf-token.pub.pem")
+	require.NoError(t, os.WriteFile(keyFile, pem.EncodeToMemory(&pem.Block{Type: "PUBLIC KEY", Bytes: der}), 0o600))
+
+	s := newCapifServer(t, &factory.Capif{
+		CcfUri:         "http://127.0.0.1:8020",
+		ApfId:          "nef-apf",
+		AefId:          "nef-aef",
+		TokenPublicKey: keyFile,
+		Interface:      &factory.CapifInterface{Ipv4Addr: "192.0.2.1", Port: 8000},
+		AllowNrfTokens: false,
+	})
+	w := post(s, factory.AkmaResUriPrefix+"/retrieve", "", `{}`)
+	require.Equal(t, http.StatusUnauthorized, w.Code)
+	require.Equal(t, "Bearer", w.Header().Get("WWW-Authenticate"))
+	// 192.0.2.99 is not an address of the AKMA policy.
+	w = post(s, factory.AefSecurityResUriPrefix+"/check-authentication", "",
+		`{"apiInvokerId":"x","supportedFeatures":"0"}`)
+	require.Equal(t, http.StatusForbidden, w.Code)
+	w = post(s, factory.AefSecurityResUriPrefix+"/check-authentication", "", `{`)
+	require.Equal(t, http.StatusBadRequest, w.Code)
+
+	// Without CAPIF.
+	s = newCapifServer(t, nil)
+	w = post(s, factory.AefSecurityResUriPrefix+"/check-authentication", "",
+		`{"apiInvokerId":"x","supportedFeatures":"0"}`)
+	require.Equal(t, http.StatusNotFound, w.Code)
+	w = post(s, factory.AkmaResUriPrefix+"/retrieve", "", `{}`)
+	require.NotEqual(t, http.StatusUnauthorized, w.Code, "OAuth2 of the NRF is off: the request goes on")
+}
