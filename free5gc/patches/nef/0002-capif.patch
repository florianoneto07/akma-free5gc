diff --git a/internal/sbi/api_capif.go b/internal/sbi/api_capif.go
new file mode 100644
index 0000000..91e93ee
--- /dev/null
+++ b/internal/sbi/api_capif.go
@@ -0,0 +1,59 @@
+package sbi
+
+import (
+	"mime"
+	"net/http"
+	"net/netip"
+
+	"github.com/free5gc/nef/internal/logger"
+	"github.com/free5gc/nef/internal/sbi/processor"
+	"github.com/free5gc/openapi"
+	"github.com/free5gc/openapi/models"
+	"github.com/gin-gonic/gin"
+)
+
+// getAefSecurityRoutes returns the custom operation of AEF_Security_API that
+// the NEF serves as API exposing function (3GPP TS 29.222 clause 9.1).
+func (s *Server) getAefSecurityRoutes() []Route {
+	return []Route{
+		{
+			Method:  http.MethodPost,
+			Pattern: "/check-authentication",
+			APIFunc: s.apiPostCheckAuthentication,
+		},
+	}
+}
+
+func (s *Server) apiPostCheckAuthentication(gc *gin.Context) {
+	// 3GPP TS 29.122 table 5.2.6-1: 415 for a body format the server does
+	// not support.
+	mediaType, _, err := mime.ParseMediaType(gc.GetHeader("Content-Type"))
+	if err != nil || mediaType != "application/json" {
+		processor.WriteAkmaProblem(gc, &models.ProblemDetails{
+			Title:  "Unsupported Media Type",
+			Status: http.StatusUnsupportedMediaType,
+			Detail: "the request body must be application/json",
+		})
+		return
+	}
+	reqBody, err := gc.GetRawData()
+	if err != nil {
+		logger.SBILog.Errorf("Get Request Body error: %+v", err)
+		processor.WriteAkmaProblem(gc, openapi.ProblemDetailsSystemFailure(err.Error()))
+		return
+	}
+	var req models.CapifCheckAuthenticationReq
+	if err = openapi.Deserialize(&req, reqBody, "application/json"); err != nil {
+		logger.SBILog.Errorf("Deserialize Request Body error: %+v", err)
+		processor.WriteAkmaProblem(gc, openapi.ProblemDetailsMalformedReqSyntax(err.Error()))
+		return
+	}
+	// The source address is taken from the connection, never from
+	// forwarding headers.
+	ap, err := netip.ParseAddrPort(gc.Request.RemoteAddr)
+	if err != nil {
+		processor.WriteAkmaProblem(gc, openapi.ProblemDetailsSystemFailure("source address of the request"))
+		return
+	}
+	s.Processor().CheckAuthentication(gc, &req, ap.Addr().Unmap())
+}
diff --git a/internal/sbi/consumer/ccf_service.go b/internal/sbi/consumer/ccf_service.go
new file mode 100644
index 0000000..ad458e3
--- /dev/null
+++ b/internal/sbi/consumer/ccf_service.go
@@ -0,0 +1,105 @@
+package consumer
+
+import (
+	"context"
+	"errors"
+	"net/http"
+	"sync"
+
+	"github.com/free5gc/openapi/capif/PublishService"
+	"github.com/free5gc/openapi/capif/Security"
+	"github.com/free5gc/openapi/models"
+	sbi_metrics "github.com/free5gc/util/metrics/sbi"
+)
+
+// ccfService is the client of the CAPIF core function on CAPIF-3 and
+// CAPIF-4 (3GPP TS 23.222 clauses 6.4.6 and 6.4.7).
+type ccfService struct {
+	consumer *Consumer
+
+	mu              sync.RWMutex
+	publishClients  map[string]*PublishService.APIClient
+	securityClients map[string]*Security.APIClient
+}
+
+func (s *ccfService) publishClient(uri string) *PublishService.APIClient {
+	s.mu.RLock()
+	client, ok := s.publishClients[uri]
+	s.mu.RUnlock()
+	if ok {
+		return client
+	}
+	cfg := PublishService.NewConfiguration()
+	cfg.SetBasePath(uri)
+	cfg.SetMetrics(sbi_metrics.SbiMetricHook)
+	cfg.SetHTTPClient(http.DefaultClient)
+	client = PublishService.NewAPIClient(cfg)
+
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.publishClients[uri] = client
+	return client
+}
+
+func (s *ccfService) securityClient(uri string) *Security.APIClient {
+	s.mu.RLock()
+	client, ok := s.securityClients[uri]
+	s.mu.RUnlock()
+	if ok {
+		return client
+	}
+	cfg := Security.NewConfiguration()
+	cfg.SetBasePath(uri)
+	cfg.SetMetrics(sbi_metrics.SbiMetricHook)
+	cfg.SetHTTPClient(http.DefaultClient)
+	client = Security.NewAPIClient(cfg)
+
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.securityClients[uri] = client
+	return client
+}
+
+// PublishServiceAPI publishes d for the API publishing function apfId at
+// the CAPIF core function at uri (Publish_Service_API, 3GPP TS 29.222
+// clause 5.3.2.2) and returns the API identifier it assigned.
+func (s *ccfService) PublishServiceAPI(ctx context.Context, uri, apfId string,
+	d models.CapifServiceApiDescription,
+) (string, error) {
+	rsp, err := s.publishClient(uri).APFPublishedAPIsCollectionApi.CreateAPFPubAPIs(ctx,
+		&PublishService.CreateAPFPubAPIsRequest{ApfId: &apfId, ServiceAPIDescription: &d})
+	if err != nil {
+		return "", err
+	}
+	if rsp.ServiceAPIDescription.ApiId == "" {
+		return "", errors.New("no apiId in the answer of the CAPIF core function")
+	}
+	return rsp.ServiceAPIDescription.ApiId, nil
+}
+
+// UnpublishServiceAPI withdraws the service API apiId of apfId
+// (Unpublish_Service_API, 3GPP TS 29.222 clause 5.3.2.3).
+func (s *ccfService) UnpublishServiceAPI(ctx context.Context, uri, apfId, apiId string) error {
+	_, err := s.publishClient(uri).IndividualAPFPublishedAPIDocumentApi.DeleteIndAPFPubAPI(ctx,
+		&PublishService.IndAPFPubAPIRequest{ApfId: &apfId, ServiceApiId: &apiId})
+	return err
+}
+
+// ObtainApiInvokerInfo asks the CAPIF core function for the security
+// information of an API invoker, with its authentication and authorization
+// information (Obtain_API_Invoker_Info, 3GPP TS 29.222 clause 5.6.2.4).
+func (s *ccfService) ObtainApiInvokerInfo(ctx context.Context, uri, apiInvokerId string) (
+	models.CapifServiceSecurity, error,
+) {
+	yes := true
+	rsp, err := s.securityClient(uri).IndividualTrustedAPIInvokerStoreApi.GetSecIndTrustedAPIInv(ctx,
+		&Security.GetSecIndTrustedAPIInvRequest{
+			ApiInvokerId:       &apiInvokerId,
+			AuthenticationInfo: &yes,
+			AuthorizationInfo:  &yes,
+		})
+	if err != nil {
+		return models.CapifServiceSecurity{}, err
+	}
+	return rsp.ServiceSecurity, nil
+}
