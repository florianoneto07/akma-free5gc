+package factory
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func capifConfig(services ...string) *Config {
+	cfg := &Config{
+		Info: &Info{Version: "1.0.1"},
+		Configuration: &Configuration{
+			Sbi:    &Sbi{Scheme: "http", RegisterIPv4: "127.0.0.5", BindingIPv4: "127.0.0.5", Port: 8000},
+			NrfUri: "http://127.0.0.10:8000",
+			Capif: &Capif{
+				CcfUri:         "http://127.0.0.1:8020",
+				ApfId:          "nef-apf",
+				AefId:          "nef-aef",
+				TokenPublicKey: "cert/ccf-token.pub.pem",
+				Interface:      &CapifInterface{Ipv4Addr: "192.168.16.130", Port: 8000},
+			},
+		},
+		Logger: &Logger{Level: "info"},
+	}
+	for _, s := range services {
+		cfg.Configuration.ServiceList = append(cfg.Configuration.ServiceList, Service{ServiceName: s})
+	}
+	return cfg
+}
+
+// TestCapifConfig covers the validation of the capif section.
+func TestCapifConfig(t *testing.T) {
+	ok, err := capifConfig(ServiceAkma).Validate()
+	require.NoError(t, err)
+	require.True(t, ok)
+	d, err := capifConfig(ServiceAkma).Configuration.Capif.GetInvokerInfoLifetime()
+	require.NoError(t, err)
+	require.Equal(t, NefCapifDefaultInvokerInfoLifetime, d)
+
+	for name, change := range map[string]func(*Capif){
+		"ccfUri without host":      func(c *Capif) { c.CcfUri = "http://" },
+		"ccfUri with a path":       func(c *Capif) { c.CcfUri = "http://127.0.0.1:8020/x" },
+		"ccfUri of another scheme": func(c *Capif) { c.CcfUri = "ftp://127.0.0.1:8020" },
+		"apfId with ':'":           func(c *Capif) { c.ApfId = "nef:apf" },
+		"aefId with a space":       func(c *Capif) { c.AefId = "nef aef" },
+		"no aefId":                 func(c *Capif) { c.AefId = "" },
+		"interface 0.0.0.0":        func(c *Capif) { c.Interface.Ipv4Addr = "0.0.0.0" },
+		"interface without port":   func(c *Capif) { c.Interface.Port = 0 },
+		"no interface":             func(c *Capif) { c.Interface = nil },
+		"no tokenPublicKey":        func(c *Capif) { c.TokenPublicKey = "" },
+		"lifetime 500ms":           func(c *Capif) { c.InvokerInfoLifetime = "500ms" },
+	} {
+		cfg := capifConfig(ServiceAkma)
+		change(cfg.Configuration.Capif)
+		_, err := cfg.Validate()
+		require.Error(t, err, name)
+	}
+
+	// The NEF publishes the AKMA API: it has to be served.
+	_, err = capifConfig(ServiceNefOam).Validate()
+	require.Error(t, err)
+}
