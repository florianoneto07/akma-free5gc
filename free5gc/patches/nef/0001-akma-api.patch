diff --git a/internal/context/akma.go b/internal/context/akma.go
new file mode 100644
index 0000000..7d52f6f
--- /dev/null
+++ b/internal/context/akma.go
@@ -0,0 +1,63 @@
+package context
+
+import (
+	"fmt"
+	"net/netip"
+	"sort"
+	"strings"
+
+	"github.com/florianoneto07/akma-free5gc/shared/akma/afid"
+	"github.com/free5gc/nef/pkg/factory"
+)
+
+// AkmaAfPolicy is the local policy with which the NEF authorizes an AF to
+// request K_AF, including the verification of the AF_ID (3GPP TS 33.535
+// clause 6.3 step 2). Each AF_ID is bound to the source addresses of the AF,
+// so that an AF cannot request the K_AF of another AF_ID.
+type AkmaAfPolicy struct {
+	sources map[string]map[netip.Addr]struct{}
+}
+
+// NewAkmaAfPolicy builds the policy from the configuration.
+func NewAkmaAfPolicy(afs []factory.AkmaAuthorizedAf) (*AkmaAfPolicy, error) {
+	p := &AkmaAfPolicy{sources: make(map[string]map[netip.Addr]struct{})}
+	for i, af := range afs {
+		id, err := afid.Parse(af.AfId)
+		if err != nil {
+			return nil, fmt.Errorf("akma.authorizedAfs[%d]: %w", i, err)
+		}
+		set := p.sources[id.Transport()]
+		if set == nil {
+			set = make(map[netip.Addr]struct{})
+			p.sources[id.Transport()] = set
+		}
+		for j, s := range af.SourceAddresses {
+			addr, err := netip.ParseAddr(strings.TrimSpace(s))
+			if err != nil {
+				return nil, fmt.Errorf("akma.authorizedAfs[%d].sourceAddresses[%d]: %w", i, j, err)
+			}
+			set[addr.Unmap()] = struct{}{}
+		}
+	}
+	return p, nil
+}
+
+// AfIds returns the authorized AF_IDs, in transport form, sorted.
+func (p *AkmaAfPolicy) AfIds() []string {
+	ids := make([]string, 0, len(p.sources))
+	for id := range p.sources {
+		ids = append(ids, id)
+	}
+	sort.Strings(ids)
+	return ids
+}
+
+// Authorize reports whether the AF at remote may obtain K_AF for id.
+func (p *AkmaAfPolicy) Authorize(id afid.AfID, remote netip.Addr) bool {
+	set, ok := p.sources[id.Transport()]
+	if !ok {
+		return false
+	}
+	_, ok = set[remote.Unmap()]
+	return ok
+}
