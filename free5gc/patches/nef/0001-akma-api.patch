diff --git a/internal/sbi/processor/akma.go b/internal/sbi/processor/akma.go
new file mode 100644
index 0000000..0f5e6dd
--- /dev/null
+++ b/internal/sbi/processor/akma.go
@@ -0,0 +1,184 @@
+package processor
+
+import (
+	"errors"
+	"net/http"
+	"net/netip"
+	"time"
+
+	"github.com/florianoneto07/akma-free5gc/shared/akma/afid"
+	"github.com/florianoneto07/akma-free5gc/shared/akma/akid"
+	"github.com/free5gc/nef/internal/logger"
+	"github.com/free5gc/openapi"
+	Naanf_AKMA "github.com/free5gc/openapi/aanf/AKMA"
+	"github.com/free5gc/openapi/models"
+	"github.com/free5gc/util/metrics/sbi"
+	"github.com/gin-gonic/gin"
+)
+
+// causeKAkmaNotPresent is the application error of 3GPP TS 29.522
+// table 5.14.7.3-1, relayed from the AAnF.
+const causeKAkmaNotPresent = "K_AKMA_NOT_PRESENT"
+
+// RetrieveAkmaApplicationKey serves the Retrieve custom operation of the
+// AKMA API: the K_AF request of an AF outside the operator network
+// (3GPP TS 29.522 clause 4.4.23.2; TS 33.535 clause 6.3). remote is the
+// source address of the AF.
+func (p *Processor) RetrieveAkmaApplicationKey(c *gin.Context, req *models.AkmaAfKeyRequest, remote netip.Addr) {
+	if pd := validateAkmaAfKeyRequest(req); pd != nil {
+		WriteAkmaProblem(c, pd)
+		return
+	}
+	af, err := afid.Parse(req.AfId)
+	if err != nil {
+		WriteAkmaProblem(c, invalidParam("/afId", "expected \"<FQDN>.<Ua* security protocol id>\""))
+		return
+	}
+	id, err := akid.Parse(req.AKId, akid.DefaultOptions())
+	if err != nil {
+		WriteAkmaProblem(c, invalidParam("/aKId", "not an A-KID \"rid<RID>.<label><A-TID>@<realm>\""))
+		return
+	}
+
+	anonymous := ""
+	if req.AnonInd {
+		anonymous = ", anonymous"
+	}
+	logger.AkmaLog.Infof("K_AF request from AF_ID %s for A-KID %s%s", af.Transport(), req.AKId, anonymous)
+
+	// TS 33.535 clause 6.3 step 2: the NEF authorizes the AF, including the
+	// verification of the AF_ID. No cause is defined for the refusal
+	// (TS 29.522 table 5.14.7.3-1): 403 without cause.
+	if !p.Context().AkmaAfs.Authorize(af, remote) {
+		logger.AkmaLog.Warnf("AF at %s not authorized for AF_ID %s", remote, af.Transport())
+		WriteAkmaProblem(c, &models.ProblemDetails{
+			Title:  "Forbidden",
+			Status: http.StatusForbidden,
+			Detail: "AF not authorized by local policy",
+		})
+		return
+	}
+
+	// TS 33.535 clause 6.3 step 2 and clause 6.7: AAnF selection with the
+	// Routing Indicator of the A-KID.
+	uri, err := p.Consumer().AanfUri(string(id.RID))
+	if err != nil {
+		logger.AkmaLog.Warnf("No AAnF for Routing Indicator %s: %v", id.RID, err)
+		WriteAkmaProblem(c, serviceUnavailable("no AAnF available"))
+		return
+	}
+
+	// TS 33.535 clause 6.3 step 3.
+	rsp, err := p.Consumer().GetAKMAAPPKeyMaterial(c.Request.Context(), uri, models.AkmaAfKeyRequest{
+		AfId:    af.Transport(),
+		AKId:    req.AKId,
+		AnonInd: req.AnonInd,
+	})
+	if err != nil {
+		p.relayAanfError(c, af, req.AKId, err)
+		return
+	}
+	// TS 29.522 table 5.14.3.2.2-2: "204 No Content" if the requested data
+	// does not exist; the NEF learns it from a 204 of the AAnF.
+	if rsp.NoContent {
+		logger.AkmaLog.Infof("AAnF answered 204 for A-KID %s, relayed to AF_ID %s", req.AKId, af.Transport())
+		c.Status(http.StatusNoContent)
+		return
+	}
+
+	// TS 33.535 clause 6.3 step 5: "The NEF shall not send the SUPI to the
+	// AF". The GPSI is optional and not provided.
+	data := rsp.AkmaAfKeyData
+	out := models.AkmaAfKeyData{Kaf: data.Kaf, Expiry: data.Expiry}
+	expiry := ""
+	if data.Expiry != nil {
+		expiry = data.Expiry.UTC().Format(time.RFC3339)
+	}
+	logger.AkmaLog.Infof("K_AF for A-KID %s relayed to AF_ID %s, expires %s", req.AKId, af.Transport(), expiry)
+	c.JSON(http.StatusOK, out)
+}
+
+// relayAanfError answers the AF after an error of the AAnF
+// (3GPP TS 29.522 clause 4.4.23.2): K_AKMA_NOT_PRESENT is relayed; for the
+// other errors the clause asks only for "a proper error status code".
+func (p *Processor) relayAanfError(c *gin.Context, af afid.AfID, aKId string, err error) {
+	var apiErr openapi.GenericOpenAPIError
+	if !errors.As(err, &apiErr) {
+		logger.AkmaLog.Warnf("AAnF not reachable for AF_ID %s: %v", af.Transport(), err)
+		WriteAkmaProblem(c, serviceUnavailable("AAnF not reachable"))
+		return
+	}
+	var cause string
+	if opErr, ok := apiErr.Model().(Naanf_AKMA.OperationError); ok {
+		cause = opErr.ProblemDetails.Cause
+	}
+	logger.AkmaLog.Warnf("AAnF answered %d %s for A-KID %s and AF_ID %s", apiErr.ErrorStatus, cause, aKId,
+		af.Transport())
+	switch status := apiErr.ErrorStatus; {
+	case status == http.StatusForbidden && cause == causeKAkmaNotPresent:
+		// "shall relay this response to the AF".
+		WriteAkmaProblem(c, &models.ProblemDetails{
+			Title:  "Forbidden",
+			Status: http.StatusForbidden,
+			Cause:  causeKAkmaNotPresent,
+			Detail: "K_AKMA not present at the AAnF",
+		})
+	case status == http.StatusForbidden:
+		WriteAkmaProblem(c, &models.ProblemDetails{
+			Title:  "Forbidden",
+			Status: http.StatusForbidden,
+			Detail: "K_AF not provided by the AAnF",
+		})
+	case status >= 400 && status < 500:
+		WriteAkmaProblem(c, openapi.ProblemDetailsSystemFailure("request to the AAnF refused"))
+	default:
+		WriteAkmaProblem(c, serviceUnavailable("AAnF not available"))
+	}
+}
+
+// validateAkmaAfKeyRequest checks the mandatory attributes of
+// TS 29.522 table 5.14.5.3.2-1. "notifUri" belongs to the RoamingRestriction
+// feature, which is not supported, and is ignored.
+func validateAkmaAfKeyRequest(req *models.AkmaAfKeyRequest) *models.ProblemDetails {
+	var params []models.InvalidParam
+	if req.AfId == "" {
+		params = append(params, models.InvalidParam{Param: "/afId", Reason: "required"})
+	}
+	if req.AKId == "" {
+		params = append(params, models.InvalidParam{Param: "/aKId", Reason: "required"})
+	}
+	if len(params) == 0 {
+		return nil
+	}
+	return &models.ProblemDetails{
+		Title:         "Bad Request",
+		Status:        http.StatusBadRequest,
+		Detail:        "mandatory attribute missing",
+		InvalidParams: params,
+	}
+}
+
+func invalidParam(param, reason string) *models.ProblemDetails {
+	return &models.ProblemDetails{
+		Title:         "Bad Request",
+		Status:        http.StatusBadRequest,
+		Detail:        "attribute incorrect",
+		InvalidParams: []models.InvalidParam{{Param: param, Reason: reason}},
+	}
+}
+
+func serviceUnavailable(detail string) *models.ProblemDetails {
+	return &models.ProblemDetails{
+		Title:  "Service Unavailable",
+		Status: http.StatusServiceUnavailable,
+		Detail: detail,
+	}
+}
+
+// WriteAkmaProblem answers with a ProblemDetails in "application/problem+json"
+// (3GPP TS 29.122 table 5.2.6-1, NOTE 2).
+func WriteAkmaProblem(c *gin.Context, pd *models.ProblemDetails) {
+	c.Set(sbi.IN_PB_DETAILS_CTX_STR, pd.Cause)
+	c.Header("Content-Type", "application/problem+json")
+	c.JSON(int(pd.Status), pd)
+}
diff --git a/internal/sbi/processor/akma_test.go b/internal/sbi/processor/akma_test.go
new file mode 100644
index 0000000..11ef638
--- /dev/null
+++ b/internal/sbi/processor/akma_test.go
@@ -0,0 +1,233 @@
+package processor
+
+import (
+	"bytes"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"net/netip"
+	"strings"
+	"testing"
+
+	nef_context "github.com/free5gc/nef/internal/context"
+	"github.com/free5gc/nef/internal/logger"
+	"github.com/free5gc/nef/pkg/factory"
+	"github.com/free5gc/openapi/models"
+	"github.com/gin-gonic/gin"
+	"github.com/stretchr/testify/require"
+	"gopkg.in/h2non/gock.v1"
+)
+
+const (
+	akmaAfId   = "af1.akma.example.FF00000001"
+	akmaAfAddr = "192.0.2.10"
+	// A-KID and K_AF of the vector "testbed-ue" (RID 0000).
+	akmaAKId    = "rid0000.atidiz1FN8DkMGyxwtfTVYsKUsWnzOJdBOLlQEiQlK2gHNA=@5gc.mnc093.mcc208.3gppnetwork.org"
+	akmaKaf     = "00c16845c2e4e1256755b84bb06d94e2e659d8ba53c59e874fc149bffd5ea04b"
+	akmaSupi    = "imsi-208930000000001"
+	akmaAanfUri = "http://127.0.0.30:8010"
+)
+
+func setAkmaPolicy(t *testing.T) {
+	t.Helper()
+	policy, err := nef_context.NewAkmaAfPolicy([]factory.AkmaAuthorizedAf{
+		{AfId: akmaAfId, SourceAddresses: []string{akmaAfAddr}},
+	})
+	require.NoError(t, err)
+	nefApp.Context().AkmaAfs = policy
+}
+
+// initNRFDiscAANFStub answers the AAnF discovery for the Routing Indicator
+// 0000 (3GPP TS 29.510 table 6.2.3.2.3.1-1).
+func initNRFDiscAANFStub(found bool) {
+	result := models.SearchResult{ValidityPeriod: 100}
+	if found {
+		result.NfInstances = []models.NrfNfDiscoveryNfProfile{{
+			NfInstanceId: "aanf-unit-testing",
+			NfType:       "AANF",
+			NfStatus:     "REGISTERED",
+			NfServices: []models.NrfNfDiscoveryNfService{{
+				ServiceInstanceId: "naanf-akma",
+				ServiceName:       "naanf-akma",
+				Versions:          []models.NfServiceVersion{{ApiVersionInUri: "v1", ApiFullVersion: "1.2.0"}},
+				Scheme:            "http",
+				NfServiceStatus:   "REGISTERED",
+				IpEndPoints: []models.IpEndPoint{{
+					Ipv4Address: "127.0.0.30",
+					Transport:   "TCP",
+					Port:        8010,
+				}},
+			}},
+		}}
+	}
+	gock.New("http://127.0.0.10:8000/nnrf-disc/v1").
+		Get("/nf-instances").
+		MatchParam("target-nf-type", "AANF").
+		MatchParam("requester-nf-type", "NEF").
+		MatchParam("routing-indicator", "0000").
+		Reply(http.StatusOK).
+		JSON(result)
+}
+
+// initAANFRetrieveStub answers Naanf_AKMA_ApplicationKey_Get for the request
+// the NEF must send.
+func initAANFRetrieveStub(anon bool, status int, body string) {
+	req := map[string]any{"afId": akmaAfId, "aKId": akmaAKId}
+	if anon {
+		req["anonInd"] = true
+	}
+	rsp := gock.New(akmaAanfUri + "/naanf-akma/v1").
+		Post("/retrieve-applicationkey").
+		MatchType("json").
+		JSON(req).
+		Reply(status)
+	switch {
+	case status == http.StatusOK:
+		rsp.SetHeader("Content-Type", "application/json").BodyString(body)
+	case body != "":
+		rsp.SetHeader("Content-Type", "application/problem+json").BodyString(body)
+	}
+}
+
+func akmaRetrieve(req models.AkmaAfKeyRequest, remote string) *httptest.ResponseRecorder {
+	w := httptest.NewRecorder()
+	c, _ := gin.CreateTestContext(w)
+	c.Request = httptest.NewRequest(http.MethodPost, factory.AkmaResUriPrefix+"/retrieve", nil)
+	nefApp.Processor().RetrieveAkmaApplicationKey(c, &req, netip.MustParseAddr(remote))
+	c.Writer.WriteHeaderNow()
+	return w
+}
+
+func akmaProblem(t *testing.T, w *httptest.ResponseRecorder) models.ProblemDetails {
+	t.Helper()
+	require.Equal(t, "application/problem+json", w.Header().Get("Content-Type"))
+	var pd models.ProblemDetails
+	require.NoError(t, json.Unmarshal(w.Body.Bytes(), &pd))
+	require.Equal(t, int32(w.Code), pd.Status)
+	return pd
+}
+
+func TestRetrieveAkmaApplicationKey(t *testing.T) {
+	setAkmaPolicy(t)
+	const aanfOK = `{"kaf":"` + akmaKaf + `","expiry":"2026-10-19T20:00:00Z","supi":"` + akmaSupi + `"}`
+
+	t.Run("K_AF relayed without the SUPI", func(t *testing.T) {
+		initNRFDiscAANFStub(true)
+		initAANFRetrieveStub(false, http.StatusOK, aanfOK)
+
+		w := akmaRetrieve(models.AkmaAfKeyRequest{AfId: akmaAfId, AKId: akmaAKId}, akmaAfAddr)
+		require.Equal(t, http.StatusOK, w.Code)
+		var rsp map[string]any
+		require.NoError(t, json.Unmarshal(w.Body.Bytes(), &rsp))
+		require.Equal(t, akmaKaf, rsp["kaf"])
+		require.Equal(t, "2026-10-19T20:00:00Z", rsp["expiry"])
+		// TS 33.535 clause 6.3 step 5.
+		require.NotContains(t, rsp, "supi")
+		require.NotContains(t, rsp, "gpsi")
+	})
+
+	t.Run("anonymous access relayed to the AAnF", func(t *testing.T) {
+		initNRFDiscAANFStub(true)
+		initAANFRetrieveStub(true, http.StatusOK, `{"kaf":"`+akmaKaf+`","expiry":"2026-10-19T20:00:00Z"}`)
+
+		w := akmaRetrieve(models.AkmaAfKeyRequest{AfId: akmaAfId, AKId: akmaAKId, AnonInd: true}, akmaAfAddr)
+		require.Equal(t, http.StatusOK, w.Code)
+		require.NotContains(t, w.Body.String(), "supi")
+		require.NotContains(t, w.Body.String(), "gpsi")
+	})
+
+	t.Run("AF not authorized", func(t *testing.T) {
+		cases := map[string]models.AkmaAfKeyRequest{
+			"192.0.2.10":        {AfId: "af2.akma.example.FF00000001", AKId: akmaAKId},
+			"192.0.2.99":        {AfId: akmaAfId, AKId: akmaAKId},
+			"::ffff:192.0.2.99": {AfId: akmaAfId, AKId: akmaAKId},
+		}
+		for remote, req := range cases {
+			w := akmaRetrieve(req, remote)
+			require.Equal(t, http.StatusForbidden, w.Code, remote)
+			require.Empty(t, akmaProblem(t, w).Cause)
+		}
+	})
+
+	t.Run("bad requests", func(t *testing.T) {
+		cases := []struct {
+			req   models.AkmaAfKeyRequest
+			param string
+		}{
+			{models.AkmaAfKeyRequest{AKId: akmaAKId}, "/afId"},
+			{models.AkmaAfKeyRequest{AfId: akmaAfId}, "/aKId"},
+			{models.AkmaAfKeyRequest{AfId: "af1.akma.example", AKId: akmaAKId}, "/afId"},
+			{models.AkmaAfKeyRequest{AfId: akmaAfId, AKId: "not-an-akid"}, "/aKId"},
+		}
+		for _, tc := range cases {
+			w := akmaRetrieve(tc.req, akmaAfAddr)
+			require.Equal(t, http.StatusBadRequest, w.Code)
+			pd := akmaProblem(t, w)
+			require.Len(t, pd.InvalidParams, 1)
+			require.Equal(t, tc.param, pd.InvalidParams[0].Param)
+		}
+	})
+
+	errorCases := []struct {
+		name      string
+		status    int
+		body      string
+		wantCode  int
+		wantCause string
+	}{
+		{"K_AKMA_NOT_PRESENT relayed", http.StatusForbidden,
+			`{"status":403,"cause":"K_AKMA_NOT_PRESENT"}`, http.StatusForbidden, "K_AKMA_NOT_PRESENT"},
+		{"NEF not authorized at the AAnF", http.StatusForbidden,
+			`{"status":403,"detail":"AF_ID not accepted from this NEF"}`, http.StatusForbidden, ""},
+		{"other 4xx of the AAnF", http.StatusBadRequest,
+			`{"status":400,"cause":"MANDATORY_IE_INCORRECT"}`, http.StatusInternalServerError, "SYSTEM_FAILURE"},
+		{"AAnF unavailable", http.StatusServiceUnavailable, "", http.StatusServiceUnavailable, ""},
+	}
+	for _, tc := range errorCases {
+		t.Run(tc.name, func(t *testing.T) {
+			initNRFDiscAANFStub(true)
+			initAANFRetrieveStub(false, tc.status, tc.body)
+
+			w := akmaRetrieve(models.AkmaAfKeyRequest{AfId: akmaAfId, AKId: akmaAKId}, akmaAfAddr)
+			require.Equal(t, tc.wantCode, w.Code)
+			require.Equal(t, tc.wantCause, akmaProblem(t, w).Cause)
+		})
+	}
+
+	t.Run("204 of the AAnF relayed", func(t *testing.T) {
+		initNRFDiscAANFStub(true)
+		initAANFRetrieveStub(false, http.StatusNoContent, "")
+
+		w := akmaRetrieve(models.AkmaAfKeyRequest{AfId: akmaAfId, AKId: akmaAKId}, akmaAfAddr)
+		require.Equal(t, http.StatusNoContent, w.Code)
+		require.Empty(t, w.Body.String())
+	})
+
+	t.Run("no AAnF at the NRF", func(t *testing.T) {
+		initNRFDiscAANFStub(false)
+
+		w := akmaRetrieve(models.AkmaAfKeyRequest{AfId: akmaAfId, AKId: akmaAKId}, akmaAfAddr)
+		require.Equal(t, http.StatusServiceUnavailable, w.Code)
+		akmaProblem(t, w)
+	})
+}
+
+// The NEF never writes K_AF to the log.
+func TestAkmaNoKeyInLogs(t *testing.T) {
+	setAkmaPolicy(t)
+	var buf bytes.Buffer
+	out := logger.Log.Out
+	logger.Log.SetOutput(&buf)
+	defer logger.Log.SetOutput(out)
+
+	initNRFDiscAANFStub(true)
+	initAANFRetrieveStub(false, http.StatusOK,
+		`{"kaf":"`+akmaKaf+`","expiry":"2026-10-19T20:00:00Z","supi":"`+akmaSupi+`"}`)
+	w := akmaRetrieve(models.AkmaAfKeyRequest{AfId: akmaAfId, AKId: akmaAKId}, akmaAfAddr)
+	require.Equal(t, http.StatusOK, w.Code)
+
+	logs := buf.String()
+	require.Contains(t, logs, "relayed to AF_ID "+akmaAfId)
+	require.False(t, strings.Contains(strings.ToLower(logs), akmaKaf), "K_AF in the log")
+	require.NotContains(t, logs, akmaSupi)
+}
