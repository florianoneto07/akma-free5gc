diff --git a/internal/sbi/api_akma.go b/internal/sbi/api_akma.go
new file mode 100644
index 0000000..d692cd5
--- /dev/null
+++ b/internal/sbi/api_akma.go
@@ -0,0 +1,59 @@
+package sbi
+
+import (
+	"mime"
+	"net/http"
+	"net/netip"
+
+	"github.com/free5gc/nef/internal/logger"
+	"github.com/free5gc/nef/internal/sbi/processor"
+	"github.com/free5gc/openapi"
+	"github.com/free5gc/openapi/models"
+	"github.com/gin-gonic/gin"
+)
+
+// getAkmaRoutes returns the custom operations of the AKMA API
+// (3GPP TS 29.522 table 5.14.3.1-1).
+func (s *Server) getAkmaRoutes() []Route {
+	return []Route{
+		{
+			Method:  http.MethodPost,
+			Pattern: "/retrieve",
+			APIFunc: s.apiPostAkmaRetrieve,
+		},
+	}
+}
+
+func (s *Server) apiPostAkmaRetrieve(gc *gin.Context) {
+	// 3GPP TS 29.122 table 5.2.6-1: 415 for a body format the server does
+	// not support.
+	mediaType, _, err := mime.ParseMediaType(gc.GetHeader("Content-Type"))
+	if err != nil || mediaType != "application/json" {
+		processor.WriteAkmaProblem(gc, &models.ProblemDetails{
+			Title:  "Unsupported Media Type",
+			Status: http.StatusUnsupportedMediaType,
+			Detail: "the request body must be application/json",
+		})
+		return
+	}
+	reqBody, err := gc.GetRawData()
+	if err != nil {
+		logger.SBILog.Errorf("Get Request Body error: %+v", err)
+		processor.WriteAkmaProblem(gc, openapi.ProblemDetailsSystemFailure(err.Error()))
+		return
+	}
+	var req models.AkmaAfKeyRequest
+	if err = openapi.Deserialize(&req, reqBody, "application/json"); err != nil {
+		logger.SBILog.Errorf("Deserialize Request Body error: %+v", err)
+		processor.WriteAkmaProblem(gc, openapi.ProblemDetailsMalformedReqSyntax(err.Error()))
+		return
+	}
+	// The source address of the AF is taken from the connection, never from
+	// forwarding headers, which the AF could set.
+	ap, err := netip.ParseAddrPort(gc.Request.RemoteAddr)
+	if err != nil {
+		processor.WriteAkmaProblem(gc, openapi.ProblemDetailsSystemFailure("source address of the request"))
+		return
+	}
+	s.Processor().RetrieveAkmaApplicationKey(gc, &req, ap.Addr().Unmap())
+}
diff --git a/internal/sbi/consumer/aanf_service.go b/internal/sbi/consumer/aanf_service.go
new file mode 100644
index 0000000..a637618
--- /dev/null
+++ b/internal/sbi/consumer/aanf_service.go
@@ -0,0 +1,76 @@
+package consumer
+
+import (
+	"context"
+	"fmt"
+	"net/http"
+	"sync"
+
+	"github.com/free5gc/openapi"
+	Naanf_AKMA "github.com/free5gc/openapi/aanf/AKMA"
+	"github.com/free5gc/openapi/models"
+	"github.com/free5gc/openapi/nrf/NFDiscovery"
+	sbi_metrics "github.com/free5gc/util/metrics/sbi"
+)
+
+type naanfService struct {
+	consumer *Consumer
+
+	mu      sync.RWMutex
+	clients map[string]*Naanf_AKMA.APIClient
+}
+
+func (s *naanfService) getClient(uri string) *Naanf_AKMA.APIClient {
+	s.mu.RLock()
+	client, ok := s.clients[uri]
+	s.mu.RUnlock()
+	if ok {
+		return client
+	}
+	cfg := Naanf_AKMA.NewConfiguration()
+	cfg.SetBasePath(uri)
+	cfg.SetMetrics(sbi_metrics.SbiMetricHook)
+	cfg.SetHTTPClient(http.DefaultClient)
+	client = Naanf_AKMA.NewAPIClient(cfg)
+
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.clients[uri] = client
+	return client
+}
+
+// AanfUri discovers at the NRF an AAnF that serves the Routing Indicator rid
+// (3GPP TS 33.535 clause 6.7; TS 29.510 table 6.2.3.2.3.1-1).
+func (s *naanfService) AanfUri(rid string) (string, error) {
+	param := &NFDiscovery.SearchNFInstancesRequest{
+		ServiceNames:     []models.ServiceName{models.ServiceName_NAANF_AKMA},
+		RoutingIndicator: &rid,
+	}
+	_, uri, err := s.consumer.SearchNFInstances(s.consumer.Config().NrfUri(), models.ServiceName_NAANF_AKMA,
+		models.NrfNfManagementNfType_AANF, models.NrfNfManagementNfType_NEF, param)
+	if err != nil {
+		return "", fmt.Errorf("AAnF discovery: %w", err)
+	}
+	return uri, nil
+}
+
+// GetAKMAAPPKeyMaterial sends Naanf_AKMA_ApplicationKey_Get to the AAnF at
+// uri (3GPP TS 29.535 clause 4.2.2.3.2).
+func (s *naanfService) GetAKMAAPPKeyMaterial(ctx context.Context, uri string, req models.AkmaAfKeyRequest) (
+	*Naanf_AKMA.GetAKMAAPPKeyMaterialResponse, error,
+) {
+	tokenCtx, pd, err := s.consumer.Context().GetTokenCtx(models.ServiceName_NAANF_AKMA,
+		models.NrfNfManagementNfType_AANF)
+	if err != nil {
+		return nil, fmt.Errorf("access token for naanf-akma: %w", err)
+	}
+	if pd != nil {
+		return nil, fmt.Errorf("access token for naanf-akma: %d %s", pd.Status, pd.Cause)
+	}
+	if tok := tokenCtx.Value(openapi.ContextOAuth2); tok != nil {
+		ctx = context.WithValue(ctx, openapi.ContextOAuth2, tok)
+	}
+	r := &Naanf_AKMA.GetAKMAAPPKeyMaterialRequest{}
+	r.SetAkmaAfKeyRequest(req)
+	return s.getClient(uri).RetrieveTheAKMAApplicationKeyMaterialCollectionApi.GetAKMAAPPKeyMaterial(ctx, r)
+}
