diff --git a/nefcfg.yaml b/nefcfg.yaml
index 48f8fb6..5126155 100644
--- a/nefcfg.yaml
+++ b/nefcfg.yaml
@@ -5,8 +5,8 @@ info:
 configuration:
   sbi:
     scheme: http # The protocol for sbi (http or https)
-    registerIPv4: 127.0.0.5 # IP used to register to NRF
-    bindingIPv4: 127.0.0.5 # IP used to bind the service
+    registerIPv4: 192.168.16.130 # IP used to register to NRF; reachable from the external AF (AKMA, TS 33.535 cl. 6.3)
+    bindingIPv4: 192.168.16.130 # IP used to bind the service
     port: 8000 # port used to bind the service
     tls: # the local path of TLS key
       pem: cert/nef.pem # NEF TLS Certificate
@@ -18,6 +18,44 @@ configuration:
     - serviceName: nnef-oam # OAM service
     - serviceName: 3gpp-traffic-influence # AF-facing Traffic Influence API
     - serviceName: nnef-callback # Inbound SMF event notification callback
+    - serviceName: 3gpp-akma # AF-facing AKMA API (3GPP TS 29.522 clause 5.14)
+  akma: # AKMA API
+    authorizedAfs: # local policy, 3GPP TS 33.535 clause 6.3 step 2; one AF_ID per Ua* profile and cipher suite
+      # "<FQDN>.<Ua* security protocol id>", each with the addresses from which
+      # the AF may request its K_AF
+      - afId: af1.akma.example.0100011301 # Digest in TLS 1.3 (3GPP TS 24.109 K.2), TLS_AES_128_GCM_SHA256 (3GPP TS 33.220 H.3)
+        sourceAddresses:
+          - 192.168.16.129
+      - afId: af1.akma.example.0100011302 # TLS_AES_256_GCM_SHA384
+        sourceAddresses:
+          - 192.168.16.129
+      - afId: af1.akma.example.0100011303 # TLS_CHACHA20_POLY1305_SHA256
+        sourceAddresses:
+          - 192.168.16.129
+      - afId: af1.akma.example.010001C02B # Digest in TLS 1.2, TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256
+        sourceAddresses:
+          - 192.168.16.129
+      - afId: af1.akma.example.010001C02C # TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384
+        sourceAddresses:
+          - 192.168.16.129
+      - afId: af1.akma.example.0100000007 # TLS 1.3 with K_AF as pre-shared key (K.3.3)
+        sourceAddresses:
+          - 192.168.16.129
+      - afId: af1.akma.example.010001D001 # (D)TLS 1.2, TLS_ECDHE_PSK_WITH_AES_128_GCM_SHA256 (K.3.2)
+        sourceAddresses:
+          - 192.168.16.129
+      - afId: af1.akma.example.0100000009 # DTLS 1.3 with K_AF as pre-shared key (3GPP TS 33.535 Annex C)
+        sourceAddresses:
+          - 192.168.16.129
+      - afId: af1.akma.example.0100000008 # OSCORE with a context from K_AF (3GPP TS 33.535 Annex D)
+        sourceAddresses:
+          - 192.168.16.129
+      - afId: af1.akma.example.FF00000001 # simplified Ua*, test only (3GPP TS 33.220 H.2 NOTE 2)
+        sourceAddresses:
+          - 192.168.16.129
+      - afId: af3.akma.example.FF00000001 # test only: accepted here and not by the AAnF (negative test E07)
+        sourceAddresses:
+          - 192.168.16.129
 
 logger: # log output setting
   enable: true # true or false
