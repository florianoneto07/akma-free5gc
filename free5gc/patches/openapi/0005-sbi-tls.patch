+func TestExtraClientCA(t *testing.T) {
+	l := newLab(t)
+	invokers := newCA(t, "invokers")
+	cert := l.ca.issue(t, leafOptions{serial: 1, id: serverId, crl: l.crl.URL + "/ca.crl", dns: testName})
+	nef, err := New(Config{Certificate: cert.certFile, Key: cert.keyFile, CA: l.ca.file,
