+func newLab(t *testing.T) *lab {
+	t.Helper()
+	ca := newCA(t, "CA")
+	return &lab{ca: ca, crl: newCrlServer(t, ca.crl(t, time.Now().Add(-time.Minute), time.Now().Add(time.Hour)))}
