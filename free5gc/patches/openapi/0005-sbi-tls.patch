diff --git a/oauth/peer.go b/oauth/peer.go
new file mode 100644
index 0000000..9529e86
--- /dev/null
+++ b/oauth/peer.go
@@ -0,0 +1,25 @@
+package oauth
+
+import (
+	"crypto/tls"
+	"encoding/json"
+	"net/http"
+)
+
+// CheckTokenPeer ties an access token to the TLS client of the request. Without
+// a token or without TLS, there is nothing to check.
+func CheckTokenPeer(authorization string, peer *tls.ConnectionState) error {
+	return nil
+}
+
+// WriteTokenError answers a request that the check of the access token refused.
+func WriteTokenError(w http.ResponseWriter, r *http.Request, err error) {
+	body, jsonErr := json.Marshal(map[string]string{"error": err.Error()})
+	if jsonErr != nil {
+		http.Error(w, http.StatusText(http.StatusInternalServerError), http.StatusInternalServerError)
+		return
+	}
+	w.Header().Set("Content-Type", "application/json; charset=utf-8")
+	w.WriteHeader(http.StatusUnauthorized)
+	_, _ = w.Write(body)
+}
diff --git a/sbitls/crl.go b/sbitls/crl.go
new file mode 100644
index 0000000..78ee9e1
--- /dev/null
+++ b/sbitls/crl.go
@@ -0,0 +1,155 @@
+package sbitls
+
+import (
+	"bytes"
+	"crypto/x509"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"strings"
+	"sync"
+	"time"
+)
+
+const (
+	crlTimeout = 2 * time.Second
+	crlMaxSize = 1 << 20
+)
+
+// crlStore keeps the CRLs by the URI of the distribution point. A CRL is
+// fetched when it is not in memory and after its nextUpdate, one fetch per URI
+// at a time.
+type crlStore struct {
+	mu      sync.Mutex
+	entries map[string]*crlEntry
+	client  *http.Client
+	log     Logger
+}
+
+type crlEntry struct {
+	mu   sync.Mutex
+	list *x509.RevocationList
+}
+
+func newCrlStore(log Logger) *crlStore {
+	return &crlStore{
+		entries: make(map[string]*crlEntry),
+		log:     log,
+		client: &http.Client{
+			Timeout:   crlTimeout,
+			Transport: &http.Transport{DisableKeepAlives: true},
+			CheckRedirect: func(*http.Request, []*http.Request) error {
+				return http.ErrUseLastResponse
+			},
+		},
+	}
+}
+
+// distributionPoint is the HTTP URI of the CRL distribution point of a
+// certificate; only HTTP is supported (TS 33.310 cl. 6.1a).
+func distributionPoint(cert *x509.Certificate) string {
+	for _, uri := range cert.CRLDistributionPoints {
+		if strings.HasPrefix(uri, "http://") {
+			return uri
+		}
+	}
+	return ""
+}
+
+// check refuses a certificate without a distribution point, without a valid
+// CRL, or revoked (TS 33.310 cl. 6.3.1).
+func (s *crlStore) check(cert, issuer *x509.Certificate) error {
+	uri := distributionPoint(cert)
+	if uri == "" {
+		return errors.New("certificate without an HTTP CRL distribution point")
+	}
+	list, err := s.get(uri, []*x509.Certificate{issuer})
+	if err != nil {
+		return fmt.Errorf("CRL %s not available: %w", uri, err)
+	}
+	for _, revoked := range list.RevokedCertificateEntries {
+		if revoked.SerialNumber.Cmp(cert.SerialNumber) == 0 {
+			return fmt.Errorf("certificate %s revoked", cert.SerialNumber.Text(16))
+		}
+	}
+	return nil
+}
+
+func (s *crlStore) prefetch(uri string, issuers []*x509.Certificate) error {
+	_, err := s.get(uri, issuers)
+	return err
+}
+
+func (s *crlStore) get(uri string, issuers []*x509.Certificate) (*x509.RevocationList, error) {
+	s.mu.Lock()
+	entry := s.entries[uri]
+	if entry == nil {
+		entry = &crlEntry{}
+		s.entries[uri] = entry
+	}
+	s.mu.Unlock()
+
+	entry.mu.Lock()
+	defer entry.mu.Unlock()
+	now := time.Now()
+	if entry.list != nil && now.Before(entry.list.NextUpdate) && issuedByOneOf(entry.list, issuers) == nil {
+		return entry.list, nil
+	}
+	list, err := s.fetch(uri, issuers, now)
+	if err != nil {
+		return nil, err
+	}
+	entry.list = list
+	s.log.Infof("CRL %s loaded: %d revoked, next update %s", uri, len(list.RevokedCertificateEntries),
+		list.NextUpdate.UTC().Format(time.RFC3339))
+	return list, nil
+}
+
+func (s *crlStore) fetch(uri string, issuers []*x509.Certificate, now time.Time) (*x509.RevocationList, error) {
+	resp, err := s.client.Get(uri)
+	if err != nil {
+		return nil, err
+	}
+	defer resp.Body.Close() //nolint:errcheck
+	if resp.StatusCode != http.StatusOK {
+		return nil, fmt.Errorf("status %d", resp.StatusCode)
+	}
+	der, err := io.ReadAll(io.LimitReader(resp.Body, crlMaxSize+1))
+	if err != nil {
+		return nil, err
+	}
+	if len(der) > crlMaxSize {
+		return nil, fmt.Errorf("larger than %d octets", crlMaxSize)
+	}
+	list, err := x509.ParseRevocationList(der)
+	if err != nil {
+		return nil, err
+	}
+	// A CRL of version 2 has the CRL number (RFC 5280 cl. 5.2.3).
+	if list.Number == nil {
+		return nil, errors.New("not a v2 CRL (TS 33.310 cl. 6.1a)")
+	}
+	if err = issuedByOneOf(list, issuers); err != nil {
+		return nil, err
+	}
+	if now.Before(list.ThisUpdate) || !now.Before(list.NextUpdate) {
+		return nil, fmt.Errorf("out of date: this update %s, next update %s",
+			list.ThisUpdate.UTC().Format(time.RFC3339), list.NextUpdate.UTC().Format(time.RFC3339))
+	}
+	return list, nil
+}
+
+func issuedByOneOf(list *x509.RevocationList, issuers []*x509.Certificate) error {
+	err := errors.New("no issuer")
+	for _, issuer := range issuers {
+		if !bytes.Equal(list.RawIssuer, issuer.RawSubject) {
+			err = errors.New("issuer of the CRL differs from the issuer of the certificate")
+			continue
+		}
+		if err = list.CheckSignatureFrom(issuer); err == nil {
+			return nil
+		}
+	}
+	return err
+}
diff --git a/sbitls/identity.go b/sbitls/identity.go
new file mode 100644
index 0000000..3351bea
--- /dev/null
+++ b/sbitls/identity.go
@@ -0,0 +1,60 @@
+package sbitls
+
+import (
+	"crypto/tls"
+	"crypto/x509"
+	"encoding/asn1"
+	"errors"
+	"strings"
+)
+
+// oidNfTypes is id-pe-nftype (RFC 9310 cl. 3).
+var oidNfTypes = asn1.ObjectIdentifier{1, 3, 6, 1, 5, 5, 7, 1, 34}
+
+// NfInstanceId returns the NF instance ID of a certificate: the URI-ID
+// "urn:uuid:<id>" of the subjectAltName (TS 33.310 cl. 6.1.3c.3). A certificate
+// with more than one is refused: it has no single identity.
+func NfInstanceId(cert *x509.Certificate) (string, error) {
+	id := ""
+	for _, uri := range cert.URIs {
+		if uri.Scheme != "urn" || !strings.HasPrefix(uri.Opaque, "uuid:") {
+			continue
+		}
+		if id != "" {
+			return "", errors.New("certificate with more than one NF instance ID")
+		}
+		id = strings.ToLower(strings.TrimPrefix(uri.Opaque, "uuid:"))
+	}
+	if id == "" {
+		return "", errors.New("certificate without an NF instance ID")
+	}
+	return id, nil
+}
+
+// NfTypes returns the NFTypes extension of a certificate (RFC 9310 cl. 3).
+func NfTypes(cert *x509.Certificate) ([]string, error) {
+	for _, ext := range cert.Extensions {
+		if !ext.Id.Equal(oidNfTypes) {
+			continue
+		}
+		var types []string
+		rest, err := asn1.Unmarshal(ext.Value, &types)
+		if err != nil {
+			return nil, err
+		}
+		if len(rest) != 0 || len(types) == 0 {
+			return nil, errors.New("malformed NFTypes extension")
+		}
+		return types, nil
+	}
+	return nil, errors.New("certificate without the NFTypes extension")
+}
+
+// PeerCertificate returns the certificate of the other end of a connection, nil
+// without TLS.
+func PeerCertificate(state *tls.ConnectionState) *x509.Certificate {
+	if state == nil || len(state.PeerCertificates) == 0 {
+		return nil
+	}
+	return state.PeerCertificates[0]
+}
diff --git a/sbitls/sbitls.go b/sbitls/sbitls.go
new file mode 100644
index 0000000..bed3691
--- /dev/null
+++ b/sbitls/sbitls.go
@@ -0,0 +1,353 @@
+// Package sbitls is the TLS of the service-based interfaces: mutually
+// authenticated, with the certificates of the SBA profile of TS 33.310
+// cl. 6.1.3c and the TLS profile of TS 33.210 cl. 6.2, restricted by RFC 9113
+// (TS 33.501 cl. 13.1.0). crypto/tls checks the chain, the validity and the
+// name of the peer; this package adds the check of the CRL (TS 33.310
+// cl. 6.3.1) and reads the NF instance ID and the NF types of a certificate.
+package sbitls
+
+import (
+	"context"
+	"crypto/tls"
+	"crypto/x509"
+	"encoding/pem"
+	"errors"
+	"fmt"
+	"log"
+	"net"
+	"net/http"
+	"os"
+	"regexp"
+	"strings"
+	"sync/atomic"
+	"time"
+)
+
+// ErrNotConfigured is the error of an https request before Init: there is no
+// fallback to a client that does not check the server.
+var ErrNotConfigured = errors.New("SBI TLS not configured")
+
+// Logger is what the package needs of a logger; a logrus entry fits it.
+type Logger interface {
+	Infof(format string, args ...interface{})
+	Warnf(format string, args ...interface{})
+}
+
+type discard struct{}
+
+func (discard) Infof(string, ...interface{}) {}
+func (discard) Warnf(string, ...interface{}) {}
+
+// Config is the TLS configuration of one network function.
+type Config struct {
+	// Certificate and Key are the PEM files of the client and server
+	// certificate of the NF (TS 33.310 cl. 6.1.3c.3).
+	Certificate string
+	Key         string
+	// KeyPair replaces Certificate and Key for a certificate that is not in
+	// a file and that CA did not sign, such as the one of an API invoker.
+	KeyPair *tls.Certificate
+	// CA is the PEM file with the CA certificates of the peers.
+	CA string
+	// NfInstanceId, when not empty, has to be the NF instance ID of the
+	// certificate.
+	NfInstanceId string
+	// ExtraClientCA is a PEM file with another CA for client certificates,
+	// such as the CA of the API invokers at the NEF.
+	ExtraClientCA string
+	// ExtraClientCANoCrl says that the certificates of ExtraClientCA have no
+	// CRL distribution point.
+	ExtraClientCANoCrl bool
+	Logger             Logger
+}
+
+// Context holds the certificate, the CAs and the CRLs of a network function.
+type Context struct {
+	keyPair      tls.Certificate
+	leaf         *x509.Certificate
+	roots        *x509.CertPool
+	clientCAs    *x509.CertPool
+	extraIssuers []*x509.Certificate
+	extraNoCrl   bool
+	crls         *crlStore
+	log          Logger
+}
+
+var current atomic.Pointer[Context]
+
+func readCAs(path string) ([]*x509.Certificate, error) {
+	data, err := os.ReadFile(path)
+	if err != nil {
+		return nil, err
+	}
+	var cas []*x509.Certificate
+	for {
+		var block *pem.Block
+		block, data = pem.Decode(data)
+		if block == nil {
+			break
+		}
+		if block.Type != "CERTIFICATE" {
+			continue
+		}
+		ca, parseErr := x509.ParseCertificate(block.Bytes)
+		if parseErr != nil {
+			return nil, fmt.Errorf("%s: %w", path, parseErr)
+		}
+		cas = append(cas, ca)
+	}
+	if len(cas) == 0 {
+		return nil, fmt.Errorf("%s: no certificate", path)
+	}
+	return cas, nil
+}
+
+// New reads the configuration and checks that the certificate is the one of
+// this NF. A CRL that cannot be fetched now is only reported: the check of a
+// peer tries again and fails closed.
+func New(cfg Config) (*Context, error) {
+	c := &Context{log: cfg.Logger, extraNoCrl: cfg.ExtraClientCANoCrl}
+	if c.log == nil {
+		c.log = discard{}
+	}
+	if cfg.CA == "" {
+		return nil, errors.New("no CA for https: sbi.tls.ca")
+	}
+	cas, err := readCAs(cfg.CA)
+	if err != nil {
+		return nil, err
+	}
+	c.roots = x509.NewCertPool()
+	c.clientCAs = x509.NewCertPool()
+	for _, ca := range cas {
+		c.roots.AddCert(ca)
+		c.clientCAs.AddCert(ca)
+	}
+	if cfg.ExtraClientCA != "" {
+		if c.extraIssuers, err = readCAs(cfg.ExtraClientCA); err != nil {
+			return nil, err
+		}
+		for _, ca := range c.extraIssuers {
+			c.clientCAs.AddCert(ca)
+		}
+	}
+
+	if cfg.KeyPair != nil {
+		c.keyPair = *cfg.KeyPair
+	} else if c.keyPair, err = tls.LoadX509KeyPair(cfg.Certificate, cfg.Key); err != nil {
+		return nil, err
+	}
+	if c.leaf, err = x509.ParseCertificate(c.keyPair.Certificate[0]); err != nil {
+		return nil, err
+	}
+	c.keyPair.Leaf = c.leaf
+	if cfg.KeyPair == nil {
+		if _, err = c.leaf.Verify(x509.VerifyOptions{
+			Roots:     c.roots,
+			KeyUsages: []x509.ExtKeyUsage{x509.ExtKeyUsageAny},
+		}); err != nil {
+			return nil, fmt.Errorf("own certificate %s: %w", cfg.Certificate, err)
+		}
+	}
+	if cfg.NfInstanceId != "" {
+		id, idErr := NfInstanceId(c.leaf)
+		if idErr != nil {
+			return nil, fmt.Errorf("own certificate %s: %w", cfg.Certificate, idErr)
+		}
+		if !strings.EqualFold(id, cfg.NfInstanceId) {
+			return nil, fmt.Errorf("own certificate %s is of NF instance %s, not of %s",
+				cfg.Certificate, id, cfg.NfInstanceId)
+		}
+	}
+
+	c.crls = newCrlStore(c.log)
+	if uri := distributionPoint(c.leaf); uri != "" && cfg.KeyPair == nil {
+		if err = c.crls.prefetch(uri, cas); err != nil {
+			c.log.Warnf("CRL %s not available: %v", uri, err)
+		}
+	}
+	return c, nil
+}
+
+// Init makes the configuration the one of the process: of the client of the
+// openapi package, of the servers of ConfigureServer, and of the default HTTP
+// transport, that some consumers of the NFs use.
+func Init(cfg Config) error {
+	c, err := New(cfg)
+	if err != nil {
+		return err
+	}
+	current.Store(c)
+	if t, ok := http.DefaultTransport.(*http.Transport); ok {
+		t.TLSClientConfig = c.ClientTLSConfig()
+	}
+	c.log.Infof("SBI TLS: certificate of %s, NF instance %s, type %s, issued by %s, valid until %s",
+		c.subjectName(), c.NfInstanceId(), strings.Join(c.NfTypes(), ","), c.leaf.Issuer.CommonName,
+		c.leaf.NotAfter.UTC().Format(time.RFC3339))
+	return nil
+}
+
+// Current returns the configuration of the process, nil before Init.
+func Current() *Context {
+	return current.Load()
+}
+
+func (c *Context) subjectName() string {
+	if len(c.leaf.DNSNames) > 0 {
+		return c.leaf.DNSNames[0]
+	}
+	return c.leaf.Subject.CommonName
+}
+
+// NfInstanceId returns the NF instance ID of the certificate of this NF, empty
+// when it has none.
+func (c *Context) NfInstanceId() string {
+	id, err := NfInstanceId(c.leaf)
+	if err != nil {
+		return ""
+	}
+	return id
+}
+
+// NfTypes returns the NF types of the certificate of this NF.
+func (c *Context) NfTypes() []string {
+	types, err := NfTypes(c.leaf)
+	if err != nil {
+		return nil
+	}
+	return types
+}
+
+// profile is the TLS profile of both ends (TS 33.210 cl. 6.2): TLS 1.3 and
+// 1.2, and in TLS 1.2 only ECDHE with AEAD. The list has the suites that
+// RFC 9113 cl. 9.2.2 requires. No OCSP stapling: revocation is by CRL.
+func profile() *tls.Config {
+	return &tls.Config{
+		MinVersion: tls.VersionTLS12,
+		CipherSuites: []uint16{
+			tls.TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256,
+			tls.TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256,
+			tls.TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384,
+			tls.TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384,
+			tls.TLS_ECDHE_ECDSA_WITH_CHACHA20_POLY1305_SHA256,
+			tls.TLS_ECDHE_RSA_WITH_CHACHA20_POLY1305_SHA256,
+		},
+		CurvePreferences: []tls.CurveID{tls.X25519, tls.CurveP256, tls.CurveP384},
+	}
+}
+
+// ClientTLSConfig is the configuration of a TLS client: the certificate of the
+// NF, the check of the server by the CAs and by the name of the URI, the SNI
+// when the URI has a name, and the check of the CRL.
+func (c *Context) ClientTLSConfig() *tls.Config {
+	cfg := profile()
+	cfg.Certificates = []tls.Certificate{c.keyPair}
+	cfg.RootCAs = c.roots
+	cfg.VerifyConnection = c.verifyPeer
+	return cfg
+}
+
+// ServerTLSConfig is the configuration of a TLS server: the client certificate
+// is required in the handshake (TS 33.210 cl. 6.2.2: HTTP/2 servers do not ask
+// for it later) and checked by the CAs and the CRL.
+func (c *Context) ServerTLSConfig() *tls.Config {
+	cfg := profile()
+	cfg.Certificates = []tls.Certificate{c.keyPair}
+	cfg.ClientAuth = tls.RequireAndVerifyClientCert
+	cfg.ClientCAs = c.clientCAs
+	cfg.VerifyConnection = c.verifyPeer
+	return cfg
+}
+
+// verifyPeer runs in every handshake, also a resumed one, after crypto/tls has
+// checked the chain: the result is not kept beyond the connection
+// (TS 33.310 cl. 6.3.1).
+func (c *Context) verifyPeer(state tls.ConnectionState) error {
+	if len(state.VerifiedChains) == 0 || len(state.VerifiedChains[0]) < 2 {
+		return errors.New("peer certificate without a verified chain")
+	}
+	peer, issuer := state.VerifiedChains[0][0], state.VerifiedChains[0][1]
+	if c.extraNoCrl {
+		for _, ca := range c.extraIssuers {
+			if ca.Equal(issuer) {
+				return nil
+			}
+		}
+	}
+	return c.crls.check(peer, issuer)
+}
+
+// IsExtraClient reports whether the client of a connection came with a
+// certificate of Config.ExtraClientCA.
+func IsExtraClient(state *tls.ConnectionState) bool {
+	c := current.Load()
+	if c == nil || state == nil || len(state.VerifiedChains) == 0 || len(state.VerifiedChains[0]) < 2 {
+		return false
+	}
+	for _, ca := range c.extraIssuers {
+		if ca.Equal(state.VerifiedChains[0][1]) {
+			return true
+		}
+	}
+	return false
+}
+
+// DialTLSContext dials for an HTTP/2 transport, with the configuration of the
+// process. base has the name of the URI and the protocols of the transport.
+func DialTLSContext(ctx context.Context, network, addr string, base *tls.Config) (net.Conn, error) {
+	c := current.Load()
+	if c == nil {
+		return nil, ErrNotConfigured
+	}
+	return c.DialTLSContext(ctx, network, addr, base)
+}
+
+// DialTLSContext dials with this configuration.
+func (c *Context) DialTLSContext(ctx context.Context, network, addr string, base *tls.Config) (net.Conn, error) {
+	cfg := c.ClientTLSConfig()
+	if base != nil {
+		cfg.ServerName = base.ServerName
+		cfg.NextProtos = base.NextProtos
+	}
+	raw, err := (&net.Dialer{}).DialContext(ctx, network, addr)
+	if err != nil {
+		return nil, err
+	}
+	conn := tls.Client(raw, cfg)
+	if err = conn.HandshakeContext(ctx); err != nil {
+		_ = raw.Close()
+		c.log.Warnf("TLS handshake with %s refused: %v", addr, err)
+		return nil, err
+	}
+	return conn, nil
+}
+
+// ConfigureServer gives a server the TLS of the process, and the refused
+// handshakes to the log of the NF. Without Init, it leaves the server as it is.
+func ConfigureServer(server *http.Server) {
+	if c := current.Load(); c != nil {
+		c.ConfigureServer(server)
+	}
+}
+
+// ConfigureServer gives a server this configuration.
+func (c *Context) ConfigureServer(server *http.Server) {
+	server.TLSConfig = c.ServerTLSConfig()
+	server.ErrorLog = log.New(handshakeLog{c.log}, "", 0)
+}
+
+var handshakeError = regexp.MustCompile(`^http: TLS handshake error from (\S+): (.*)$`)
+
+type handshakeLog struct {
+	log Logger
+}
+
+func (h handshakeLog) Write(p []byte) (int, error) {
+	line := strings.TrimSpace(string(p))
+	if m := handshakeError.FindStringSubmatch(line); m != nil {
+		h.log.Warnf("TLS handshake with %s refused: %s", m[1], m[2])
+	} else {
+		h.log.Warnf("%s", line)
+	}
+	return len(p), nil
+}
