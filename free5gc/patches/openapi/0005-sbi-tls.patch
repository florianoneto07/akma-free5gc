+// getUriFromFqdn builds the apiRoot of a service registered with an FQDN: the
+// port of the ipEndPoints goes with the FQDN, and the API prefix is a path; the
+// absolute apiPrefix that the NFs of free5GC register is left out
+// (TS 29.510 table 6.1.6.2.3-1 NOTE 1, table 6.1.6.2.5-1 NOTES 2 to 4;
+// TS 29.501 cl. 4.4.1).
+func getUriFromFqdn(scheme models.UriScheme, fqdn string, points []models.IpEndPoint, apiPrefix string) string {
+	var port int32
+	for _, point := range points {
+		if point.Port != 0 {
+			port = point.Port
+			break
+		}
+	}
+	uri := getUriFromIpEndPoint(scheme, fqdn, port)
+	if strings.HasPrefix(apiPrefix, "/") {
+		uri += apiPrefix
+	}
+	return uri
+}
