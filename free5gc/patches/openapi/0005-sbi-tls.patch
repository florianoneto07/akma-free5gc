+type recorder func(string)
+
+func (r recorder) Infof(format string, args ...interface{}) { r(fmt.Sprintf(format, args...)) }
+func (r recorder) Warnf(format string, args ...interface{}) { r(fmt.Sprintf(format, args...)) }
