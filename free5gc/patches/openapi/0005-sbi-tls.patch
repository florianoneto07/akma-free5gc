+func TestClientRefusals(t *testing.T) {
+	l := newLab(t)
+	server := serve(t, l.context(t, serverId, 1), nil)
+	addr := server.Listener.Addr().String()
+
+	cases := map[string]func() *tls.Config{
+		"no client certificate": func() *tls.Config {
+			return &tls.Config{RootCAs: l.context(t, clientId, 2).roots, ServerName: testName}
+		},
+		"client of another CA": func() *tls.Config {
+			other := newCA(t, "other")
+			cert := other.issue(t, leafOptions{id: clientId})
+			pair, err := tls.LoadX509KeyPair(cert.certFile, cert.keyFile)
+			if err != nil {
+				t.Fatal(err)
+			}
+			return &tls.Config{RootCAs: l.context(t, clientId, 2).roots, ServerName: testName, Certificates: []tls.Certificate{pair}}
+		},
+	}
+	for name, config := range cases {
+		t.Run(name, func(t *testing.T) {
+			conn, err := tls.Dial("tcp", addr, config())
+			if err == nil {
+				// In TLS 1.3 the client sees the refusal in the first read.
+				_, err = conn.Read(make([]byte, 1))
+				_ = conn.Close()
+			}
+			if err == nil {
+				t.Fatal("handshake accepted")
+			}
+		})
+	}
+}
