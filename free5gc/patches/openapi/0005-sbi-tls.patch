+func (l *lab) context(t *testing.T, id string, serial int64) *Context {
+	t.Helper()
+	cert := l.ca.issue(t, leafOptions{serial: serial, id: id, crl: l.crl.URL + "/ca.crl", dns: testName, types: []string{"AMF"}})
+	c, err := New(Config{Certificate: cert.certFile, Key: cert.keyFile, CA: l.ca.file, NfInstanceId: id})
+	if err != nil {
+		t.Fatal(err)
+	}
+	return c
+}
+
+// serve starts a TLS server that answers with the NF instance ID of the client.
+func serve(t *testing.T, c *Context, seenName *atomic.Value) *httptest.Server {
+	t.Helper()
+	server := httptest.NewUnstartedServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		id, err := NfInstanceId(PeerCertificate(r.TLS))
+		if err != nil {
+			t.Error(err)
+		}
+		_, _ = io.WriteString(w, id)
+	}))
+	server.TLS = c.ServerTLSConfig()
+	server.TLS.NextProtos = []string{"http/1.1"}
+	if seenName != nil {
+		server.TLS.GetConfigForClient = func(hello *tls.ClientHelloInfo) (*tls.Config, error) {
+			seenName.Store(hello.ServerName)
+			return nil, nil
+		}
+	}
+	server.Config.ErrorLog = nil
+	server.StartTLS()
+	t.Cleanup(server.Close)
+	return server
+}
+
+// call dials addr with the name of the URI.
+func call(c *Context, addr, name string) (string, error) {
+	transport := &http.Transport{
+		DialTLSContext: func(ctx context.Context, network, a string) (net.Conn, error) {
+			return c.DialTLSContext(ctx, network, a, &tls.Config{ServerName: name})
+		},
+		DisableKeepAlives: true,
+	}
+	client := &http.Client{Transport: transport, Timeout: 5 * time.Second}
+	resp, err := client.Get("https://" + addr + "/")
+	if err != nil {
+		return "", err
+	}
+	defer resp.Body.Close() //nolint:errcheck
+	body, err := io.ReadAll(resp.Body)
+	return string(body), err
+}
