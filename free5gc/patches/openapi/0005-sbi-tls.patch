+	current.Store(nef)
+	defer current.Store(nil)
+	seen := make(chan bool, 2)
+	server := httptest.NewUnstartedServer(http.HandlerFunc(func(_ http.ResponseWriter, r *http.Request) {
+		seen <- IsExtraClient(r.TLS)
