+func TestCrlFetchedOncePerUri(t *testing.T) {
+	l := newLab(t)
+	server := serve(t, l.context(t, serverId, 1), nil)
+	client := l.context(t, clientId, 2)
+	before := l.crl.hits.Load()
+	done := make(chan error, 8)
+	for range 8 {
+		go func() {
+			_, err := call(client, server.Listener.Addr().String(), testName)
+			done <- err
+		}()
+	}
+	for range 8 {
+		if err := <-done; err != nil {
+			t.Fatal(err)
+		}
+	}
+	if got := l.crl.hits.Load() - before; got != 0 {
+		t.Errorf("%d more fetches of a CRL in memory", got)
+	}
+}
