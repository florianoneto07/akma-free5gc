+func TestGetNFServiceUri(t *testing.T) {
+	endpoint := []models.IpEndPoint{{Ipv4Address: "127.0.0.10", Port: 8000}}
+	noPort := []models.IpEndPoint{{Ipv4Address: "127.0.0.10"}}
+	cases := []struct {
+		name    string
+		profile string
+		service models.NrfNfDiscoveryNfService
+		want    string
+	}{
+		{"FQDN of the profile, port of ipEndPoints", "nrf.example.org",
+			models.NrfNfDiscoveryNfService{Scheme: models.UriScheme_HTTPS, IpEndPoints: endpoint},
+			"https://nrf.example.org:8000"},
+		{"FQDN of the service first", "nrf.example.org",
+			models.NrfNfDiscoveryNfService{Scheme: models.UriScheme_HTTPS, Fqdn: "svc.example.org", IpEndPoints: endpoint},
+			"https://svc.example.org:8000"},
+		{"FQDN without port: 443", "nrf.example.org",
+			models.NrfNfDiscoveryNfService{Scheme: models.UriScheme_HTTPS, IpEndPoints: noPort},
+			"https://nrf.example.org:443"},
+		{"API prefix as a path", "nrf.example.org",
+			models.NrfNfDiscoveryNfService{Scheme: models.UriScheme_HTTPS, IpEndPoints: endpoint, ApiPrefix: "/a/b"},
+			"https://nrf.example.org:8000/a/b"},
+		{"absolute apiPrefix left out with an FQDN", "nrf.example.org",
+			models.NrfNfDiscoveryNfService{
+				Scheme: models.UriScheme_HTTPS, IpEndPoints: endpoint, ApiPrefix: "https://nrf.example.org:8000",
+			},
+			"https://nrf.example.org:8000"},
+		{"absolute apiPrefix without an FQDN", "",
+			models.NrfNfDiscoveryNfService{
+				Scheme: models.UriScheme_HTTP, IpEndPoints: endpoint, ApiPrefix: "http://127.0.0.10:8000",
+			},
+			"http://127.0.0.10:8000"},
+		{"only the IP", "",
+			models.NrfNfDiscoveryNfService{Scheme: models.UriScheme_HTTP, IpEndPoints: endpoint},
+			"http://127.0.0.10:8000"},
+	}
+	for _, c := range cases {
