+func TestNotConfigured(t *testing.T) {
+	current.Store(nil)
+	if _, err := DialTLSContext(context.Background(), "tcp", "127.0.0.1:1", nil); !errors.Is(err, ErrNotConfigured) {
+		t.Errorf("error %v", err)
+	}
+	server := &http.Server{}
+	ConfigureServer(server)
+	if server.TLSConfig != nil {
+		t.Error("server configured without Init")
+	}
+}
+
+func TestInit(t *testing.T) {
+	l := newLab(t)
+	cert := l.ca.issue(t, leafOptions{id: serverId, crl: l.crl.URL + "/ca.crl", dns: testName, types: []string{"AMF"}})
+	saved := http.DefaultTransport.(*http.Transport).TLSClientConfig
+	defer func() {
+		http.DefaultTransport.(*http.Transport).TLSClientConfig = saved
+		current.Store(nil)
+	}()
+	if err := Init(Config{Certificate: cert.certFile, Key: cert.keyFile, CA: l.ca.file, NfInstanceId: serverId}); err != nil {
+		t.Fatal(err)
+	}
+	if Current() == nil {
+		t.Fatal("no current configuration")
+	}
+	if http.DefaultTransport.(*http.Transport).TLSClientConfig == nil {
+		t.Error("the default transport has no TLS configuration")
+	}
+	server := &http.Server{}
+	ConfigureServer(server)
+	if server.TLSConfig == nil || server.TLSConfig.ClientAuth != tls.RequireAndVerifyClientCert {
+		t.Error("server not configured")
+	}
+}
+
+func TestHandshakeLog(t *testing.T) {
+	var lines []string
+	log := handshakeLog{recorder(func(s string) { lines = append(lines, s) })}
+	_, _ = log.Write([]byte("http: TLS handshake error from 127.0.0.1:5000: tls: client didn't provide a certificate\n"))
+	_, _ = log.Write([]byte("other line\n"))
+	want := []string{"TLS handshake with 127.0.0.1:5000 refused: tls: client didn't provide a certificate", "other line"}
+	if fmt.Sprint(lines) != fmt.Sprint(want) {
+		t.Errorf("lines %q", lines)
+	}
+}
