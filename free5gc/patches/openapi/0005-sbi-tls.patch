+func TestMutualTLS(t *testing.T) {
+	l := newLab(t)
+	server := serve(t, l.context(t, serverId, 1), nil)
+	client := l.context(t, clientId, 2)
+	id, err := call(client, server.Listener.Addr().String(), testName)
+	if err != nil {
+		t.Fatal(err)
