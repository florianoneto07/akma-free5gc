+func TestServerName(t *testing.T) {
+	l := newLab(t)
+	var seen atomic.Value
+	server := serve(t, l.context(t, serverId, 1), &seen)
+	client := l.context(t, clientId, 2)
+	addr := server.Listener.Addr().String()
+
+	if _, err := call(client, addr, testName); err != nil {
+		t.Fatal(err)
