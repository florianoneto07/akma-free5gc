+func TestProfile(t *testing.T) {
+	l := newLab(t)
+	c := l.context(t, serverId, 1)
+	for name, cfg := range map[string]*tls.Config{"client": c.ClientTLSConfig(), "server": c.ServerTLSConfig()} {
+		if cfg.MinVersion != tls.VersionTLS12 {
+			t.Errorf("%s: minimum version %x", name, cfg.MinVersion)
+		}
+		for _, suite := range cfg.CipherSuites {
+			text := tls.CipherSuiteName(suite)
+			if !strings.Contains(text, "ECDHE") || !(strings.Contains(text, "GCM") || strings.Contains(text, "CHACHA20")) {
+				t.Errorf("%s: %s is not ECDHE with AEAD", name, text)
+			}
+		}
+		if len(cfg.CurvePreferences) != 3 {
+			t.Errorf("%s: groups %v", name, cfg.CurvePreferences)
+		}
+		if cfg.InsecureSkipVerify {
+			t.Errorf("%s: InsecureSkipVerify", name)
+		}
+	}
+	if c.ServerTLSConfig().ClientAuth != tls.RequireAndVerifyClientCert {
+		t.Error("the server does not require the client certificate")
+	}
+	for _, version := range []uint16{tls.VersionTLS12, tls.VersionTLS13} {
+		server := serve(t, c, nil)
+		cfg := l.context(t, clientId, 2).ClientTLSConfig()
+		cfg.MaxVersion = version
+		cfg.ServerName = testName
+		conn, err := tls.Dial("tcp", server.Listener.Addr().String(), cfg)
+		if err != nil {
+			t.Fatalf("version %x: %v", version, err)
+		}
+		if conn.ConnectionState().Version != version {
+			t.Errorf("version %x negotiated", conn.ConnectionState().Version)
+		}
+		_ = conn.Close()
+	}
+}
