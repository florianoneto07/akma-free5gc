+	if seen.Load() != testName {
+		t.Errorf("SNI %v, want %s", seen.Load(), testName)
+	}
+	host, _, err := net.SplitHostPort(addr)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err = call(client, addr, host); err != nil {
+		t.Fatal(err)
+	}
+	if seen.Load() != "" {
+		t.Errorf("SNI %v with an IP address", seen.Load())
+	}
+	if _, err = call(client, addr, "other.5gc.example.org"); err == nil {
+		t.Error("server with another name accepted")
+	}
+}
