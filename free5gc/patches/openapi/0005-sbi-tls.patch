+func TestRevocation(t *testing.T) {
+	l := newLab(t)
+	server := serve(t, l.context(t, serverId, 1), nil)
+	addr := server.Listener.Addr().String()
+	hour := time.Now().Add(time.Hour)
+	past := time.Now().Add(-time.Minute)
+
+	t.Run("revoked client", func(t *testing.T) {
+		l := newLab(t)
+		bad := l.ca.issue(t, leafOptions{serial: 7, id: clientId, crl: l.crl.URL + "/ca.crl", dns: testName})
+		l.crl.body.Store(l.ca.crl(t, past, hour, bad.cert))
+		server := serve(t, l.context(t, serverId, 1), nil)
+		client, err := New(Config{Certificate: bad.certFile, Key: bad.keyFile, CA: l.ca.file})
+		if err != nil {
+			t.Fatal(err)
+		}
+		if _, err = call(client, server.Listener.Addr().String(), testName); err == nil {
+			t.Error("revoked client accepted")
+		}
+	})
+
+	t.Run("revoked server", func(t *testing.T) {
+		l := newLab(t)
+		bad := l.ca.issue(t, leafOptions{serial: 8, id: serverId, crl: l.crl.URL + "/ca.crl", dns: testName})
+		srv, err := New(Config{Certificate: bad.certFile, Key: bad.keyFile, CA: l.ca.file})
+		if err != nil {
+			t.Fatal(err)
+		}
+		server := serve(t, srv, nil)
+		l.crl.body.Store(l.ca.crl(t, past, hour, bad.cert))
+		client := l.context(t, clientId, 2)
+		if _, err = call(client, server.Listener.Addr().String(), testName); err == nil {
+			t.Error("revoked server accepted")
+		}
+	})
+
+	t.Run("no distribution point", func(t *testing.T) {
+		cert := l.ca.issue(t, leafOptions{serial: 9, id: clientId, dns: testName})
+		client, err := New(Config{Certificate: cert.certFile, Key: cert.keyFile, CA: l.ca.file})
+		if err != nil {
+			t.Fatal(err)
+		}
+		if _, err = call(client, addr, testName); err == nil {
+			t.Error("client without a distribution point accepted")
+		}
+	})
+
+	badCrls := map[string]func(*testing.T, *lab) []byte{
+		"out of date": func(t *testing.T, l *lab) []byte {
+			return l.ca.crl(t, time.Now().Add(-2*time.Hour), time.Now().Add(-time.Hour))
+		},
+		"of another CA": func(t *testing.T, l *lab) []byte {
+			return newCA(t, "other").crl(t, past, hour)
+		},
+		"of another key": func(t *testing.T, l *lab) []byte {
+			return newCA(t, "CA").crl(t, past, hour)
+		},
+		"too large": func(t *testing.T, l *lab) []byte {
+			return make([]byte, crlMaxSize+1)
+		},
+		"not a CRL": func(t *testing.T, l *lab) []byte {
+			return []byte("not a CRL")
+		},
+	}
+	for name, bad := range badCrls {
+		t.Run(name, func(t *testing.T) {
+			l := newLab(t)
+			client := l.ca.issue(t, leafOptions{serial: 10, id: clientId, crl: l.crl.URL + "/ca.crl", dns: testName})
+			c, err := New(Config{Certificate: client.certFile, Key: client.keyFile, CA: l.ca.file})
+			if err != nil {
+				t.Fatal(err)
+			}
+			server := serve(t, l.context(t, serverId, 1), nil)
+			// The store of each end keeps the good CRL it fetched at start.
+			l.crl.body.Store(bad(t, l))
+			c.crls = newCrlStore(discard{})
+			if _, err = call(c, server.Listener.Addr().String(), testName); err == nil {
+				t.Error("handshake without a valid CRL accepted")
+			}
+		})
+	}
+
+	t.Run("not reachable", func(t *testing.T) {
+		l := newLab(t)
+		client := l.context(t, clientId, 2)
+		server := serve(t, l.context(t, serverId, 1), nil)
+		l.crl.Close()
+		client.crls = newCrlStore(discard{})
+		if _, err := call(client, server.Listener.Addr().String(), testName); err == nil {
+			t.Error("handshake without the CRL service accepted")
+		}
+	})
+
+	t.Run("after next update", func(t *testing.T) {
+		l := newLab(t)
+		l.crl.body.Store(l.ca.crl(t, past, time.Now().Add(1500*time.Millisecond)))
+		c := l.context(t, clientId, 2)
+		server := serve(t, l.context(t, serverId, 1), nil)
+		before := l.crl.hits.Load()
+		if _, err := call(c, server.Listener.Addr().String(), testName); err != nil {
+			t.Fatal(err)
+		}
+		time.Sleep(1600 * time.Millisecond)
+		l.crl.body.Store(l.ca.crl(t, past, hour))
+		if _, err := call(c, server.Listener.Addr().String(), testName); err != nil {
+			t.Fatal(err)
+		}
+		if l.crl.hits.Load() == before {
+			t.Error("the CRL was not fetched after its next update")
+		}
+	})
+}
