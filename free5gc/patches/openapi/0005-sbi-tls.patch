+	}
+	if _, err = call(client, server.Listener.Addr().String(), testName); err != nil {
+		t.Errorf("API invoker refused: %v", err)
+	}
+	if !<-seen {
+		t.Error("the certificate of an API invoker not recognized")
+	}
+	if _, err = call(l.context(t, clientId, 2), server.Listener.Addr().String(), testName); err != nil {
+		t.Errorf("NF refused: %v", err)
+	}
+	if <-seen {
+		t.Error("the certificate of an NF taken for an API invoker")
+	}
+	// With the CRL required, the same certificate has no distribution point.
+	strict, err := New(Config{Certificate: cert.certFile, Key: cert.keyFile, CA: l.ca.file, ExtraClientCA: invokers.file})
+	if err != nil {
+		t.Fatal(err)
+	}
+	strictServer := serve(t, strict, nil)
+	if _, err = call(client, strictServer.Listener.Addr().String(), testName); err == nil {
+		t.Error("API invoker without a distribution point accepted")
+	}
+}
