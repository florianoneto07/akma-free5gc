+	server.TLS = nef.ServerTLSConfig()
+	server.StartTLS()
+	defer server.Close()
+	invoker := invokers.issue(t, leafOptions{id: clientId})
+	pair, err := tls.LoadX509KeyPair(invoker.certFile, invoker.keyFile)
+	if err != nil {
