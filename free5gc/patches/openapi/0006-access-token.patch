+func TestWriteTokenError(t *testing.T) {
+	const realm = `Bearer realm="http://amf.example:8000/namf-comm/v1"`
+	cases := map[string]struct {
+		err       error
+		status    int
+		challenge string
+		cause     string
+		params    []string
+	}{
+		"no token":      {&TokenError{Status: 401, Reason: "x"}, 401, realm, "", nil},
+		"invalid":       {invalidToken("expired"), 401, realm + `, error="invalid_token"`, "", nil},
+		"another error": {errors.New("x"), 401, realm + `, error="invalid_token"`, "", nil},
+		"missing": {&TokenError{Status: 401, Code: errorInvalidToken, Cause: causeClaimMissing, Claims: []string{"sub"}},
+			401, realm + `, error="invalid_token"`, causeClaimMissing, []string{"sub"}},
+		"mismatch": {claimMismatch("aud"), 403, realm + `, error="invalid_token"`, causeClaimMismatch, []string{"aud"}},
+		"scope":    {InsufficientScope("namf-comm"), 403, realm + `, error="insufficient_scope", scope="namf-comm"`, "", nil},
+	}
+	for name, tc := range cases {
+		t.Run(name, func(t *testing.T) {
+			r := httptest.NewRequest(http.MethodPost, "http://amf.example:8000/namf-comm/v1/ue-contexts/x", nil)
+			w := httptest.NewRecorder()
+			WriteTokenError(w, r, tc.err)
+			if w.Code != tc.status {
+				t.Fatalf("status %d", w.Code)
+			}
+			if got := w.Header().Get("WWW-Authenticate"); got != tc.challenge {
+				t.Fatalf("challenge %s", got)
+			}
+			if got := w.Header().Get("Content-Type"); got != "application/problem+json" {
+				t.Fatalf("Content-Type %s", got)
+			}
+			var pd struct {
+				Status        int    `json:"status"`
+				Cause         string `json:"cause"`
+				InvalidParams []struct {
+					Param string `json:"param"`
+				} `json:"invalidParams"`
+			}
+			if err := json.Unmarshal(w.Body.Bytes(), &pd); err != nil {
+				t.Fatal(err)
+			}
+			var params []string
+			for _, p := range pd.InvalidParams {
+				params = append(params, p.Param)
+			}
+			if pd.Status != tc.status || pd.Cause != tc.cause || !reflect.DeepEqual(params, tc.params) {
+				t.Fatalf("problem %+v", pd)
+			}
+		})
+	}
+}
