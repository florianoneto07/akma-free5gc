+// VerifyTokenSigner checks the certificate that signs the access tokens of the
+// NRF: the chain to the CA of the operator, the validity and the CRL
+// (TS 33.310 cl. 6.3.1).
+func (c *Context) VerifyTokenSigner(cert *x509.Certificate) error {
+	chains, err := cert.Verify(x509.VerifyOptions{
+		Roots:     c.roots,
+		KeyUsages: []x509.ExtKeyUsage{x509.ExtKeyUsageAny},
+	})
+	if err != nil {
+		return err
+	}
+	return c.crls.check(cert, chains[0][1])
+}
