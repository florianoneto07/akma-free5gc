+func TestSigner(t *testing.T) {
+	l := newLab(t)
+	if l.signer.Issuer() != nrfId {
+		t.Fatalf("issuer %s", l.signer.Issuer())
+	}
+	raw := strings.TrimPrefix(sign(t, l.signer, claimsFor("AMF")), "Bearer ")
+	token, _, err := jwt.NewParser().ParseUnverified(raw, jwt.MapClaims{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if token.Header["alg"] != tokenAlg || token.Header["typ"] != "JWT" {
+		t.Fatalf("header %v", token.Header)
+	}
+	if token.Header["kid"] != l.signer.kid || token.Header["x5t#S256"] != l.signer.x5t {
+		t.Fatalf("header %v", token.Header)
+	}
+
+	nfFile, nfKey, _ := l.ca.issue(t, leafOptions{id: nrfId, nfType: "NRF", serial: 7})
+	if _, err = NewSigner(nfFile, nfKey); err == nil {
+		t.Fatal("a certificate without oauthAccessTokenSigning signs access tokens")
+	}
+}
