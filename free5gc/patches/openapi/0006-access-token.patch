+	"errors"
+	"math/big"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"os"
+	"path/filepath"
+	"reflect"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/golang-jwt/jwt/v5"
+
+	"github.com/free5gc/openapi/sbitls"
+)
+
+const (
+	nrfId    = "cdee1983-45ab-41a6-8f5b-6f832d5206e8"
+	amfId    = "63db01ad-fce2-4fde-8b78-3a62c60f3b8e"
+	clientId = "0383f793-0b51-4fc6-996e-a9a8bafc4ce1"
+	otherId  = "5a6d7127-edf7-4edc-960c-e4105ff023d8"
+	service  = "namf-comm"
+)
+
+var oidNfTypes = asn1.ObjectIdentifier{1, 3, 6, 1, 5, 5, 7, 1, 34}
+
+type authority struct {
+	cert *x509.Certificate
+	key  *ecdsa.PrivateKey
+	file string
+}
+
+type leafOptions struct {
+	id      string
+	nfType  string
+	serial  int64
+	signing bool
+	crlUri  string
+}
+
+func writePem(t *testing.T, file, kind string, der []byte) {
+	t.Helper()
+	if err := os.WriteFile(file, pem.EncodeToMemory(&pem.Block{Type: kind, Bytes: der}), 0o600); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func newAuthority(t *testing.T, name string) *authority {
+	t.Helper()
+	key, err := ecdsa.GenerateKey(elliptic.P384(), rand.Reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	template := &x509.Certificate{
+		SerialNumber: big.NewInt(1), Subject: pkix.Name{CommonName: name},
+		NotBefore: time.Now().Add(-time.Hour), NotAfter: time.Now().Add(time.Hour),
+		IsCA: true, BasicConstraintsValid: true, KeyUsage: x509.KeyUsageCertSign | x509.KeyUsageCRLSign,
+	}
+	der, err := x509.CreateCertificate(rand.Reader, template, template, &key.PublicKey, key)
+	if err != nil {
+		t.Fatal(err)
+	}
+	cert, err := x509.ParseCertificate(der)
+	if err != nil {
+		t.Fatal(err)
+	}
+	file := filepath.Join(t.TempDir(), "ca.pem")
+	writePem(t, file, "CERTIFICATE", der)
+	return &authority{cert: cert, key: key, file: file}
+}
+
+// issue returns the files of a certificate and its key.
+func (a *authority) issue(t *testing.T, o leafOptions) (certFile, keyFile string, cert *x509.Certificate) {
+	t.Helper()
+	key, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	uri, err := url.Parse("urn:uuid:" + o.id)
+	if err != nil {
+		t.Fatal(err)
+	}
+	template := &x509.Certificate{
+		SerialNumber: big.NewInt(o.serial), Subject: pkix.Name{CommonName: o.id},
+		NotBefore: time.Now().Add(-time.Hour), NotAfter: time.Now().Add(time.Hour),
+		KeyUsage: x509.KeyUsageDigitalSignature, URIs: []*url.URL{uri},
+	}
+	if o.crlUri != "" {
+		template.CRLDistributionPoints = []string{o.crlUri}
+	}
+	if o.signing {
+		template.UnknownExtKeyUsage = []asn1.ObjectIdentifier{{1, 3, 6, 1, 5, 5, 7, 3, 39}}
+	} else {
+		template.ExtKeyUsage = []x509.ExtKeyUsage{x509.ExtKeyUsageClientAuth, x509.ExtKeyUsageServerAuth}
+	}
+	if o.nfType != "" {
+		value, marshalErr := asn1.Marshal([]string{o.nfType})
+		if marshalErr != nil {
+			t.Fatal(marshalErr)
+		}
+		// IA5String, not the PrintableString of asn1.Marshal.
+		value[2] = asn1.TagIA5String
+		template.ExtraExtensions = []pkix.Extension{{Id: oidNfTypes, Value: value}}
+	}
+	der, err := x509.CreateCertificate(rand.Reader, template, a.cert, &key.PublicKey, a.key)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if cert, err = x509.ParseCertificate(der); err != nil {
+		t.Fatal(err)
+	}
+	dir := t.TempDir()
+	certFile, keyFile = filepath.Join(dir, "cert.pem"), filepath.Join(dir, "key.pem")
+	writePem(t, certFile, "CERTIFICATE", der)
+	pkcs8, err := x509.MarshalPKCS8PrivateKey(key)
+	if err != nil {
+		t.Fatal(err)
+	}
+	writePem(t, keyFile, "PRIVATE KEY", pkcs8)
+	return certFile, keyFile, cert
+}
+
+func (a *authority) crl(t *testing.T, revoked ...*x509.Certificate) []byte {
+	t.Helper()
+	template := &x509.RevocationList{
+		Number: big.NewInt(1), ThisUpdate: time.Now().Add(-time.Minute), NextUpdate: time.Now().Add(time.Hour),
+	}
+	for _, cert := range revoked {
+		template.RevokedCertificateEntries = append(template.RevokedCertificateEntries,
+			x509.RevocationListEntry{SerialNumber: cert.SerialNumber, RevocationTime: time.Now()})
+	}
+	der, err := x509.CreateRevocationList(rand.Reader, template, a.cert, a.key)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return der
+}
