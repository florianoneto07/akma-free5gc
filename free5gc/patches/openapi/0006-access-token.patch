diff --git a/oauth/signer.go b/oauth/signer.go
new file mode 100644
index 0000000..1a18605
--- /dev/null
+++ b/oauth/signer.go
@@ -0,0 +1,91 @@
+package oauth
+
+import (
+	"crypto/ecdsa"
+	"crypto/elliptic"
+	"crypto/sha256"
+	"crypto/tls"
+	"crypto/x509"
+	"encoding/base64"
+	"errors"
+	"fmt"
+
+	"github.com/golang-jwt/jwt/v5"
+
+	"github.com/free5gc/openapi/sbitls"
+)
+
+// Signer signs the access tokens of the NRF, with the JWS profile of
+// TS 33.210 cl. 6.3.3: ES256, "kid" and "x5t#S256".
+type Signer struct {
+	key    *ecdsa.PrivateKey
+	kid    string
+	x5t    string
+	issuer string
+}
+
+// NewSigner reads the key pair of the access tokens: a certificate with
+// id-kp-oauthAccessTokenSigning (TS 33.310 table 6.1.3c.3-2) and an ECDSA
+// P-256 key.
+func NewSigner(certPath, keyPath string) (*Signer, error) {
+	pair, err := tls.LoadX509KeyPair(certPath, keyPath)
+	if err != nil {
+		return nil, err
+	}
+	key, ok := pair.PrivateKey.(*ecdsa.PrivateKey)
+	if !ok || key.Curve != elliptic.P256() {
+		return nil, errors.New(keyPath + ": not an ECDSA P-256 key")
+	}
+	cert, err := x509.ParseCertificate(pair.Certificate[0])
+	if err != nil {
+		return nil, err
+	}
+	if !sbitls.SignsTokens(cert) {
+		return nil, errors.New(certPath + ": without id-kp-oauthAccessTokenSigning")
+	}
+	issuer, err := sbitls.NfInstanceId(cert)
+	if err != nil {
+		return nil, fmt.Errorf("%s: %w", certPath, err)
+	}
+	kid, err := keyThumbprint(&key.PublicKey)
+	if err != nil {
+		return nil, err
+	}
+	return &Signer{key: key, kid: kid, x5t: certThumbprint(cert), issuer: issuer}, nil
+}
+
+// Issuer returns the NF instance ID of the signing certificate: the "iss" of
+// the access tokens (TS 29.510 table 6.3.5.2.4-1).
+func (s *Signer) Issuer() string {
+	return s.issuer
+}
+
+// Sign returns claims as a JWS in compact serialization.
+func (s *Signer) Sign(claims jwt.Claims) (string, error) {
+	t := jwt.NewWithClaims(jwt.SigningMethodES256, claims)
+	t.Header["kid"] = s.kid
+	t.Header["x5t#S256"] = s.x5t
+	return t.SignedString(s.key)
+}
+
+// keyThumbprint returns the JWK thumbprint of a P-256 public key (RFC 7638
+// cl. 3): the base64url SHA-256 of its required members (RFC 7518 cl. 6.2.1)
+// in lexicographic order, without white space.
+func keyThumbprint(pub *ecdsa.PublicKey) (string, error) {
+	point, err := pub.Bytes()
+	if err != nil {
+		return "", err
+	}
+	// point is 0x04 || x || y, each coordinate in 32 octets.
+	enc := base64.RawURLEncoding
+	jwk := fmt.Sprintf(`{"crv":"P-256","kty":"EC","x":"%s","y":"%s"}`,
+		enc.EncodeToString(point[1:33]), enc.EncodeToString(point[33:65]))
+	sum := sha256.Sum256([]byte(jwk))
+	return enc.EncodeToString(sum[:]), nil
+}
+
+// certThumbprint is the "x5t#S256" of a certificate (RFC 7515 cl. 4.1.8).
+func certThumbprint(cert *x509.Certificate) string {
+	sum := sha256.Sum256(cert.Raw)
+	return base64.RawURLEncoding.EncodeToString(sum[:])
+}
diff --git a/oauth/verify.go b/oauth/verify.go
new file mode 100644
index 0000000..3fcc564
--- /dev/null
+++ b/oauth/verify.go
@@ -0,0 +1,362 @@
+package oauth
+
+import (
+	"crypto/ecdsa"
+	"crypto/elliptic"
+	"crypto/tls"
+	"crypto/x509"
+	"encoding/json"
+	"encoding/pem"
+	"errors"
+	"fmt"
+	"net/http"
+	"os"
+	"strings"
+	"time"
+
+	"github.com/golang-jwt/jwt/v5"
+
+	"github.com/free5gc/openapi/models"
+	"github.com/free5gc/openapi/sbitls"
+)
+
+// The checks of the NF Service Producer on an access token of the NRF
+// (TS 33.501 cl. 13.4.1.1.2; TS 29.500 cl. 6.7.3).
+
+// tokenAlg is the only JWS algorithm of the access tokens of the NRF
+// (TS 33.210 cl. 6.3.3.1).
+const tokenAlg = "ES256"
+
+// The application errors of TS 29.500 table 5.2.7.2-1.
+const (
+	causeClaimMissing  = "ACCESS_TOKEN_CLAIM_MISSING"
+	causeClaimMismatch = "ACCESS_TOKEN_CLAIM_MISMATCH"
+)
+
+// The "error" attributes of the challenge (RFC 6750 cl. 3.1).
+const (
+	errorInvalidToken      = "invalid_token"
+	errorInsufficientScope = "insufficient_scope"
+)
+
+// TokenError is the refusal of an access token, with what TS 29.500
+// cl. 6.7.3 asks of the answer.
+type TokenError struct {
+	Status int      // 401 or 403
+	Code   string   // "error" of the challenge; empty without a token
+	Scope  string   // "scope" of the challenge, with insufficient_scope
+	Cause  string   // cause of the ProblemDetails
+	Claims []string // the claims of invalidParams
+	Reason string   // for the log and for the detail of the ProblemDetails
+}
+
+func (e *TokenError) Error() string {
+	return e.Reason
+}
+
+func invalidToken(format string, args ...any) *TokenError {
+	return &TokenError{Status: http.StatusUnauthorized, Code: errorInvalidToken, Reason: fmt.Sprintf(format, args...)}
+}
+
+func claimMismatch(claim string) *TokenError {
+	return &TokenError{
+		Status: http.StatusForbidden, Code: errorInvalidToken, Cause: causeClaimMismatch,
+		Claims: []string{claim}, Reason: "access token claim " + claim + " does not match",
+	}
+}
+
+// InsufficientScope is the refusal of an access token without scope.
+func InsufficientScope(scope string) *TokenError {
+	return &TokenError{
+		Status: http.StatusForbidden, Code: errorInsufficientScope, Scope: scope,
+		Reason: "access token without the scope " + scope,
+	}
+}
+
+// Grant is what an accepted access token gives.
+type Grant struct {
+	Scopes []string
+}
+
+// Has reports whether the access token has a scope.
+func (g *Grant) Has(scope string) bool {
+	for _, s := range g.Scopes {
+		if s == scope {
+			return true
+		}
+	}
+	return false
+}
+
+// VerifyOAuth is Verify without the check of "sub": the routers of the NFs
+// follow it with CheckTokenPeer.
+func VerifyOAuth(authorization, serviceName, certPath string) error {
+	_, err := Verify(authorization, serviceName, certPath, nil)
+	return err
+}
+
+// Verify checks an "Authorization" header value, in this order: its form, the
+// signature with the certificate of the NRF in certPath, the claims present,
+// the expiry, the values of iss, aud and, with peer, sub, and the scope. The
+// error is a *TokenError. Without the TLS of the SBI, that is, in the test
+// bench of free5GC, there is no chain to check and no identity of this NF to
+// compare with aud.
+func Verify(authorization, serviceName, certPath string, peer *tls.ConnectionState) (*Grant, error) {
+	raw, err := bearer(authorization)
+	if err != nil {
+		return nil, err
+	}
+	cert, err := signingCertificate(certPath)
+	if err != nil {
+		return nil, invalidToken("certificate of the access tokens: %v", err)
+	}
+	claims := jwt.MapClaims{}
+	if _, err = jwt.NewParser(jwt.WithValidMethods([]string{tokenAlg}), jwt.WithoutClaimsValidation()).
+		ParseWithClaims(raw, claims, keyOf(cert)); err != nil {
+		return nil, invalidToken("access token signature: %v", err)
+	}
+	if missing := missingClaims(claims); len(missing) > 0 {
+		return nil, &TokenError{
+			Status: http.StatusUnauthorized, Code: errorInvalidToken, Cause: causeClaimMissing,
+			Claims: missing, Reason: "access token without " + strings.Join(missing, ", "),
+		}
+	}
+	// TS 33.501 cl. 13.4.1.1.2: without tolerance, both ends run NTP.
+	if exp, _ := claims["exp"].(float64); float64(time.Now().Unix()) >= exp {
+		return nil, invalidToken("access token expired")
+	}
+	if err = checkValues(claims, cert, peer); err != nil {
+		return nil, err
+	}
+	scope, _ := claims["scope"].(string)
+	grant := &Grant{Scopes: strings.Fields(scope)}
+	if serviceName != "" && !grant.Has(serviceName) {
+		return nil, InsufficientScope(serviceName)
+	}
+	return grant, nil
+}
+
+// bearer returns the access token of an "Authorization" header value
+// (RFC 6750 cl. 2.1).
+func bearer(authorization string) (string, error) {
+	if strings.TrimSpace(authorization) == "" {
+		return "", &TokenError{Status: http.StatusUnauthorized, Reason: "request without an access token"}
+	}
+	fields := strings.Fields(authorization)
+	if len(fields) != 2 || !strings.EqualFold(fields[0], "Bearer") {
+		return "", invalidToken("the Authorization header is not a Bearer token")
+	}
+	return fields[1], nil
+}
+
+// signingCertificate reads the certificate of the NRF that signs the access
+// tokens (TS 33.310 table 6.1.3c.3-2) and checks that it can do so.
+func signingCertificate(certPath string) (*x509.Certificate, error) {
+	data, err := os.ReadFile(certPath)
+	if err != nil {
+		return nil, err
+	}
+	block, _ := pem.Decode(data)
+	if block == nil {
+		return nil, errors.New(certPath + ": not PEM")
+	}
+	cert, err := x509.ParseCertificate(block.Bytes)
+	if err != nil {
+		return nil, err
+	}
+	if pub, ok := cert.PublicKey.(*ecdsa.PublicKey); !ok || pub.Curve != elliptic.P256() {
+		return nil, errors.New(certPath + ": not an ECDSA P-256 key")
+	}
+	if !sbitls.SignsTokens(cert) {
+		return nil, errors.New(certPath + ": without id-kp-oauthAccessTokenSigning")
+	}
+	if c := sbitls.Current(); c != nil {
+		if err = c.VerifyTokenSigner(cert); err != nil {
+			return nil, err
+		}
+	}
+	return cert, nil
+}
+
+// keyOf returns the key of the signature, after the header parameters that
+// name it (TS 33.210 cl. 6.3.3.1 and 6.3.3.4). A JWS with "crit" is refused:
+// no extension is understood here (RFC 7515 cl. 4.1.11).
+func keyOf(cert *x509.Certificate) jwt.Keyfunc {
+	return func(t *jwt.Token) (any, error) {
+		pub, _ := cert.PublicKey.(*ecdsa.PublicKey)
+		if _, ok := t.Header["crit"]; ok {
+			return nil, errors.New("crit is not supported")
+		}
+		if v, ok := t.Header["kid"]; ok {
+			kid, err := keyThumbprint(pub)
+			if err != nil {
+				return nil, err
+			}
+			if s, _ := v.(string); s != kid {
+				return nil, errors.New("unknown kid")
+			}
+		}
+		if v, ok := t.Header["x5t#S256"]; ok {
+			if s, _ := v.(string); s != certThumbprint(cert) {
+				return nil, errors.New("x5t#S256 of another certificate")
+			}
+		}
+		return pub, nil
+	}
+}
+
+// missingClaims returns the mandatory claims that the access token lacks
+// (TS 29.510 table 6.3.5.2.4-1), and those that are empty or of another type.
+func missingClaims(claims jwt.MapClaims) []string {
+	var missing []string
+	for _, name := range []string{"iss", "sub", "scope"} {
+		if s, _ := claims[name].(string); s == "" {
+			missing = append(missing, name)
+		}
+	}
+	if len(audiences(claims["aud"])) == 0 {
+		missing = append(missing, "aud")
+	}
+	if exp, _ := claims["exp"].(float64); exp == 0 {
+		missing = append(missing, "exp")
+	}
+	return missing
+}
+
+// audiences returns the "aud" claim: an NF type or a list of NF instance IDs
+// (TS 29.510 table 6.3.5.2.4-1).
+func audiences(aud any) []string {
+	switch a := aud.(type) {
+	case string:
+		if a != "" {
+			return []string{a}
+		}
+	case []any:
+		var list []string
+		for _, v := range a {
+			if s, ok := v.(string); ok && s != "" {
+				list = append(list, s)
+			}
+		}
+		return list
+	}
+	return nil
+}
+
+// checkValues compares the claims with the certificates: iss with the NF
+// instance ID of the signing certificate, aud with this NF and sub with the
+// client of the session.
+func checkValues(claims jwt.MapClaims, cert *x509.Certificate, peer *tls.ConnectionState) error {
+	id, err := sbitls.NfInstanceId(cert)
+	if err != nil {
+		return invalidToken("certificate of the access tokens: %v", err)
+	}
+	if iss, _ := claims["iss"].(string); !strings.EqualFold(iss, id) {
+		return claimMismatch("iss")
+	}
+	if c := sbitls.Current(); c != nil && !audienceMatches(audiences(claims["aud"]), c) {
+		return claimMismatch("aud")
+	}
+	sub, _ := claims["sub"].(string)
+	return checkSubject(sub, peer)
+}
+
+func audienceMatches(list []string, c *sbitls.Context) bool {
+	for _, aud := range list {
+		if strings.EqualFold(aud, c.NfInstanceId()) {
+			return true
+		}
+		for _, nfType := range c.NfTypes() {
+			if strings.EqualFold(aud, nfType) {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// checkSubject compares "sub" with the NF instance ID of the client
+// certificate: direct communication (TS 33.501 cl. 13.4.1.1.2). Without TLS,
+// there is nothing to compare.
+func checkSubject(sub string, peer *tls.ConnectionState) error {
+	cert := sbitls.PeerCertificate(peer)
+	if cert == nil {
+		return nil
+	}
+	if id, err := sbitls.NfInstanceId(cert); err != nil || !strings.EqualFold(id, sub) {
+		return claimMismatch("sub")
+	}
+	return nil
+}
+
+// CheckTokenPeer ties an access token already verified to the TLS client of
+// the request. Without a token or without TLS, there is nothing to check.
+func CheckTokenPeer(authorization string, peer *tls.ConnectionState) error {
+	if strings.TrimSpace(authorization) == "" || sbitls.PeerCertificate(peer) == nil {
+		return nil
+	}
+	raw, err := bearer(authorization)
+	if err != nil {
+		return err
+	}
+	claims := jwt.MapClaims{}
+	if _, _, err = jwt.NewParser().ParseUnverified(raw, claims); err != nil {
+		return invalidToken("access token: %v", err)
+	}
+	sub, _ := claims["sub"].(string)
+	return checkSubject(sub, peer)
+}
+
+// WriteTokenError answers a request that the check of the access token
+// refused (TS 29.500 cl. 6.7.3).
+func WriteTokenError(w http.ResponseWriter, r *http.Request, err error) {
+	var refusal *TokenError
+	if !errors.As(err, &refusal) {
+		refusal = invalidToken("%v", err)
+	}
+	problem := models.ProblemDetails{
+		Title:  http.StatusText(refusal.Status),
+		Status: int32(refusal.Status),
+		Detail: refusal.Reason,
+		Cause:  refusal.Cause,
+	}
+	for _, claim := range refusal.Claims {
+		problem.InvalidParams = append(problem.InvalidParams, models.InvalidParam{Param: claim})
+	}
+	body, jsonErr := json.Marshal(problem)
+	if jsonErr != nil {
+		http.Error(w, http.StatusText(http.StatusInternalServerError), http.StatusInternalServerError)
+		return
+	}
+	w.Header().Set("WWW-Authenticate", refusal.challenge(apiUri(r)))
+	w.Header().Set("Content-Type", "application/problem+json")
+	w.WriteHeader(refusal.Status)
+	_, _ = w.Write(body)
+}
+
+// challenge is the value of the WWW-Authenticate header.
+func (e *TokenError) challenge(realm string) string {
+	value := `Bearer realm="` + realm + `"`
+	if e.Code != "" {
+		value += `, error="` + e.Code + `"`
+	}
+	if e.Scope != "" {
+		value += `, scope="` + e.Scope + `"`
+	}
+	return value
+}
+
+// apiUri is the URI of the service of a request: "<apiRoot>/<apiName>/<apiVersion>"
+// (TS 29.501 cl. 4.4.1), for the realm of the challenge.
+func apiUri(r *http.Request) string {
+	scheme := "http"
+	if r.TLS != nil {
+		scheme = "https"
+	}
+	parts := strings.SplitN(strings.TrimPrefix(r.URL.Path, "/"), "/", 3)
+	if len(parts) > 2 {
+		parts = parts[:2]
+	}
+	uri := scheme + "://" + r.Host + "/" + strings.Join(parts, "/")
+	return strings.NewReplacer(`"`, "", `\`, "").Replace(uri)
+}
