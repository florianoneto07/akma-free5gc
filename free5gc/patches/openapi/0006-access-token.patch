+// Without the TLS of the SBI, as in the test bench of free5GC: this test runs
+// before any sbitls.Init of this package.
+func TestVerifyWithoutTls(t *testing.T) {
+	if sbitls.Current() != nil {
+		t.Fatal("this test has to run first")
+	}
+	ca := newAuthority(t, "CA")
+	certFile, keyFile, _ := ca.issue(t, leafOptions{id: nrfId, nfType: "NRF", serial: 2, signing: true})
+	signer, err := NewSigner(certFile, keyFile)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = VerifyOAuth(sign(t, signer, claimsFor("ANY")), service, certFile); err != nil {
+		t.Fatalf("access token refused: %v", err)
+	}
+	if err = CheckTokenPeer(sign(t, signer, claimsFor("ANY")), nil); err != nil {
+		t.Fatalf("no TLS, nothing to check: %v", err)
+	}
+	if err = CheckTokenPeer("", peerOf(ca.cert)); err != nil {
+		t.Fatalf("no token, nothing to check: %v", err)
+	}
+}
