+func TestVerifySignature(t *testing.T) {
+	l := newLab(t)
+	claims := claimsFor("AMF")
+	valid := sign(t, l.signer, claims)
+
+	rsaKey, err := rsa.GenerateKey(rand.Reader, 2048)
+	if err != nil {
+		t.Fatal(err)
+	}
+	rs512, err := jwt.NewWithClaims(jwt.SigningMethodRS512, claims).SignedString(rsaKey)
+	if err != nil {
+		t.Fatal(err)
+	}
+	none, err := jwt.NewWithClaims(jwt.SigningMethodNone, claims).SignedString(jwt.UnsafeAllowNoneSignatureType)
+	if err != nil {
+		t.Fatal(err)
+	}
+	otherKey, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	withHeader := func(name, value string) string {
+		token := jwt.NewWithClaims(jwt.SigningMethodES256, claims)
+		token.Header[name] = value
+		signed, signErr := token.SignedString(l.signer.key)
+		if signErr != nil {
+			t.Fatal(signErr)
+		}
+		return signed
+	}
+	otherSignature, err := jwt.NewWithClaims(jwt.SigningMethodES256, claims).SignedString(otherKey)
+	if err != nil {
+		t.Fatal(err)
+	}
+	mid := len(valid) - 2
+	replacement := "A"
+	if valid[mid] == 'A' {
+		replacement = "B"
+	}
+	for name, token := range map[string]string{
+		"RS512":          "Bearer " + rs512,
+		"none":           "Bearer " + none,
+		"another key":    "Bearer " + otherSignature,
+		"tampered":       valid[:mid] + replacement + valid[mid+1:],
+		"unknown kid":    "Bearer " + withHeader("kid", "unknown"),
+		"other x5t#S256": "Bearer " + withHeader("x5t#S256", "unknown"),
+		"crit":           "Bearer " + withHeader("crit", "exp"),
+	} {
+		t.Run(name, func(t *testing.T) {
+			_, err := Verify(token, service, l.certFile, nil)
+			wantRefusal(t, err, http.StatusUnauthorized, errorInvalidToken, "")
+		})
+	}
+}
