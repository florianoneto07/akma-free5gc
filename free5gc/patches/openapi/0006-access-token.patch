+func claimsFor(aud any) jwt.MapClaims {
+	return jwt.MapClaims{
+		"iss": nrfId, "sub": clientId, "aud": aud, "scope": service + " other",
+		"exp": time.Now().Add(time.Minute).Unix(),
+	}
+}
+
+func peerOf(cert *x509.Certificate) *tls.ConnectionState {
+	return &tls.ConnectionState{PeerCertificates: []*x509.Certificate{cert}}
+}
+
+func sign(t *testing.T, s *Signer, claims jwt.MapClaims) string {
+	t.Helper()
+	token, err := s.Sign(claims)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return "Bearer " + token
+}
+
+// wantRefusal checks a refusal of TS 29.500 cl. 6.7.3.
+func wantRefusal(t *testing.T, err error, status int, code, cause string, claims ...string) {
+	t.Helper()
+	var refusal *TokenError
+	if !errors.As(err, &refusal) {
+		t.Fatalf("error %v, want a TokenError", err)
+	}
+	if refusal.Status != status || refusal.Code != code || refusal.Cause != cause {
+		t.Fatalf("refusal %+v, want status %d, code %q, cause %q", refusal, status, code, cause)
+	}
+	if len(claims) > 0 && !reflect.DeepEqual(refusal.Claims, claims) {
+		t.Fatalf("claims %v, want %v", refusal.Claims, claims)
+	}
+}
