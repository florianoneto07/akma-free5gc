+type lab struct {
+	ca       *authority
+	certFile string
+	signer   *Signer
+	client   *x509.Certificate
+	revoked  string
+	revSign  *Signer
+}
+
+func newLab(t *testing.T) *lab {
+	t.Helper()
+	l := &lab{ca: newAuthority(t, "operator CA")}
+	var crl []byte
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		_, _ = w.Write(crl)
+	}))
+	t.Cleanup(server.Close)
+	uri := server.URL + "/ca.crl"
+
+	var keyFile string
+	var err error
+	l.certFile, keyFile, _ = l.ca.issue(t, leafOptions{id: nrfId, nfType: "NRF", serial: 2, signing: true, crlUri: uri})
+	if l.signer, err = NewSigner(l.certFile, keyFile); err != nil {
+		t.Fatal(err)
+	}
+	revokedKey := ""
+	var revoked *x509.Certificate
+	l.revoked, revokedKey, revoked = l.ca.issue(t, leafOptions{id: nrfId, nfType: "NRF", serial: 3, signing: true, crlUri: uri})
+	if l.revSign, err = NewSigner(l.revoked, revokedKey); err != nil {
+		t.Fatal(err)
+	}
+	crl = l.ca.crl(t, revoked)
+
+	nfCert, nfKey, _ := l.ca.issue(t, leafOptions{id: amfId, nfType: "AMF", serial: 4, crlUri: uri})
+	if err = sbitls.Init(sbitls.Config{Certificate: nfCert, Key: nfKey, CA: l.ca.file}); err != nil {
+		t.Fatal(err)
+	}
+	_, _, l.client = l.ca.issue(t, leafOptions{id: clientId, nfType: "SMF", serial: 5, crlUri: uri})
+	return l
+}
