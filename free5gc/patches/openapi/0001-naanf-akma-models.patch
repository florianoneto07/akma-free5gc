+/*
+ * Naanf_AKMA
+ *
+ * API for Naanf_AKMA.
+ *
+ * Source file: 3GPP TS 29.535 V19.5.0; 5G System; AKMA Anchor Services; Stage 3
+ * Url: https://www.3gpp.org/ftp/Specs/archive/29_series/29.535/
+ *
+ * API version: 1.2.0
+ */
+
+package models
+
+// CtxRemove indicates the AKMA context to be removed (TS 29.535 clause
+// 5.1.6.2.3). In this release only Supi identifies the context, and it shall
+// be included.
+type CtxRemove struct {
+	// SUPI of the UE, formatted as defined for type Supi in TS 29.571.
+	Supi string `json:"supi,omitempty" yaml:"supi" bson:"supi,omitempty"`
+}
