@@ -0,0 +1,31 @@
+/*
+ * 3gpp-akma
+ *
+ * API for AKMA.
+ *
+ * Source file: 3GPP TS 29.522 V19.7.0; 5G System; Network Exposure Function Northbound APIs
+ * Url: https://www.3gpp.org/ftp/Specs/archive/29_series/29.522/
+ *
+ * API version: 1.1.0
+ */
+
+package models
+
+import (
+	"time"
+)
+
+// AkmaAfKeyData represents AKMA Application Key information data (TS 29.522
+// clause 5.14.5.3.3), reused by Naanf_AKMA (TS 29.535).
+type AkmaAfKeyData struct {
+	// A string used to indicate the features supported by an API (TS 29.571).
+	SuppFeat string `json:"suppFeat,omitempty" yaml:"suppFeat" bson:"suppFeat,omitempty"`
+	// GPSI of the UE, formatted as defined for type Gpsi in TS 29.571.
+	Gpsi string `json:"gpsi,omitempty" yaml:"gpsi" bson:"gpsi,omitempty"`
+	// Expiration time of K_AF (DateTime of TS 29.122).
+	Expiry *time.Time `json:"expiry" yaml:"expiry" bson:"expiry,omitempty"`
+	// K_AF.
+	Kaf string `json:"kaf" yaml:"kaf" bson:"kaf,omitempty"`
+	// SUPI of the UE, formatted as defined for type Supi in TS 29.571.
+	Supi string `json:"supi,omitempty" yaml:"supi" bson:"supi,omitempty"`
+}
