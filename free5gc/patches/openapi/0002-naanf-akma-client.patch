+ *
+ * API version: 1.2.0
+ */
+
+package AKMA
+
+// APIClient manages communication with the Naanf_AKMA API v1.2.0
+// In most cases there should be only one, shared, APIClient.
+type APIClient struct {
+	cfg    *Configuration
+	common service // Reuse a single struct instead of allocating one for each service on the heap.
+
+	// API Services
+	RegisterTheAKMARelatedKeyMaterialApi               *RegisterTheAKMARelatedKeyMaterialApiService
+	RetrieveTheAKMAApplicationKeyMaterialCollectionApi *RetrieveTheAKMAApplicationKeyMaterialCollectionApiService
+	RemoveTheAKMAApplicationKeyMaterialDeletionApi     *RemoveTheAKMAApplicationKeyMaterialDeletionApiService
+}
+
+type service struct {
+	client *APIClient
+}
+
+// NewAPIClient creates a new API client.
+func NewAPIClient(cfg *Configuration) *APIClient {
+	c := &APIClient{}
+	c.cfg = cfg
+	c.common.client = c
+
+	// API Services
+	c.RegisterTheAKMARelatedKeyMaterialApi = (*RegisterTheAKMARelatedKeyMaterialApiService)(&c.common)
+	c.RetrieveTheAKMAApplicationKeyMaterialCollectionApi = (*RetrieveTheAKMAApplicationKeyMaterialCollectionApiService)(&c.common)
+	c.RemoveTheAKMAApplicationKeyMaterialDeletionApi = (*RemoveTheAKMAApplicationKeyMaterialDeletionApiService)(&c.common)
+
+	return c
+}
