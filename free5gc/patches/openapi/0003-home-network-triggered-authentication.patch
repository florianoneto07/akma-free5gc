+
+	body, resp, err := postJSON(ctx, a.client.cfg, uri, request.ReauthNotificationInfo)
+	if err != nil || resp == nil {
+		return nil, err
+	}
+
+	switch resp.StatusCode {
+	case 202:
+		localVarReturnValue.Pending = true
+		return &localVarReturnValue, nil
+	case 204:
+		return &localVarReturnValue, nil
+	}
+	if v, apiError, ok := decodeOperationError(body, resp, reauthNotificationErrorCodes); ok {
