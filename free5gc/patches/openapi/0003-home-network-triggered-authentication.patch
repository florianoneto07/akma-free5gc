+func (a *AMFRegistrationFor3GPPAccessApiService) Call3GppRegistrationReauthNotificationPost(ctx context.Context, uri string, request *Call3GppRegistrationReauthNotificationPostRequest) (*Call3GppRegistrationReauthNotificationPostResponse, error) {
