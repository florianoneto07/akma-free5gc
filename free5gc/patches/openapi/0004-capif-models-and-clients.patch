+ */
+
+package models
+
+// CapifServiceApiDescription represents the description of a service API as
+// published by the API publishing function (TS 29.222 clause 8.2.4.2.2). The
+// attributes apiStatus, pubApiPath and netSliceInfo, of optional features or
+// CCF interconnection, are not modelled.
+type CapifServiceApiDescription struct {
+	// The <apiName> of the API URI (TS 29.122 clause 5.2.4).
+	ApiName string `json:"apiName" yaml:"apiName" bson:"apiName,omitempty"`
+	// API identifier assigned by the CCF. Absent in the publication request.
+	ApiId       string            `json:"apiId,omitempty" yaml:"apiId" bson:"apiId,omitempty"`
+	AefProfiles []CapifAefProfile `json:"aefProfiles,omitempty" yaml:"aefProfiles" bson:"aefProfiles,omitempty"`
+	// Text description of the API.
+	Description string `json:"description,omitempty" yaml:"description" bson:"description,omitempty"`
+	// A string used to indicate the features supported by an API (TS 29.571).
+	SupportedFeatures  string                     `json:"supportedFeatures,omitempty" yaml:"supportedFeatures" bson:"supportedFeatures,omitempty"`
+	ShareableInfo      *CapifShareableInformation `json:"shareableInfo,omitempty" yaml:"shareableInfo" bson:"shareableInfo,omitempty"`
+	ServiceAPICategory string                     `json:"serviceAPICategory,omitempty" yaml:"serviceAPICategory" bson:"serviceAPICategory,omitempty"`
+	// Features supported by the service API itself (TS 29.571 SupportedFeatures).
+	ApiSuppFeats string `json:"apiSuppFeats,omitempty" yaml:"apiSuppFeats" bson:"apiSuppFeats,omitempty"`
+	// CCF to contact for the details of the service API (CAPIF-6/6e only).
+	CcfId       string `json:"ccfId,omitempty" yaml:"ccfId" bson:"ccfId,omitempty"`
+	ApiProvName string `json:"apiProvName,omitempty" yaml:"apiProvName" bson:"apiProvName,omitempty"`
+}
