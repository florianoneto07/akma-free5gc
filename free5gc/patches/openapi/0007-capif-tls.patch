+// CrlChecker checks the CRL of a TLS peer outside the SBI, such as the server
+// of CAPIF-1e, whose CA is not the one of the process.
+type CrlChecker struct {
+	crls *crlStore
+}
+
+// NewCrlChecker returns a checker with its own CRLs in memory.
+func NewCrlChecker(log Logger) *CrlChecker {
+	if log == nil {
+		log = discard{}
+	}
+	return &CrlChecker{crls: newCrlStore(log)}
+}
+
+// VerifyConnection is for tls.Config: it runs after crypto/tls has checked the
+// chain, in every handshake (TS 33.310 cl. 6.3.1).
+func (k *CrlChecker) VerifyConnection(state tls.ConnectionState) error {
+	if len(state.VerifiedChains) == 0 || len(state.VerifiedChains[0]) < 2 {
+		return errors.New("peer certificate without a verified chain")
+	}
+	return k.crls.check(state.VerifiedChains[0][0], state.VerifiedChains[0][1], 0)
+}
