+// A CRL of the extra CA with a maximum age: the revocation shows up before the
+// nextUpdate, and a failed fetch keeps the CRL in memory.
+func TestExtraClientCrlMaxAge(t *testing.T) {
+	l := newLab(t)
+	invokers := newCA(t, "invokers")
+	invokerCrl := newCrlServer(t, invokers.crl(t, time.Now().Add(-time.Minute), time.Now().Add(time.Hour)))
+	cert := l.ca.issue(t, leafOptions{serial: 1, id: serverId, crl: l.crl.URL + "/ca.crl", dns: testName})
+	nef, err := New(Config{Certificate: cert.certFile, Key: cert.keyFile, CA: l.ca.file,
+		ExtraClientCA: invokers.file, ExtraClientCrlMaxAge: 30 * time.Millisecond})
+	if err != nil {
+		t.Fatal(err)
+	}
+	server := serve(t, nef, nil)
+	invoker := invokers.issue(t, leafOptions{serial: 7, id: clientId, crl: invokerCrl.URL + "/invokers.crl"})
+	pair, err := tls.LoadX509KeyPair(invoker.certFile, invoker.keyFile)
+	if err != nil {
+		t.Fatal(err)
+	}
+	client, err := New(Config{KeyPair: &pair, CA: l.ca.file})
+	if err != nil {
+		t.Fatal(err)
+	}
+	addr := server.Listener.Addr().String()
+	if _, err = call(client, addr, testName); err != nil {
+		t.Fatalf("API invoker refused: %v", err)
+	}
+
+	invokerCrl.body.Store(invokers.crl(t, time.Now().Add(-time.Minute), time.Now().Add(time.Hour), invoker.cert))
+	time.Sleep(50 * time.Millisecond)
+	if _, err = call(client, addr, testName); err == nil {
+		t.Error("revoked API invoker accepted after the maximum age of the CRL")
+	}
+
+	// A CRL that cannot be fetched again: the one in memory, with the
+	// revocation, still counts until its nextUpdate.
+	invokerCrl.Close()
+	time.Sleep(50 * time.Millisecond)
+	if _, err = call(client, addr, testName); err == nil {
+		t.Error("revoked API invoker accepted with the CRL service down")
+	}
+}
