+func TestCrlChecker(t *testing.T) {
+	l := newLab(t)
+	cert := l.ca.issue(t, leafOptions{serial: 1, id: serverId, crl: l.crl.URL + "/ca.crl", dns: testName})
+	state := func(leaf *x509.Certificate) tls.ConnectionState {
+		return tls.ConnectionState{VerifiedChains: [][]*x509.Certificate{{leaf, l.ca.cert}}}
+	}
+	checker := NewCrlChecker(nil)
+	if err := checker.VerifyConnection(state(cert.cert)); err != nil {
+		t.Errorf("valid certificate refused: %v", err)
+	}
+	if err := checker.VerifyConnection(tls.ConnectionState{}); err == nil {
+		t.Error("a connection without a verified chain accepted")
+	}
+	noPoint := l.ca.issue(t, leafOptions{serial: 2, id: serverId, dns: testName})
+	if err := checker.VerifyConnection(state(noPoint.cert)); err == nil {
+		t.Error("a certificate without a distribution point accepted")
+	}
+	l.crl.body.Store(l.ca.crl(t, time.Now().Add(-time.Minute), time.Now().Add(time.Hour), cert.cert))
+	if err := NewCrlChecker(nil).VerifyConnection(state(cert.cert)); err == nil {
+		t.Error("a revoked certificate accepted")
+	}
+}
