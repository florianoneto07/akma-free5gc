+ * Url: https://www.3gpp.org/ftp/Specs/archive/29_series/29.510/
+ */
+
+package models
+
+// RetrieveKeyRsp contains the key used to validate an OAuth 2.0 access token
+// (TS 29.510 table 6.3.5.2.8-1). At least one attribute is present.
+type RetrieveKeyRsp struct {
+	// Base64 encoded raw public key.
+	RawPubKey string `json:"rawPubKey,omitempty" yaml:"rawPubKey" bson:"rawPubKey,omitempty"`
+	// Reference to the binary body part with the X.509 certificate, ASN.1 DER
+	// encoded (cl. 6.3.5.5.2).
+	X509Cert *RefToBinaryData `json:"x509Cert,omitempty" yaml:"x509Cert" bson:"x509Cert,omitempty"`
+	// Reference to the binary body part with the certificate chain, in CMS
+	// with ASN.1 DER encoding (cl. 6.3.5.5.3).
+	CertChain *RefToBinaryData `json:"certChain,omitempty" yaml:"certChain" bson:"certChain,omitempty"`
+}
