+/*
+ * NRF OAuth2
+ *
+ * NRF OAuth2 Authorization.
+ *
+ * Source file: 3GPP TS 29.510 V20.1.0; 5G System; Network Function Repository Services; Stage 3
+ * Url: https://www.3gpp.org/ftp/Specs/archive/29_series/29.510/
+ */
+
+package models
+
+// RetrieveKeyReq contains the information to identify the key used to
+// validate an OAuth 2.0 access token (TS 29.510 table 6.3.5.2.7-1).
+type RetrieveKeyReq struct {
+	// NF instance ID of the issuer of the access token being verified.
+	Issuer string `json:"issuer" yaml:"issuer" bson:"issuer,omitempty"`
+	// Header parameters identifying the key used to validate the signature of
+	// the access token; the keys of the map are the names of the header
+	// parameters (TS 33.210 cl. 6.3.3).
+	HeaderParameters map[string]string `json:"headerParameters" yaml:"headerParameters" bson:"headerParameters,omitempty"`
+}
