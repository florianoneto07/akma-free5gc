+// Certificate returns the certificate that validates the signature of the
+// access tokens, for the Retrieve Key Request (TS 29.510 cl. 5.4.2.3).
+func (s *Signer) Certificate() *x509.Certificate {
+	return s.cert
+}
+
+// Identifies tells whether the header parameters of an access token identify
+// the key of this signer (TS 29.510 table 6.3.5.2.7-1, headerParameters):
+// "kid" and "x5t#S256" (TS 33.210 cl. 6.3.3.1 and 6.3.3.4) identify it when
+// each one present is equal to the one this signer puts in the tokens, and at
+// least one is present; "alg", when present, has to be ES256. Any other
+// header parameter does not identify a key of this signer.
+func (s *Signer) Identifies(params map[string]string) bool {
+	identified := false
+	for name, value := range params {
+		switch name {
+		case "kid":
+			if value != s.kid {
+				return false
+			}
+			identified = true
+		case "x5t#S256":
+			if value != s.x5t {
+				return false
+			}
+			identified = true
+		case "alg":
+			if value != jwt.SigningMethodES256.Alg() {
+				return false
+			}
+		default:
+			return false
+		}
+	}
+	return identified
+}
