+// With the default Routing Indicator, "0" (TS 23.003
+// cl. 2.2B), the search goes without it and any AAnF will do (TS 33.535
+// cl. 6.7).
+func TestRegisterAkmaDefaultRid(t *testing.T) {
+	rec := &recorder{}
+	aanf := fakeAanf(t, rec)
+	nrf := fakeNrf(t, rec, aanf)
+	setAusfAkma(t, true, nrf.URL, "")
+
+	p := newTestProcessor(t)
+	p.registerAkma(akmaRequest{supi: vecSupi, supiOrSuci: vecSuci, kausf: vecKausf, routingId: "0"}, testPlmns)
+
+	require.Len(t, rec.queries, 1)
+	require.NotContains(t, rec.queries[0], "routing-indicator")
+	require.Contains(t, rec.queries[0], "target-nf-type=AANF")
+	require.Len(t, rec.requests, 1)
+}
+
+// The result of the search is reused during its validity
+// period (TS 29.510 cl. 5.3.2.2.1), for the same Routing Indicator only.
+func TestRegisterAkmaReusesSearch(t *testing.T) {
+	rec := &recorder{}
+	aanf := fakeAanf(t, rec)
+	nrf := fakeNrf(t, rec, aanf)
+	setAusfAkma(t, true, nrf.URL, "")
+
+	p := newTestProcessor(t)
+	req := akmaRequest{supi: vecSupi, supiOrSuci: vecSuci, kausf: vecKausf, routingId: "0000"}
+	p.registerAkma(req, testPlmns)
+	p.registerAkma(req, testPlmns)
+	require.Len(t, rec.queries, 1, "the second registration reuses the search")
+	require.Len(t, rec.requests, 2)
+
+	req.routingId = "0"
+	p.registerAkma(req, testPlmns)
+	require.Len(t, rec.queries, 2, "another Routing Indicator, another search")
+}
+
