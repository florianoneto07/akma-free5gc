+package consumer
+
+import (
+	"context"
+	"sync"
+
+	"github.com/pkg/errors"
+
+	ausf_context "github.com/free5gc/ausf/internal/context"
+	"github.com/free5gc/ausf/internal/logger"
+	"github.com/free5gc/openapi"
+	Naanf_AKMA "github.com/free5gc/openapi/aanf/AKMA"
+	"github.com/free5gc/openapi/models"
+	Nnrf_NFDiscovery "github.com/free5gc/openapi/nrf/NFDiscovery"
+)
+
+type naanfService struct {
+	consumer *Consumer
+
+	mu      sync.RWMutex
+	clients map[string]*Naanf_AKMA.APIClient
+}
+
+func (s *naanfService) getClient(uri string) *Naanf_AKMA.APIClient {
+	s.mu.RLock()
+	client, ok := s.clients[uri]
+	s.mu.RUnlock()
+	if ok {
+		return client
+	}
+	cfg := Naanf_AKMA.NewConfiguration()
+	cfg.SetBasePath(uri)
+	client = Naanf_AKMA.NewAPIClient(cfg)
+
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.clients[uri] = client
+	return client
+}
+
+// RegisterAKMAKey sends Naanf_AKMA_AnchorKey_Register to the AAnF that
+// serves the Routing Indicator rid (TS 29.535 cl. 4.2.2.2.2).
+func (s *naanfService) RegisterAKMAKey(ctx context.Context, rid string, info models.AkmaKeyInfo) error {
+	uri, err := s.aanfUri(rid)
+	if err != nil {
+		return err
+	}
+	tokenCtx, _, err := ausf_context.GetSelf().GetTokenCtx(models.ServiceName_NAANF_AKMA,
+		models.NrfNfManagementNfType_AANF)
+	if err != nil {
+		return errors.Wrap(err, "access token for naanf-akma")
+	}
+	if tok := tokenCtx.Value(openapi.ContextOAuth2); tok != nil {
+		ctx = context.WithValue(ctx, openapi.ContextOAuth2, tok)
+	}
+
+	req := &Naanf_AKMA.RegisterAKMAKeyRequest{}
+	req.SetAkmaKeyInfo(info)
+	_, err = s.getClient(uri).RegisterTheAKMARelatedKeyMaterialApi.RegisterAKMAKey(ctx, req)
+	return err
+}
+
+// aanfUri returns the configured AAnF apiRoot or, when none is configured,
+// discovers an AAnF at the NRF with the Routing Indicator (TS 33.535 cl. 6.7;
+// TS 29.510 table 6.2.3.2.3.1-1).
+func (s *naanfService) aanfUri(rid string) (string, error) {
+	self := ausf_context.GetSelf()
+	if self.AkmaAanfUri != "" {
+		logger.AkmaLog.Infof("AAnF for Routing Indicator %s: %s (configured)", rid, self.AkmaAanfUri)
+		return self.AkmaAanfUri, nil
+	}
+	target := models.NrfNfManagementNfType_AANF
+	requester := models.NrfNfManagementNfType_AUSF
+	param := Nnrf_NFDiscovery.SearchNFInstancesRequest{
+		TargetNfType:     &target,
+		RequesterNfType:  &requester,
+		ServiceNames:     []models.ServiceName{models.ServiceName_NAANF_AKMA},
+		RoutingIndicator: &rid,
+	}
+	res, err := s.consumer.SendSearchNFInstances(self.NrfUri, target, requester, param)
+	if err != nil {
+		return "", errors.Wrap(err, "AAnF discovery")
+	}
+	_, uri, err := openapi.GetServiceNfProfileAndUri(res.NfInstances, models.ServiceName_NAANF_AKMA)
+	if err != nil {
+		return "", errors.Wrap(err, "AAnF discovery")
+	}
+	logger.AkmaLog.Infof("AAnF for Routing Indicator %s: %s (discovered at the NRF)", rid, uri)
+	return uri, nil
+}
