@@ -0,0 +1,261 @@
+package processor
+
+import (
+	"encoding/json"
+	"io"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"strconv"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+	"golang.org/x/net/http2"
+	"golang.org/x/net/http2/h2c"
+
+	ausf_context "github.com/free5gc/ausf/internal/context"
+	"github.com/free5gc/ausf/internal/sbi/consumer"
+	"github.com/free5gc/ausf/pkg/factory"
+	"github.com/free5gc/openapi/models"
+)
+
+// Vector "testbed-ue" of the KDF oracle
+// (shared/akma/testdata/vectors.json in akma-free5gc).
+const (
+	vecKausf = "141ef548f86e3a2a1ad949331caa9e6bb12401afa321bde4f9f23b84870dd654"
+	vecSupi  = "imsi-208930000000001"
+	vecSuci  = "suci-0-208-93-0000-0-0-0000000001"
+	vecKakma = "84ea5c330a41f071642fe603a4b9254bb7ef42e86aaa11a15f459ba0b705074a"
+	vecAKID  = "rid0000.atidiz1FN8DkMGyxwtfTVYsKUsWnzOJdBOLlQEiQlK2gHNA=@5gc.mnc093.mcc208.3gppnetwork.org"
+)
+
+var testPlmns = []models.PlmnId{{Mcc: "208", Mnc: "93"}, {Mcc: "123", Mnc: "45"}}
+
+func TestBuildAkmaKeyInfoMatchesOracle(t *testing.T) {
+	for _, supiOrSuci := range []string{vecSuci, vecSupi} {
+		t.Run(supiOrSuci, func(t *testing.T) {
+			info, err := buildAkmaKeyInfo(akmaRequest{
+				supi: vecSupi, supiOrSuci: supiOrSuci, kausf: vecKausf, routingId: "0000",
+			}, testPlmns)
+			require.NoError(t, err)
+			// "supi" keeps the SBI form; the KDF uses the IMSI digits.
+			require.Equal(t, vecSupi, info.Supi)
+			require.Equal(t, vecAKID, info.AKId)
+			require.Equal(t, vecKakma, info.KAkma)
+			require.Empty(t, info.Gpsi)
+		})
+	}
+}
+
+func TestBuildAkmaKeyInfoErrors(t *testing.T) {
+	cases := map[string]struct {
+		req   akmaRequest
+		plmns []models.PlmnId
+	}{
+		"NAI (IMSI only)": {akmaRequest{supi: "nai-user@example.com", supiOrSuci: vecSuci, kausf: vecKausf, routingId: "0000"}, testPlmns},
+		"K_AUSF not hex":  {akmaRequest{supi: vecSupi, supiOrSuci: vecSuci, kausf: "zz", routingId: "0000"}, testPlmns},
+		"no routingId":    {akmaRequest{supi: vecSupi, supiOrSuci: vecSuci, kausf: vecKausf}, testPlmns},
+		"RID of 5 digits": {akmaRequest{supi: vecSupi, supiOrSuci: vecSuci, kausf: vecKausf, routingId: "00000"}, testPlmns},
+		"SUPI, no PLMN":   {akmaRequest{supi: vecSupi, supiOrSuci: vecSupi, kausf: vecKausf, routingId: "0000"}, nil},
+		"SUPI, two PLMNs": {akmaRequest{supi: vecSupi, supiOrSuci: vecSupi, kausf: vecKausf, routingId: "0000"},
+			[]models.PlmnId{{Mcc: "208", Mnc: "93"}, {Mcc: "208", Mnc: "930"}}},
+	}
+	for name, c := range cases {
+		t.Run(name, func(t *testing.T) {
+			_, err := buildAkmaKeyInfo(c.req, c.plmns)
+			require.Error(t, err)
+		})
+	}
+}
+
+// The MNC of the realm comes from the SUCI, with its length, not from the IMSI.
+func TestHomeNetworkFromSuci(t *testing.T) {
+	hn, err := homeNetwork("suci-0-001-001-0-0-0-0000000001", "001001000000001", nil)
+	require.NoError(t, err)
+	require.Equal(t, "5gc.mnc001.mcc001.3gppnetwork.org", hn.Domain())
+	hn, err = homeNetwork("suci-0-310-410-0-0-0-0000000001", "310410000000001", nil)
+	require.NoError(t, err)
+	require.Equal(t, "5gc.mnc410.mcc310.3gppnetwork.org", hn.Domain())
+}
+
+// fakeApp is the AUSF application seen by the processor.
+type fakeApp struct {
+	consumer *consumer.Consumer
+}
+
+func (a *fakeApp) SetLogEnable(bool)                  {}
+func (a *fakeApp) SetLogLevel(string)                 {}
+func (a *fakeApp) SetReportCaller(bool)               {}
+func (a *fakeApp) Start()                             {}
+func (a *fakeApp) Terminate()                         {}
+func (a *fakeApp) Context() *ausf_context.AUSFContext { return ausf_context.GetSelf() }
+func (a *fakeApp) Config() *factory.Config            { return &factory.Config{} }
+func (a *fakeApp) Consumer() *consumer.Consumer       { return a.consumer }
+
+type recorder struct {
+	mu       sync.Mutex
+	queries  []string
+	requests []models.AkmaKeyInfo
+	paths    []string
+}
+
+func h2cServer(t *testing.T, h http.Handler) *httptest.Server {
+	t.Helper()
+	ts := httptest.NewServer(h2c.NewHandler(h, &http2.Server{}))
+	t.Cleanup(ts.Close)
+	return ts
+}
+
+// fakeAanf answers register-anchorkey with 200 and the AkmaKeyInfo received.
+func fakeAanf(t *testing.T, rec *recorder) *httptest.Server {
+	return h2cServer(t, http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		body, _ := io.ReadAll(r.Body)
+		var info models.AkmaKeyInfo
+		_ = json.Unmarshal(body, &info)
+		rec.mu.Lock()
+		rec.paths = append(rec.paths, r.Method+" "+r.URL.Path)
+		rec.requests = append(rec.requests, info)
+		rec.mu.Unlock()
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = w.Write(body)
+	}))
+}
+
+// fakeNrf answers the discovery of AANF with the profile of aanf.
+func fakeNrf(t *testing.T, rec *recorder, aanf *httptest.Server) *httptest.Server {
+	host, portStr, err := net.SplitHostPort(aanf.Listener.Addr().String())
+	require.NoError(t, err)
+	port, _ := strconv.Atoi(portStr)
+	result := models.SearchResult{NfInstances: []models.NrfNfDiscoveryNfProfile{{
+		NfInstanceId: "b6f417f0-06fa-4c38-b291-33066f5a5fe7",
+		NfType:       models.NrfNfManagementNfType_AANF,
+		NfStatus:     models.NrfNfManagementNfStatus_REGISTERED,
+		NfServices: []models.NrfNfDiscoveryNfService{{
+			ServiceInstanceId: "b6f417f0-06fa-4c38-b291-33066f5a5fe7",
+			ServiceName:       models.ServiceName_NAANF_AKMA,
+			Versions:          []models.NfServiceVersion{{ApiVersionInUri: "v1", ApiFullVersion: "1.2.0"}},
+			Scheme:            models.UriScheme_HTTP,
+			NfServiceStatus:   models.NfServiceStatus_REGISTERED,
+			IpEndPoints:       []models.IpEndPoint{{Ipv4Address: host, Port: int32(port)}},
+		}},
+	}}}
+	return h2cServer(t, http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		rec.mu.Lock()
+		rec.queries = append(rec.queries, r.URL.RawQuery)
+		rec.mu.Unlock()
+		w.Header().Set("Content-Type", "application/json")
+		_ = json.NewEncoder(w).Encode(result)
+	}))
+}
+
+func newTestProcessor(t *testing.T) *Processor {
+	t.Helper()
+	app := &fakeApp{}
+	c, err := consumer.NewConsumer(app)
+	require.NoError(t, err)
+	app.consumer = c
+	p, err := NewProcessor(app)
+	require.NoError(t, err)
+	return p
+}
+
+func setAusfAkma(t *testing.T, enable bool, nrfUri, aanfUri string) {
+	self := ausf_context.GetSelf()
+	enable0, aanf0, nrf0, oauth0, plmns0 := self.AkmaEnable, self.AkmaAanfUri, self.NrfUri, self.OAuth2Required,
+		self.PlmnList
+	t.Cleanup(func() {
+		self.AkmaEnable, self.AkmaAanfUri, self.NrfUri, self.OAuth2Required, self.PlmnList = enable0, aanf0, nrf0,
+			oauth0, plmns0
+	})
+	self.AkmaEnable, self.AkmaAanfUri, self.NrfUri = enable, aanfUri, nrfUri
+	self.OAuth2Required = false
+	self.PlmnList = testPlmns
+}
+
+// TS 33.535 cl. 6.7: the AUSF discovers the AAnF at the NRF with the Routing
+// Indicator received from the UDM, then registers the key material.
+func TestRegisterAkmaDiscoversAanf(t *testing.T) {
+	rec := &recorder{}
+	aanf := fakeAanf(t, rec)
+	nrf := fakeNrf(t, rec, aanf)
+	setAusfAkma(t, true, nrf.URL, "")
+
+	p := newTestProcessor(t)
+	p.registerAkma(akmaRequest{supi: vecSupi, supiOrSuci: vecSuci, kausf: vecKausf, routingId: "0000"}, testPlmns)
+
+	require.Len(t, rec.queries, 1)
+	q := rec.queries[0]
+	require.Contains(t, q, "target-nf-type=AANF")
+	require.Contains(t, q, "requester-nf-type=AUSF")
+	require.Contains(t, q, "routing-indicator=0000")
+	require.Contains(t, q, "service-names=naanf-akma")
+	require.Equal(t, []string{"POST /naanf-akma/v1/register-anchorkey"}, rec.paths)
+	require.Equal(t, models.AkmaKeyInfo{Supi: vecSupi, AKId: vecAKID, KAkma: vecKakma}, rec.requests[0])
+}
+
+// With akma.aanfUri configured, the NRF is not asked.
+func TestRegisterAkmaConfiguredUri(t *testing.T) {
+	rec := &recorder{}
+	aanf := fakeAanf(t, rec)
+	setAusfAkma(t, true, "http://127.0.0.1:1", aanf.URL)
+
+	p := newTestProcessor(t)
+	p.registerAkma(akmaRequest{supi: vecSupi, supiOrSuci: vecSuci, kausf: vecKausf, routingId: "0000"}, testPlmns)
+
+	require.Empty(t, rec.queries)
+	require.Len(t, rec.requests, 1)
+}
+
+// startAkma does nothing without the AKMA indication or with AKMA disabled.
+func TestStartAkmaConditions(t *testing.T) {
+	rec := &recorder{}
+	aanf := fakeAanf(t, rec)
+	ue := &ausf_context.AusfUeContext{
+		Supi: vecSupi, SupiOrSuci: vecSuci, Kausf: vecKausf, RoutingId: "0000",
+	}
+	p := newTestProcessor(t)
+
+	setAusfAkma(t, true, "", aanf.URL)
+	ue.AkmaInd = false
+	p.startAkma(ue)
+
+	setAusfAkma(t, false, "", aanf.URL)
+	ue.AkmaInd = true
+	p.startAkma(ue)
+
+	time.Sleep(200 * time.Millisecond)
+	rec.mu.Lock()
+	defer rec.mu.Unlock()
+	require.Empty(t, rec.requests)
+}
+
+// startAkma returns at once; the registration runs apart (TS 33.535 cl. 6.1).
+func TestStartAkmaDoesNotBlock(t *testing.T) {
+	received := make(chan struct{}, 1)
+	block := make(chan struct{})
+	done := make(chan struct{})
+	slow := h2cServer(t, http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		received <- struct{}{}
+		<-block
+		w.WriteHeader(http.StatusServiceUnavailable)
+		close(done)
+	}))
+	setAusfAkma(t, true, "", slow.URL)
+
+	p := newTestProcessor(t)
+	ue := &ausf_context.AusfUeContext{
+		Supi: vecSupi, SupiOrSuci: vecSuci, Kausf: vecKausf, RoutingId: "0000", AkmaInd: true,
+	}
+	start := time.Now()
+	p.startAkma(ue)
+	require.Less(t, time.Since(start), 100*time.Millisecond)
+
+	// Let the background registration end before the configuration is
+	// restored.
+	<-received
+	close(block)
+	<-done
+	time.Sleep(100 * time.Millisecond)
+}
