diff --git a/internal/sbi/processor/akma.go b/internal/sbi/processor/akma.go
new file mode 100644
index 0000000..d7539ef
--- /dev/null
+++ b/internal/sbi/processor/akma.go
@@ -0,0 +1,127 @@
+package processor
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"strings"
+	"time"
+
+	"github.com/florianoneto07/akma-free5gc/shared/akma/akid"
+	"github.com/florianoneto07/akma-free5gc/shared/akma/codec"
+	"github.com/florianoneto07/akma-free5gc/shared/akma/derive"
+	"github.com/florianoneto07/akma-free5gc/shared/akma/supi"
+
+	ausf_context "github.com/free5gc/ausf/internal/context"
+	"github.com/free5gc/ausf/internal/logger"
+	"github.com/free5gc/openapi/models"
+)
+
+// akmaRegisterTimeout bounds the AnchorKey_Register of one UE, discovery
+// included.
+const akmaRegisterTimeout = 10 * time.Second
+
+// akmaRequest is what the AKMA procedure needs, copied from the UE context
+// when the primary authentication completes.
+type akmaRequest struct {
+	supi       string // SBI form, "imsi-..."
+	supiOrSuci string
+	kausf      string // hexadecimal
+	routingId  string
+}
+
+// startAkma starts the AKMA key generation and registration of TS 33.535
+// cl. 6.1 steps 3-5 when the UDM sent the AKMA indication. It runs apart
+// from the authentication: the response to the AMF is neither delayed nor
+// changed by the AAnF (TS 33.535 cl. 6.1: AKMA follows the authentication).
+func (p *Processor) startAkma(ue *ausf_context.AusfUeContext) {
+	if !ue.AkmaInd {
+		return
+	}
+	self := ausf_context.GetSelf()
+	if !self.AkmaEnable {
+		logger.AkmaLog.Infof("AKMA indication for %s ignored: akma.enable is false", ue.Supi)
+		return
+	}
+	req := akmaRequest{supi: ue.Supi, supiOrSuci: ue.SupiOrSuci, kausf: ue.Kausf, routingId: ue.RoutingId}
+	plmns := append([]models.PlmnId(nil), self.PlmnList...)
+	go p.registerAkma(req, plmns)
+}
+
+func (p *Processor) registerAkma(req akmaRequest, plmns []models.PlmnId) {
+	info, err := buildAkmaKeyInfo(req, plmns)
+	if err != nil {
+		logger.AkmaLog.Errorf("AKMA key material for %s not generated: %v", req.supi, err)
+		return
+	}
+	logger.AkmaLog.Infof("K_AKMA and A-KID derived for %s: A-KID %s", req.supi, info.AKId)
+	ctx, cancel := context.WithTimeout(context.Background(), akmaRegisterTimeout)
+	defer cancel()
+	if err := p.Consumer().RegisterAKMAKey(ctx, req.routingId, info); err != nil {
+		logger.AkmaLog.Errorf("Naanf_AKMA_AnchorKey_Register for %s failed: %v", req.supi, err)
+		return
+	}
+	logger.AkmaLog.Infof("AKMA key material of %s registered at the AAnF", req.supi)
+}
+
+// buildAkmaKeyInfo derives K_AKMA (TS 33.535 A.2) and the A-KID (cl. 6.1,
+// A.3) from K_AUSF. The SUPI of the KDF is the IMSI without "imsi-"
+// (TS 33.501 A.7.0); the "supi" attribute keeps the SBI form (TS 29.571).
+func buildAkmaKeyInfo(req akmaRequest, plmns []models.PlmnId) (models.AkmaKeyInfo, error) {
+	param, err := supi.FromSBI(req.supi)
+	if err != nil {
+		return models.AkmaKeyInfo{}, err
+	}
+	kAusf, err := codec.ParseHexKey(req.kausf)
+	if err != nil {
+		return models.AkmaKeyInfo{}, fmt.Errorf("K_AUSF: %w", err)
+	}
+	// "The AUSF shall use the RID received from the UDM" (TS 33.535 cl. 6.1).
+	rid, err := akid.ParseRID(req.routingId)
+	if err != nil {
+		return models.AkmaKeyInfo{}, fmt.Errorf("routingId from the UDM: %w", err)
+	}
+	hn, err := homeNetwork(req.supiOrSuci, string(param), plmns)
+	if err != nil {
+		return models.AkmaKeyInfo{}, err
+	}
+	kAkma, err := derive.KAkma(kAusf, param)
+	if err != nil {
+		return models.AkmaKeyInfo{}, err
+	}
+	id, err := derive.AKID(kAusf, param, rid, hn)
+	if err != nil {
+		return models.AkmaKeyInfo{}, err
+	}
+	aKId, err := id.Format(akid.DefaultOptions())
+	if err != nil {
+		return models.AkmaKeyInfo{}, err
+	}
+	return models.AkmaKeyInfo{Supi: req.supi, AKId: aKId, KAkma: codec.HexKey(kAkma)}, nil
+}
+
+// homeNetwork returns the home network of the UE for the realm of the A-KID
+// (TS 33.535 cl. 6.1; TS 23.003 cl. 28.2). The MNC length cannot be read
+// from the IMSI (TS 23.003 cl. 2.2): it comes from the SUCI of the request
+// ("suci-0-<MCC>-<MNC>-..."), or, when the request carried a SUPI, from the
+// single PLMN of plmnSupportList whose MCC and MNC prefix the IMSI.
+func homeNetwork(supiOrSuci, imsi string, plmns []models.PlmnId) (akid.HomeNetwork, error) {
+	if rest, ok := strings.CutPrefix(supiOrSuci, "suci-0-"); ok {
+		parts := strings.SplitN(rest, "-", 3)
+		if len(parts) == 3 {
+			return akid.NewHomeNetwork(parts[0], parts[1])
+		}
+		return akid.HomeNetwork{}, errors.New("malformed SUCI")
+	}
+	var found []models.PlmnId
+	for _, plmn := range plmns {
+		if strings.HasPrefix(imsi, plmn.Mcc+plmn.Mnc) {
+			found = append(found, plmn)
+		}
+	}
+	if len(found) != 1 {
+		return akid.HomeNetwork{}, fmt.Errorf("home network of the IMSI not determined by plmnSupportList (%d matches)",
+			len(found))
+	}
+	return akid.NewHomeNetwork(found[0].Mcc, found[0].Mnc)
+}
