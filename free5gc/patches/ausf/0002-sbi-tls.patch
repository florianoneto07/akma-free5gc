+
+// GetCertCaPath returns the file with the CA of the peers on the SBI.
+func (c *Config) GetCertCaPath() string {
+	c.RLock()
+	defer c.RUnlock()
+	if c.Configuration.Sbi.Tls != nil {
+		return c.Configuration.Sbi.Tls.Ca
+	}
+	return ""
+}
+
+// GetSbiFqdn returns the FQDN of this NF (TS 29.510 cl. 6.1.6.2.2 NOTE 1),
+// empty when the URIs go by IP address.
+func (c *Config) GetSbiFqdn() string {
+	if c == nil || c.Configuration == nil || c.Configuration.Sbi == nil {
+		return ""
+	}
+	c.RLock()
+	defer c.RUnlock()
+	return c.Configuration.Sbi.Fqdn
+}
