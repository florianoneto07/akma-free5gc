+
+func TestNoSecretLog(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "sslkey.log")
+	server, err := NewHttp2Server("127.0.0.1:0", path, http.NotFoundHandler())
+	assert.NoError(t, err)
+	assert.Nil(t, server.TLSConfig)
+	_, err = os.Stat(path)
+	assert.True(t, os.IsNotExist(err))
+}
