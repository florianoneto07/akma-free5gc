     sudo killall -9 ${NF}
diff --git a/run.sh b/run.sh
index 3f68854..db277b9 100755
--- a/run.sh
+++ b/run.sh
@@ -8,6 +8,7 @@ N3IWF_ENABLE=0
 TNGF_ENABLE=0
