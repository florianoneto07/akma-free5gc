+CCF_ENABLE=0
 
 PID_LIST=()
 echo $$ > run.pid
@@ -51,6 +52,9 @@ if [ $# -ne 0 ]; then
             -aanf)
                 AANF_ENABLE=1
                 ;;
+            -ccf)
+                CCF_ENABLE=1
+                ;;
         esac
         shift
     done
@@ -166,6 +170,15 @@ else
     echo "AANF disabled - skipping AANF service"
 fi
 
+# Add the CCF (CAPIF core function) just before the NEF, only if enabled:
+# the NEF publishes its AKMA API at the CCF when it starts
+if [ $CCF_ENABLE -ne 0 ]; then
