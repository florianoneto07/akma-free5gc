+const (
+	hnAuthNrf  = "http://127.0.0.10:8000"
+	hnAuthAusf = "http://127.0.0.9:8000"
+)
+
+// hnAuthUe returns a UE in state for 3GPP access, with a valid security
+// context (ngKSI 0) and, when connected, a RAN UE whose downlink NGAP
+// messages arrive on the returned channel.
+func hnAuthUe(t *testing.T, supi string, state fsm.StateType, connected bool) (*context.AmfUe, <-chan []byte) {
+	t.Helper()
+	if factory.AmfConfig == nil {
+		factory.AmfConfig = &factory.Config{Configuration: &factory.Configuration{}}
+	}
+	self := context.GetSelf()
+	self.ServedGuamiList = []models.Guami{{PlmnId: &models.PlmnIdNid{Mcc: "208", Mnc: "93"}, AmfId: "cafe00"}}
+	ue := self.NewAmfUe(supi)
+	t.Cleanup(func() { self.UePool.Delete(supi) })
+	ue.Supi = supi
+	ue.Suci = "suci-0-208-93-0000-0-0-" + supi[len(supi)-10:]
+	ue.State[models.AccessType__3_GPP_ACCESS].Set(state)
+	ue.SecurityContextAvailable = true
+	ue.NgKsi = models.NgKsi{Tsc: models.ScType_NATIVE, Ksi: 0}
+	if !connected {
+		return ue, nil
+	}
+	amfSide, ranSide := net.Pipe()
+	t.Cleanup(func() {
+		amfSide.Close()
+		ranSide.Close()
+	})
+	downlink := make(chan []byte, 8)
+	go func() {
+		for {
+			b := make([]byte, 4096)
+			n, err := ranSide.Read(b)
+			if err != nil {
+				return
+			}
+			downlink <- b[:n]
+		}
+	}()
+	ran := self.NewAmfRan(amfSide)
+	ran.AnType = models.AccessType__3_GPP_ACCESS
+	ranUe, err := ran.NewRanUe(1)
+	require.NoError(t, err)
+	ue.AttachRanUe(ranUe)
+	return ue, downlink
+}
+
+// TS 29.503 table 6.2.5.6-3; TS 33.501 cl. 6.1.5.2 step 3.
+func TestReauthNotificationRefusals(t *testing.T) {
+	cases := []struct {
+		name       string
+		state      fsm.StateType
+		running    bool
+		onGoing    context.OnGoingProcedure
+		wantStatus int
+		wantCause  string
+	}{
+		{"deregistered", context.Deregistered, false, "", http.StatusNotFound, "CONTEXT_NOT_FOUND"},
+		{"deregistration in progress", context.DeregistrationInitiated, false, "", http.StatusForbidden,
+			"REAUTHENTICATION_NOT_ALLOWED"},
+		{"re-authentication in progress", context.Registered, true, "", http.StatusForbidden,
+			"REAUTHENTICATION_NOT_ALLOWED"},
+		{"authentication of a registration", context.Authentication, false, "", http.StatusConflict,
+			"TEMPORARY_REJECT_REGISTRATION_ONGOING"},
+		{"security mode of a registration", context.SecurityMode, false, "", http.StatusConflict,
+			"TEMPORARY_REJECT_REGISTRATION_ONGOING"},
+		{"context setup of a registration", context.ContextSetup, false, "", http.StatusConflict,
+			"TEMPORARY_REJECT_REGISTRATION_ONGOING"},
+		{"registration update in progress", context.Registered, false, context.OnGoingProcedureRegistration,
+			http.StatusConflict, "TEMPORARY_REJECT_REGISTRATION_ONGOING"},
+		{"handover in progress", context.Registered, false, context.OnGoingProcedureN2Handover,
+			http.StatusConflict, "TEMPORARY_REJECT_HANDOVER_ONGOING"},
+	}
+	for i, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			ue, downlink := hnAuthUe(t, "imsi-20893000000020"+string(rune('0'+i)), tc.state, true)
+			ue.HnAuthRunning = tc.running
+			if tc.onGoing != "" {
+				ue.SetOnGoing(models.AccessType__3_GPP_ACCESS, &context.OnGoing{Procedure: tc.onGoing})
+			}
+			status, cause := ReauthNotification(ue)
+			require.Equal(t, tc.wantStatus, status)
+			require.Equal(t, tc.wantCause, cause)
+			require.Equal(t, tc.running, ue.HnAuthRunning)
+			require.False(t, ue.HnAuthPending)
+			require.True(t, ue.State[models.AccessType__3_GPP_ACCESS].Is(tc.state))
+			require.Empty(t, downlink)
+		})
+	}
+}
+
+// A registered UE in CM-IDLE: 202 and the authentication pending flag.
+func TestReauthNotificationIdle(t *testing.T) {
+	ue, _ := hnAuthUe(t, "imsi-208930000000211", context.Registered, false)
+	status, cause := ReauthNotification(ue)
+	require.Equal(t, http.StatusAccepted, status)
+	require.Empty(t, cause)
+	require.True(t, ue.HnAuthPending)
+	require.False(t, ue.HnAuthRunning)
+	since := ue.HnAuthPendingSince
+
+	// A second notification keeps the flag and its time.
+	status, _ = ReauthNotification(ue)
+	require.Equal(t, http.StatusAccepted, status)
+	require.Equal(t, since, ue.HnAuthPendingSince)
+
+	// Not connected yet: nothing starts.
+	startPendingHnAuth(ue.State[models.AccessType__3_GPP_ACCESS], ue, models.AccessType__3_GPP_ACCESS)
+	require.True(t, ue.HnAuthPending)
+	require.True(t, ue.State[models.AccessType__3_GPP_ACCESS].Is(context.Registered))
+}
+
+// mockAusf answers the discovery of the AUSF and its authenticate request.
+func mockAusf() {
