diff --git a/internal/gmm/hn_auth.go b/internal/gmm/hn_auth.go
new file mode 100644
index 0000000..1060d89
--- /dev/null
+++ b/internal/gmm/hn_auth.go
@@ -0,0 +1,115 @@
+package gmm
+
+import (
+	"net/http"
+	"sync"
+	"time"
+
+	"github.com/free5gc/amf/internal/context"
+	gmm_message "github.com/free5gc/amf/internal/gmm/message"
+	"github.com/free5gc/amf/internal/logger"
+	"github.com/free5gc/nas/nasMessage"
+	"github.com/free5gc/openapi/models"
+	"github.com/free5gc/util/fsm"
+)
+
+// hnAuthMu serializes the re-authentication notifications.
+var hnAuthMu sync.Mutex
+
+// ReauthNotification handles Nudm_UECM_Re-AuthenticationNotification for ue,
+// which is registered for 3GPP access (TS 33.501 cl. 6.1.5.2 steps 3 and 4;
+// TS 29.503 cl. 5.3.2.15.2). It returns the status and the cause of the
+// answer to the UDM (TS 29.503 table 6.2.5.6-3):
+//   - 204: the UE is connected and the primary authentication started;
+//   - 202: the UE is not reachable; the authentication pending flag is set,
+//     and the authentication runs when the UE registers or sends a Service
+//     Request;
+//   - 409: a registration or a handover is in progress;
+//   - 403: an authentication or a deregistration is in progress;
+//   - 404: the UE is not registered.
+func ReauthNotification(ue *context.AmfUe) (int, string) {
+	hnAuthMu.Lock()
+	defer hnAuthMu.Unlock()
+
+	anType := models.AccessType__3_GPP_ACCESS
+	state := ue.State[anType]
+	switch {
+	case state == nil || state.Is(context.Deregistered):
+		return http.StatusNotFound, "CONTEXT_NOT_FOUND"
+	case ue.HnAuthRunning || state.Is(context.DeregistrationInitiated):
+		return http.StatusForbidden, "REAUTHENTICATION_NOT_ALLOWED"
+	case !state.Is(context.Registered):
+		// Authentication, SecurityMode and ContextSetup are steps of a
+		// registration.
+		return http.StatusConflict, "TEMPORARY_REJECT_REGISTRATION_ONGOING"
+	}
+	switch ue.OnGoing(anType).Procedure {
+	case context.OnGoingProcedureN2Handover:
+		return http.StatusConflict, "TEMPORARY_REJECT_HANDOVER_ONGOING"
+	case context.OnGoingProcedureRegistration:
+		return http.StatusConflict, "TEMPORARY_REJECT_REGISTRATION_ONGOING"
+	}
+	if ue.CmIdle(anType) {
+		if !ue.HnAuthPending {
+			ue.HnAuthPending = true
+			ue.HnAuthPendingSince = time.Now()
+		}
+		logger.AkmaLog.Infof("Re-authentication of %s requested by the UDM: pending (UE not connected)", ue.Supi)
+		return http.StatusAccepted, ""
+	}
+	if !startHnAuth(state, ue, anType) {
+		return http.StatusInternalServerError, "SYSTEM_FAILURE"
+	}
+	logger.AkmaLog.Infof("Re-authentication of %s requested by the UDM: started (ngKSI %d)", ue.Supi, ue.NgKsi.Ksi)
+	return http.StatusNoContent, ""
+}
+
+// startHnAuth starts the primary authentication of a registered and connected
+// UE (TS 33.501 cl. 6.1.5.2 step 4), with a new ngKSI for the partial native
+// security context it creates (cl. 6.1.3.2 step 6). It returns false when the
+// authentication could not start; the UE then stays in Registered.
+func startHnAuth(state *fsm.State, ue *context.AmfUe, anType models.AccessType) bool {
+	current := ue.NgKsi
+	ue.HnAuthPending = false
+	ue.HnAuthRunning = true
+	ue.NgKsi.Tsc = models.ScType_NATIVE
+	ue.NgKsi.Ksi = (ue.NgKsi.Ksi + 1) % nasMessage.NasKeySetIdentifierNoKeyIsAvailable
+	if err := GmmFSM.SendEvent(state, StartAuthEvent, fsm.ArgsType{
+		ArgAmfUe:      ue,
+		ArgAccessType: anType,
+	}, logger.GmmLog); err != nil {
+		logger.GmmLog.Errorln(err)
+		ue.HnAuthRunning = false
+	}
+	if !state.Is(context.Authentication) {
+		// The current security context stays in use.
+		ue.NgKsi = current
+		return false
+	}
+	return true
+}
+
+// startPendingHnAuth runs the primary authentication that the UDM asked for
+// while the UE was not reachable, now that it registered or sent a Service
+// Request (TS 33.501 cl. 6.1.5.2 step 3).
+func startPendingHnAuth(state *fsm.State, ue *context.AmfUe, anType models.AccessType) {
+	if !ue.HnAuthPending || anType != models.AccessType__3_GPP_ACCESS || ue.CmIdle(anType) ||
+		!state.Is(context.Registered) {
+		return
+	}
+	since := ue.HnAuthPendingSince
+	if startHnAuth(state, ue, anType) {
+		logger.AkmaLog.Infof("Re-authentication of %s requested by the UDM %s ago: started (ngKSI %d)",
+			ue.Supi, time.Since(since).Round(time.Second), ue.NgKsi.Ksi)
+	}
+}
+
+// sendAuthRegistrationReject rejects the registration whose authentication
+// failed before the UE was involved. A primary authentication asked by the
+// UDM is not part of a registration: the UE is not rejected.
+func sendAuthRegistrationReject(ue *context.AmfUe, anType models.AccessType, cause uint8) {
+	if ue.HnAuthRunning {
+		return
+	}
+	gmm_message.SendRegistrationReject(ue.RanUe[anType], cause, "")
+}
