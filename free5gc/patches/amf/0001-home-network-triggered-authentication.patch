+package sbi
+
+import (
+	"net/http"
+
+	"github.com/gin-gonic/gin"
+
+	amf_context "github.com/free5gc/amf/internal/context"
+	"github.com/free5gc/amf/internal/gmm"
+	"github.com/free5gc/amf/internal/logger"
+	"github.com/free5gc/openapi"
+	"github.com/free5gc/openapi/models"
+	"github.com/free5gc/util/metrics/sbi"
+)
+
+// getHttpNotificationRoutes are the callback routes that receive
+// notifications, served without the access token check of the other callbacks:
+// OAuth 2.0 does not apply to notifications (TS 29.500 cl. 6.7.3; TS 33.501
+// cl. 13.4.1.0).
+func (s *Server) getHttpNotificationRoutes() []Route {
+	return []Route{
+		{
+			Name:    "HandleReauthNotification",
+			Method:  http.MethodPost,
+			Pattern: "/reauth/:supi",
+			APIFunc: s.HTTPHandleReauthNotification,
+		},
+	}
+}
+
+// HTTPHandleReauthNotification receives Nudm_UECM_Re-AuthenticationNotification
+// at the reauthNotifyCallbackUri of the AMF registration (TS 29.503 cl.
+// 5.3.2.15 and 6.2.5.6; TS 33.501 cl. 6.1.5.2 step 2).
+func (s *Server) HTTPHandleReauthNotification(c *gin.Context) {
+	var info models.ReauthNotificationInfo
+
+	requestBody, err := c.GetRawData()
+	if err != nil {
+		logger.CallbackLog.Errorf("Get Request Body error: %+v", err)
+		problemDetails := openapi.ProblemDetailsSystemFailure(err.Error())
+		c.Set(sbi.IN_PB_DETAILS_CTX_STR, problemDetails.Cause)
+		c.JSON(http.StatusInternalServerError, problemDetails)
+		return
+	}
+
+	supi := c.Param("supi")
+	if err = openapi.Deserialize(&info, requestBody, "application/json"); err != nil || info.Supi != supi {
+		detail := "the supi of the body differs from the callback URI"
+		if err != nil {
+			detail = reqbody + err.Error()
+		}
+		problemDetails := models.ProblemDetails{
+			Title:  "Malformed request syntax",
+			Status: http.StatusBadRequest,
+			Detail: detail,
+		}
+		logger.CallbackLog.Errorln(detail)
+		c.Set(sbi.IN_PB_DETAILS_CTX_STR, http.StatusText(http.StatusBadRequest))
+		c.JSON(http.StatusBadRequest, problemDetails)
+		return
+	}
+	// oldGuami and ausfRediscoveryInd are not used: this AMF is the
+	// registered one, and it selects the AUSF for each authentication.
+
+	status, cause := http.StatusNotFound, "CONTEXT_NOT_FOUND"
+	if ue, ok := amf_context.GetSelf().AmfUeFindBySupi(supi); ok {
+		status, cause = gmm.ReauthNotification(ue)
+	}
+	if status == http.StatusNoContent || status == http.StatusAccepted {
+		c.Status(status)
+		return
+	}
+	logger.AkmaLog.Warnf("Re-authentication of %s requested by the UDM: refused, %d %s", supi, status, cause)
+	problemDetails := models.ProblemDetails{
+		Title:  http.StatusText(status),
+		Status: int32(status),
+		Cause:  cause,
+	}
+	c.Set(sbi.IN_PB_DETAILS_CTX_STR, cause)
+	c.JSON(status, problemDetails)
+}
