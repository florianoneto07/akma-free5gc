+			NfInstanceId: "a1b2c3d4-0000-4000-8000-000000000009",
+			NfType:       models.NrfNfManagementNfType_AUSF,
+			NfStatus:     models.NrfNfManagementNfStatus_REGISTERED,
+			NfServices: []models.NrfNfDiscoveryNfService{{
+				ServiceInstanceId: "0",
+				ServiceName:       models.ServiceName_NAUSF_AUTH,
+				Scheme:            models.UriScheme_HTTP,
+				NfServiceStatus:   models.NfServiceStatus_REGISTERED,
+				ApiPrefix:         hnAuthAusf,
+			}},
+		}}})
+	gock.New(hnAuthAusf).
+		Post("/nausf-auth/v1/ue-authentications").
+		Reply(201).
+		AddHeader("Content-Type", "application/3gppHal+json").
+		AddHeader("Location", hnAuthAusf+"/nausf-auth/v1/ue-authentications/1").
+		JSON(map[string]interface{}{
+			"authType": "5G_AKA",
+			"5gAuthData": map[string]string{
+				"rand":      "2e9c3e5b5c0e6f6ff41a6b5ac8e8f9b0",
+				"autn":      "c5a7e7c1d3a5800050b4a8e0f1d2c3b4",
+				"hxresStar": "1b5c1f7d7b3a4c2e9a8f6e5d4c3b2a10",
+			},
+			"_links": map[string][]map[string]string{
+				"5g-aka": {{"href": hnAuthAusf + "/nausf-auth/v1/ue-authentications/1/5g-aka-confirmation"}},
+			},
+		})
+}
+
+func hnAuthAmf(t *testing.T) {
+	t.Helper()
+	self := context.GetSelf()
+	self.NrfUri = hnAuthNrf
+	self.OAuth2Required = false
+	_, err := consumer.NewConsumer(nil)
+	require.NoError(t, err)
+}
+
+// A connected UE: 204, the Authentication Request goes out with a new ngKSI
+// (TS 33.501 cl. 6.1.3.2 step 6), and the UE waits in Authentication.
+func TestReauthNotificationStart(t *testing.T) {
+	defer gock.Off()
+	openapi.InterceptH2CClient()
+	defer openapi.RestoreH2CClient()
+	hnAuthAmf(t)
+	mockAusf()
+
+	ue, downlink := hnAuthUe(t, "imsi-208930000000212", context.Registered, true)
+	ue.HnAuthPending = true
+	status, cause := ReauthNotification(ue)
+	require.Equal(t, http.StatusNoContent, status, cause)
+	require.True(t, gock.IsDone(), "pending mocks: %v", gock.Pending())
+	require.True(t, ue.State[models.AccessType__3_GPP_ACCESS].Is(context.Authentication))
+	require.True(t, ue.HnAuthRunning)
+	require.False(t, ue.HnAuthPending)
+	require.Equal(t, int32(1), ue.NgKsi.Ksi)
+	select {
+	case b := <-downlink:
+		require.NotEmpty(t, b)
+	case <-time.After(2 * time.Second):
+		t.Fatal("no Authentication Request sent to the RAN")
+	}
+
+	// Another notification while it runs.
+	status, cause = ReauthNotification(ue)
+	require.Equal(t, http.StatusForbidden, status)
+	require.Equal(t, "REAUTHENTICATION_NOT_ALLOWED", cause)
+}
+
+// The AUSF cannot be discovered: the UE stays in Registered with its current
+// security context, and no Registration Reject is sent.
+func TestReauthNotificationAbort(t *testing.T) {
+	defer gock.Off()
+	openapi.InterceptH2CClient()
+	defer openapi.RestoreH2CClient()
+	hnAuthAmf(t)
+	gock.New(hnAuthNrf).Get("/nnrf-disc/v1/nf-instances").Reply(503)
+
+	ue, downlink := hnAuthUe(t, "imsi-208930000000213", context.Registered, true)
+	status, cause := ReauthNotification(ue)
+	require.Equal(t, http.StatusInternalServerError, status)
+	require.Equal(t, "SYSTEM_FAILURE", cause)
+	require.True(t, ue.State[models.AccessType__3_GPP_ACCESS].Is(context.Registered))
+	require.False(t, ue.HnAuthRunning)
+	require.Equal(t, int32(0), ue.NgKsi.Ksi)
+	select {
+	case b := <-downlink:
+		t.Fatalf("message sent to the RAN: %x", b)
+	case <-time.After(200 * time.Millisecond):
+	}
+}
+
+// The NAS SMC of a re-authentication asks neither for the initial NAS message
+// nor for a horizontal derivation of KAMF.
+func TestSecurityModeCommandOfReauth(t *testing.T) {
+	ue, _ := hnAuthUe(t, "imsi-208930000000214", context.SecurityMode, false)
+	ue.RegistrationType5GS = nasMessage.RegistrationType5GSPeriodicRegistrationUpdating
+	ue.RetransmissionOfInitialNASMsg = true
+	ue.UESecurityCapability.SetLen(2)
+	ue.UESecurityCapability.Buffer = []uint8{0x80, 0x80}
+
+	info := func() (hdp, rinmr uint8) {
+		b, err := gmm_message.BuildSecurityModeCommand(ue, models.AccessType__3_GPP_ACCESS, false, "")
+		require.NoError(t, err)
+		// Security header (2), MAC (4) and sequence number (1).
+		plain := b[7:]
+		m := nas.NewMessage()
+		require.NoError(t, m.PlainNasDecode(&plain))
+		a := m.GmmMessage.SecurityModeCommand.Additional5GSecurityInformation
+		return a.GetHDP(), a.GetRINMR()
+	}
+
+	hdp, rinmr := info()
+	require.Equal(t, uint8(1), hdp)
+	require.Equal(t, uint8(1), rinmr)
+
+	ue.HnAuthRunning = true
+	hdp, rinmr = info()
+	require.Equal(t, uint8(0), hdp)
+	require.Equal(t, uint8(0), rinmr)
+}
+
+// A UE that puts its last Registration Request in the Security Mode Complete
+// of a re-authentication: the AMF ignores it and goes back to Registered,
+// without the ContextSetup of a registration.
+func TestSecurityModeCompleteOfReauth(t *testing.T) {
+	ue, _ := hnAuthUe(t, "imsi-208930000000215", context.SecurityMode, false)
+	ue.HnAuthRunning = true
+	ue.Kamf = "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f"
+
+	registration := nasMessage.NewRegistrationRequest(nas.MsgTypeRegistrationRequest)
+	registration.ExtendedProtocolDiscriminator.SetExtendedProtocolDiscriminator(
+		nasMessage.Epd5GSMobilityManagementMessage)
+	registration.RegistrationRequestMessageIdentity.SetMessageType(nas.MsgTypeRegistrationRequest)
+	registration.NgksiAndRegistrationType5GS.SetRegistrationType5GS(nasMessage.RegistrationType5GSInitialRegistration)
+	m := nas.NewMessage()
+	m.GmmMessage = nas.NewGmmMessage()
+	m.GmmHeader.SetMessageType(nas.MsgTypeRegistrationRequest)
+	m.RegistrationRequest = registration
+	contents, err := m.PlainNasEncode()
+	require.NoError(t, err)
+
+	complete := nasMessage.NewSecurityModeComplete(0)
+	complete.NASMessageContainer = nasType.NewNASMessageContainer(nasMessage.SecurityModeCompleteNASMessageContainerType)
+	complete.NASMessageContainer.SetLen(uint16(len(contents)))
+	complete.NASMessageContainer.SetNASMessageContainerContents(contents)
+
+	require.NoError(t, HandleSecurityModeComplete(ue, models.AccessType__3_GPP_ACCESS, 0, complete))
+	require.True(t, ue.State[models.AccessType__3_GPP_ACCESS].Is(context.Registered))
+	require.False(t, ue.HnAuthRunning)
+}
