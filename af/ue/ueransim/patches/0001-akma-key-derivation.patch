diff --git a/src/ue/nas/keys.cpp b/src/ue/nas/keys.cpp
index 917325b..89073cb 100644
--- a/src/ue/nas/keys.cpp
+++ b/src/ue/nas/keys.cpp
@@ -17,6 +17,29 @@ static const int N_RRC_int_alg = 0x04;
 static const int N_UP_enc_alg = 0x05;
 static const int N_UP_int_alg = 0x06;
 
+static const int FC_K_AKMA = 0x80;
+static const int FC_A_TID = 0x81;
+
+static std::string EncodeBase64(const OctetString &data)
+{
+    static const char alphabet[] = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+    std::string out;
+    int len = data.length();
+    for (int i = 0; i < len; i += 3)
+    {
+        int n = data.getI(i) << 16;
+        if (i + 1 < len)
+            n |= data.getI(i + 1) << 8;
+        if (i + 2 < len)
+            n |= data.getI(i + 2);
+        out += alphabet[(n >> 18) & 0x3F];
+        out += alphabet[(n >> 12) & 0x3F];
+        out += i + 1 < len ? alphabet[(n >> 6) & 0x3F] : '=';
+        out += i + 2 < len ? alphabet[n & 0x3F] : '=';
+    }
+    return out;
+}
