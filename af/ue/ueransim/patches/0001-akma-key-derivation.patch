 namespace nr::ue::keys
 {
 
@@ -154,4 +177,41 @@ OctetString CalculateAuts(const OctetString &sqn, const OctetString &ak, const O
     return auts;
 }
 
+OctetString CalculateKAkma(const OctetString &kAusf, const std::string &imsi)
+{
+    OctetString s[2];
+    s[0] = crypto::EncodeKdfString("AKMA");
+    s[1] = crypto::EncodeKdfString(imsi);
+    return crypto::CalculateKdfKey(kAusf, FC_K_AKMA, s, 2);
+}
+
+OctetString CalculateATid(const OctetString &kAusf, const std::string &imsi)
+{
+    OctetString s[2];
+    s[0] = crypto::EncodeKdfString("A-TID");
+    s[1] = crypto::EncodeKdfString(imsi);
+    return crypto::CalculateKdfKey(kAusf, FC_A_TID, s, 2);
+}
+
+std::string ConstructAKid(const std::string &routingIndicator, const OctetString &aTid, const Plmn &hplmn)
+{
+    char realm[40] = {0};
+    int r = sprintf(realm, "5gc.mnc%03d.mcc%03d.3gppnetwork.org", hplmn.mnc, hplmn.mcc);
+    if (r != 33)
+        throw std::runtime_error("A-KID realm construction failure");
+    return "rid" + routingIndicator + ".atid" + EncodeBase64(aTid) + "@" + realm;
+}
+
+void DeriveAkmaKeys(const UeConfig &ueConfig, NasSecurityContext &nasSecurityContext)
+{
+    auto &keys = nasSecurityContext.keys;
+    const std::string &imsi = ueConfig.supi->value;
+
+    // The RID of the SUCI (TS 33.535 clause 6.1); the UE sends "0000" when none is configured.
+    std::string routingIndicator = ueConfig.routingIndicator.value_or("0000");
+
+    keys.kAkma = CalculateKAkma(keys.kAusf, imsi);
+    keys.aKid = ConstructAKid(routingIndicator, CalculateATid(keys.kAusf, imsi), ueConfig.hplmn);
+}
+
 } // namespace nr::ue::keys
