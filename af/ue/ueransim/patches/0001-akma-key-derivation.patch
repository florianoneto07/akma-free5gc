+void NasMm::deriveAkmaKeys()
+{
+    // TS 33.535 clause 6.1: the UE generates K_AKMA and the A-KID from K_AUSF before initiating communication with an
+    // AKMA AF. They are derived when the security context of a successful primary authentication is taken into use.
+    if (!m_base->config->akma)
+        return;
+
+    if (!m_base->config->supi.has_value() || m_base->config->supi->type != "imsi")
+    {
+        m_logger->warn("AKMA key material not derived, the SUPI is not an IMSI");
+        return;
+    }
+
+    auto &nsCtx = *m_usim->m_currentNsCtx;
+    keys::DeriveAkmaKeys(*m_base->config, nsCtx);
+    m_logger->info("AKMA key material derived, A-KID[%s]", nsCtx.keys.aKid.c_str());
+}
+
 } // namespace nr::ue
