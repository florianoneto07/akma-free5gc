 void DeriveAkmaKeys(const UeConfig &ueConfig, NasSecurityContext &nasSecurityContext);
 
+/**
+ * Checks that an AF FQDN can enter the K_AF derivation in the UE: an ASCII DNS name. The UE does not apply NFKC
+ * (3GPP TS 33.220 Annex B.2.1.2), so non-ASCII names are refused
+ */
+bool IsValidAfFqdn(const std::string &fqdn);
+
+/**
+ * Calculates K_AF from K_AKMA as specified in 3GPP TS 33.535 Annex A.4: P0 is the AF_ID, the FQDN of the AF followed
+ * by the five octets of the Ua* security protocol identifier (3GPP TS 33.220 Annex H)
+ */
+OctetString CalculateKAf(const OctetString &kAkma, const std::string &afFqdn, const OctetString &uaStarId);
+
 } // namespace nr::ue::keys
diff --git a/src/ue/nas/keys.cpp b/src/ue/nas/keys.cpp
index 89073cb..9cebc49 100644
--- a/src/ue/nas/keys.cpp
+++ b/src/ue/nas/keys.cpp
@@ -19,6 +19,7 @@ static const int N_UP_int_alg = 0x06;
 
 static const int FC_K_AKMA = 0x80;
 static const int FC_A_TID = 0x81;
+static const int FC_K_AF = 0x82;
 
 static std::string EncodeBase64(const OctetString &data)
 {
@@ -214,4 +215,37 @@ void DeriveAkmaKeys(const UeConfig &ueConfig, NasSecurityContext &nasSecurityCon
     keys.aKid = ConstructAKid(routingIndicator, CalculateATid(keys.kAusf, imsi), ueConfig.hplmn);
 }
 
+bool IsValidAfFqdn(const std::string &fqdn)
+{
+    if (fqdn.empty() || fqdn.size() > 253)
+        return false;
+    size_t start = 0;
+    while (true)
+    {
+        size_t end = fqdn.find('.', start);
+        std::string label = fqdn.substr(start, end == std::string::npos ? std::string::npos : end - start);
+        if (label.empty() || label.size() > 63 || label.front() == '-' || label.back() == '-')
+            return false;
+        for (char c : label)
+        {
+            if (!((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '-'))
+                return false;
+        }
+        if (end == std::string::npos)
+            return true;
+        start = end + 1;
+    }
+}
+
+OctetString CalculateKAf(const OctetString &kAkma, const std::string &afFqdn, const OctetString &uaStarId)
+{
+    if (!IsValidAfFqdn(afFqdn))
+        throw std::runtime_error("AF FQDN is not an ASCII DNS name");
+    if (uaStarId.length() != 5)
+        throw std::runtime_error("Ua* security protocol identifier must have 5 octets");
+    OctetString s[1];
+    s[0] = OctetString::Concat(crypto::EncodeKdfString(afFqdn), uaStarId);
+    return crypto::CalculateKdfKey(kAkma, FC_K_AF, s, 1);
+}
+
 } // namespace nr::ue::keys
