diff --git a/src/akma_selftest.cpp b/src/akma_selftest.cpp
new file mode 100644
index 0000000..85de76a
--- /dev/null
+++ b/src/akma_selftest.cpp
@@ -0,0 +1,97 @@
+//
+// AKMA self-test of the ME: checks the K_AKMA, A-TID, A-KID and K_AF derivations of nr-ue (3GPP TS 33.535 Annex A)
+// against the AKMA test vectors (shared/akma/testdata/vectors.json).
+//
+// Usage: nr-akma-selftest <vectors.json>
+//
+
+#include <cstdio>
+#include <exception>
+#include <string>
+
+#include <ue/nas/keys.hpp>
+#include <yaml-cpp/yaml.h>
+
+using namespace nr::ue;
+
+static std::string Lower(std::string s)
+{
+    for (auto &c : s)
+        if (c >= 'A' && c <= 'F')
+            c = static_cast<char>(c - 'A' + 'a');
+    return s;
+}
+
+int main(int argc, char **argv)
+{
+    if (argc != 2)
+    {
+        std::fprintf(stderr, "usage: %s <vectors.json>\n", argv[0]);
+        return 2;
+    }
+
+    YAML::Node doc;
+    try
+    {
+        doc = YAML::LoadFile(argv[1]); // JSON is read as YAML flow style
+    }
+    catch (const std::exception &e)
+    {
+        std::fprintf(stderr, "%s: %s\n", argv[1], e.what());
+        return 2;
+    }
+
+    int passed = 0, refused = 0, failed = 0;
+    for (const auto &v : doc["vectors"])
+    {
+        auto name = v["name"].as<std::string>();
+        auto imsi = v["supi_kdf_param"].as<std::string>();
+        auto kAusf = OctetString::FromHex(v["k_ausf"].as<std::string>());
+        auto mncStr = v["mnc"].as<std::string>();
+        Plmn hplmn{};
+        hplmn.mcc = std::stoi(v["mcc"].as<std::string>());
+        hplmn.mnc = std::stoi(mncStr);
+        hplmn.isLongMnc = mncStr.size() == 3;
+        auto fqdn = v["fqdn"].as<std::string>();
+        auto uaStarId = OctetString::FromHex(v["ua_star_id"].as<std::string>());
+
+        auto kAkma = keys::CalculateKAkma(kAusf, imsi);
+        auto aKid = keys::ConstructAKid(v["rid"].as<std::string>(), keys::CalculateATid(kAusf, imsi), hplmn);
+
+        bool ok = true;
+        if (Lower(kAkma.toHexString()) != Lower(v["k_akma"].as<std::string>()))
+        {
+            std::printf("FAIL %s: K_AKMA\n", name.c_str());
+            ok = false;
+        }
+        if (aKid != v["a_kid"]["base64"].as<std::string>())
+        {
+            std::printf("FAIL %s: A-KID %s\n", name.c_str(), aKid.c_str());
+            ok = false;
+        }
+        if (!keys::IsValidAfFqdn(fqdn))
+        {
+            // No NFKC in the UE (TS 33.220 B.2.1.2): a non-ASCII FQDN is refused.
+            std::printf("%s %s: K_AF not derived, FQDN not ASCII (no NFKC in the UE)\n", ok ? "REFUSED" : "FAIL", name.c_str());
+            if (ok)
+                refused++;
+            else
+                failed++;
+            continue;
+        }
+        if (Lower(keys::CalculateKAf(kAkma, fqdn, uaStarId).toHexString()) != Lower(v["k_af"].as<std::string>()))
+        {
+            std::printf("FAIL %s: K_AF\n", name.c_str());
+            ok = false;
+        }
+        if (ok)
+        {
+            std::printf("PASS %s\n", name.c_str());
+            passed++;
+        }
+        else
+            failed++;
+    }
+    std::printf("%d passed, %d refused (FQDN not ASCII), %d failed\n", passed, refused, failed);
+    return failed == 0 && passed > 0 ? 0 : 1;
+}
