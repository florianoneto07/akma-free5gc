+// K_AF for the AKMA key service (TS 33.535 cl. 4.4.3), with the NAS security context read while the other tasks
+// are paused, as for nr-cli.
+void UeCmdHandler::handleAkmaKaf(NmUeAkmaKafRequest &msg)
+{
+    AkmaKafResult result{};
+    if (pauseAndWait())
+        result = deriveAkmaKaf(msg.afFqdn, msg.uaStarId);
+    else
+    {
+        result.cause = "UNAVAILABLE";
+        result.detail = "UE is unable to process the request due to pausing timeout";
+    }
+    unpauseTasks();
+    msg.result->set_value(std::move(result));
+}
 
