+//
+// AKMA key service of the ME (3GPP TS 33.535 cl. 4.4.3).
+//
+
+#pragma once
+
+#include <atomic>
+#include <memory>
+#include <string>
+#include <thread>
+
+#include <ue/types.hpp>
+#include <utils/logger.hpp>
+
+namespace nr::ue
+{
+
+// Applications ask for K_AF over a Unix socket. The kernel gives the user and the process of the application
+// (SO_PEERCRED), and the policy of the UE configuration says which AF_IDs each application may get:
+// an application only gets the K_AF of its own AF_IDs, and K_AKMA never leaves the ME (TS 33.535 cl. 4.4.3).
+//
+// Protocol, one ASCII line per request and per answer:
+//   KAF <AF FQDN> <Ua* security protocol id, 10 hexadecimal digits>
+//   OK a-kid=<A-KID> af-id=<AF_ID> k-af=<64 hexadecimal digits>
+//   ERR <AKMA_DISABLED | NO_KEY_MATERIAL | BAD_REQUEST | NOT_AUTHORIZED | UNAVAILABLE>
+class AkmaKeyService
+{
+  private:
+    TaskBase *m_base;
+    std::unique_ptr<Logger> m_logger;
+    std::string m_path;
+    int m_fd{-1};
+    std::atomic<bool> m_stop{false};
+    std::thread m_thread;
+
+  public:
+    explicit AkmaKeyService(TaskBase *base);
+    ~AkmaKeyService();
+
+    bool start();
+
+  private:
+    void run();
+    void serve(int fd);
+    std::string handle(const std::string &line, int uid, const std::string &executable);
+};
+
+} // namespace nr::ue
