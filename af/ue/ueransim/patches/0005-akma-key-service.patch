+// TS 33.535 cl. 6.2.1 step 1: the ME derives K_AF for the AF; K_AKMA never leaves the ME (cl. 4.4.3).
+AkmaKafResult UeCmdHandler::deriveAkmaKaf(const std::string &afFqdn, const std::string &uaStarId)
+{
+    AkmaKafResult result{};
+    if (!m_base->config->akma)
+    {
+        result.cause = "AKMA_DISABLED";
+        result.detail = "AKMA is not enabled in the UE configuration";
+        return result;
+    }
+    auto &nsCtx = m_base->nasTask->usim->m_currentNsCtx;
+    if (!nsCtx || nsCtx->keys.aKid.empty())
+    {
+        result.cause = "NO_KEY_MATERIAL";
+        result.detail = "No AKMA key material: no successful primary authentication";
+        return result;
+    }
+    if (!keys::IsValidAfFqdn(afFqdn))
+    {
+        result.cause = "BAD_REQUEST";
+        result.detail = "AF FQDN must be an ASCII DNS name (no NFKC in the UE)";
+        return result;
+    }
+    if (uaStarId.size() != 10 || uaStarId.find_first_not_of("0123456789ABCDEF") != std::string::npos)
+    {
+        result.cause = "BAD_REQUEST";
+        result.detail = "Ua* security protocol identifier must be 10 hexadecimal digits";
+        return result;
+    }
+    result.kAf = keys::CalculateKAf(nsCtx->keys.kAkma, afFqdn, OctetString::FromHex(uaStarId));
+    result.afId = afFqdn + "." + uaStarId;
+    result.aKid = nsCtx->keys.aKid;
+    m_base->logBase->makeUniqueLogger(m_base->config->getLoggerPrefix() + "app")
+        ->info("AKMA K_AF derived for AF_ID[%s], A-KID[%s]", result.afId.c_str(), result.aKid.c_str());
+    return result;
+}
