+// K_AF asked by the AKMA key service of the ME for an application (TS 33.535 cl. 4.4.3, cl. 6.2.1 step 1)
+struct AkmaKafResult
+{
+    std::string cause{};  // empty on success: AKMA_DISABLED, NO_KEY_MATERIAL, BAD_REQUEST or UNAVAILABLE otherwise
+    std::string detail{}; // for nr-cli
+    std::string aKid{};
+    std::string afId{};
+    OctetString kAf{};
+};
+
+struct NmUeAkmaKafRequest : NtsMessage
+{
+    std::string afFqdn;
+    std::string uaStarId; // 10 hexadecimal digits, uppercase
+    std::shared_ptr<std::promise<AkmaKafResult>> result;
+
+    NmUeAkmaKafRequest(std::string afFqdn, std::string uaStarId, std::shared_ptr<std::promise<AkmaKafResult>> result)
+        : NtsMessage(NtsMessageType::UE_AKMA_KAF_REQUEST), afFqdn(std::move(afFqdn)), uaStarId(std::move(uaStarId)),
+          result(std::move(result))
+    {
+    }
+};
+
 } // namespace nr::ue
