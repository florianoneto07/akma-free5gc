+// AKMA key service of the ME (TS 33.535 cl. 4.4.3). An AF_ID belongs to one application only: two applications with
+// the same AF_ID would get the same K_AF, and one could use the key of the other.
+static void ReadAkmaKeyService(const YAML::Node &node, nr::ue::UeConfig &config)
+{
+    if (yaml::HasField(node, "socket"))
+        config.akmaKeySocket = yaml::GetString(node, "socket", 1, 107);
+    if (!yaml::HasField(node, "applications"))
+        return;
+    std::set<std::string> seen{};
+    for (auto &app : yaml::GetSequence(node, "applications"))
+    {
+        nr::ue::UeConfig::AkmaApplication a{};
+        a.name = yaml::GetString(app, "name", 1, 64);
+        a.uid = yaml::GetInt32(app, "uid", 0, std::nullopt);
+        if (yaml::HasField(app, "executable"))
+            a.executable = yaml::GetString(app, "executable", 1, 4096);
+        for (auto &item : yaml::GetSequence(app, "afIds"))
+        {
+            auto afId = item.as<std::string>();
+            auto dot = afId.rfind('.');
+            std::string id = dot == std::string::npos ? "" : afId.substr(dot + 1);
+            std::transform(id.begin(), id.end(), id.begin(), [](unsigned char c) { return std::toupper(c); });
+            if (dot == std::string::npos || !nr::ue::keys::IsValidAfFqdn(afId.substr(0, dot)) || id.size() != 10 ||
+                id.find_first_not_of("0123456789ABCDEF") != std::string::npos)
+                throw std::runtime_error("akmaKeyService: invalid AF_ID " + afId +
+                                         ", expected <FQDN>.<10 hexadecimal digits>");
+            afId = afId.substr(0, dot + 1) + id;
+            if (!seen.insert(afId).second)
+                throw std::runtime_error("akmaKeyService: AF_ID " + afId +
+                                         " is given to more than one application (TS 33.535 cl. 4.4.3)");
+            a.afIds.push_back(afId);
+        }
+        config.akmaApplications.push_back(std::move(a));
+    }
+}
