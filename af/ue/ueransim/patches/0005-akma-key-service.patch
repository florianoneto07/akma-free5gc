index 0000000..f4cf1cc
--- /dev/null
+++ b/src/ue/app/akma_service.cpp
@@ -0,0 +1,228 @@
+//
+// AKMA key service of the ME (3GPP TS 33.535 cl. 4.4.3).
+//
+
+#include "akma_service.hpp"
+
+#include <algorithm>
+#include <cctype>
+#include <cerrno>
+#include <chrono>
+#include <cstring>
+#include <future>
+#include <sstream>
+
+#include <poll.h>
+#include <sys/socket.h>
+#include <sys/stat.h>
+#include <sys/time.h>
+#include <sys/un.h>
+#include <unistd.h>
+
+#include <ue/app/task.hpp>
+#include <ue/nas/keys.hpp>
+#include <ue/nts.hpp>
+
+static constexpr int REQUEST_TIMEOUT_MS = 5000;
+static constexpr int RECEIVE_TIMEOUT_S = 5;
+static constexpr size_t MAX_LINE = 512;
+
+namespace nr::ue
+{
+
+static std::string Upper(std::string s)
+{
+    std::transform(s.begin(), s.end(), s.begin(), [](unsigned char c) { return std::toupper(c); });
+    return s;
+}
+
+static std::string Lower(std::string s)
+{
+    std::transform(s.begin(), s.end(), s.begin(), [](unsigned char c) { return std::tolower(c); });
+    return s;
+}
+
+AkmaKeyService::AkmaKeyService(TaskBase *base) : m_base(base)
+{
+    m_logger = base->logBase->makeUniqueLogger(base->config->getLoggerPrefix() + "akma");
+    m_path = base->config->akmaKeySocket.empty() ? "/run/ueransim/akma-" + base->config->getNodeName() + ".sock"
+                                                 : base->config->akmaKeySocket;
+}
+
+AkmaKeyService::~AkmaKeyService()
+{
+    m_stop = true;
+    if (m_thread.joinable())
+        m_thread.join();
+    if (m_fd >= 0)
+    {
+        close(m_fd);
+        unlink(m_path.c_str());
+    }
+}
+
+bool AkmaKeyService::start()
+{
+    if (m_base->config->akmaCliKaf)
+        m_logger->warn("akma-kaf of nr-cli is enabled (akmaCliKaf): any local process gets the K_AF of any AF; "
+                       "test only");
+
+    auto &applications = m_base->config->akmaApplications;
+    if (applications.empty())
+    {
+        m_logger->info("AKMA key service not started: no application in akmaKeyService.applications");
+        return false;
+    }
+
+    sockaddr_un addr{};
+    addr.sun_family = AF_UNIX;
+    if (m_path.size() >= sizeof(addr.sun_path))
+    {
+        m_logger->err("AKMA key service not started: socket path too long: %s", m_path.c_str());
+        return false;
+    }
+    std::memcpy(addr.sun_path, m_path.c_str(), m_path.size() + 1);
+
+    auto slash = m_path.rfind('/');
+    if (slash != std::string::npos && slash > 0)
+        mkdir(m_path.substr(0, slash).c_str(), 0755); // an existing directory is fine
+    unlink(m_path.c_str());
+
+    // The file is open to every user: the policy, not the file mode, decides who gets K_AF.
+    m_fd = socket(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0);
+    if (m_fd < 0 || bind(m_fd, reinterpret_cast<sockaddr *>(&addr), sizeof(addr)) < 0 ||
+        chmod(m_path.c_str(), 0666) < 0 || listen(m_fd, 8) < 0)
+    {
+        m_logger->err("AKMA key service not started on %s: %s", m_path.c_str(), std::strerror(errno));
+        if (m_fd >= 0)
+        {
+            close(m_fd);
+            m_fd = -1;
+        }
+        return false;
+    }
+
+    std::string names{};
+    for (auto &a : applications)
+        names += (names.empty() ? "" : ", ") + a.name;
+    m_logger->info("AKMA key service on %s; applications [%s]", m_path.c_str(), names.c_str());
+
+    m_thread = std::thread(&AkmaKeyService::run, this);
+    return true;
+}
+
+void AkmaKeyService::run()
+{
+    while (!m_stop)
+    {
+        pollfd p{m_fd, POLLIN, 0};
+        if (poll(&p, 1, 500) <= 0)
+            continue;
+        int fd = accept4(m_fd, nullptr, nullptr, SOCK_CLOEXEC);
+        if (fd < 0)
+            continue;
+        serve(fd);
+        close(fd);
+    }
+}
+
+void AkmaKeyService::serve(int fd)
+{
+    // Who is asking: the user and the executable of the process, as the kernel gives them.
+    ucred cred{};
+    socklen_t len = sizeof(cred);
+    if (getsockopt(fd, SOL_SOCKET, SO_PEERCRED, &cred, &len) < 0)
+        return;
+    std::string executable{};
+    char buf[4096];
+    std::string proc = "/proc/" + std::to_string(cred.pid) + "/exe";
+    ssize_t n = readlink(proc.c_str(), buf, sizeof(buf) - 1);
+    if (n > 0)
+        executable.assign(buf, static_cast<size_t>(n));
+
+    timeval tv{RECEIVE_TIMEOUT_S, 0};
+    setsockopt(fd, SOL_SOCKET, SO_RCVTIMEO, &tv, sizeof(tv));
+
+    std::string pending{};
+    char chunk[256];
+    while (!m_stop)
+    {
+        ssize_t r = recv(fd, chunk, sizeof(chunk), 0);
+        if (r <= 0)
+            return;
+        pending.append(chunk, static_cast<size_t>(r));
+
+        size_t nl;
+        while ((nl = pending.find('\n')) != std::string::npos)
+        {
+            std::string line = pending.substr(0, nl);
+            pending.erase(0, nl + 1);
+            if (!line.empty() && line.back() == '\r')
+                line.pop_back();
+
+            std::string answer = handle(line, static_cast<int>(cred.uid), executable) + "\n";
+            ssize_t sent = send(fd, answer.data(), answer.size(), MSG_NOSIGNAL);
+            std::fill(answer.begin(), answer.end(), '\0'); // the answer may hold K_AF
+            if (sent < 0)
+                return;
+        }
+        if (pending.size() > MAX_LINE)
+        {
+            static const std::string error = "ERR BAD_REQUEST\n";
+            send(fd, error.data(), error.size(), MSG_NOSIGNAL);
+            return;
+        }
+    }
+}
+
+std::string AkmaKeyService::handle(const std::string &line, int uid, const std::string &executable)
+{
+    std::istringstream in(line);
+    std::string verb{}, fqdn{}, uaStarId{}, extra{};
+    in >> verb >> fqdn >> uaStarId;
+    if (verb != "KAF" || fqdn.empty() || uaStarId.empty() || (in >> extra))
+        return "ERR BAD_REQUEST";
+    uaStarId = Upper(uaStarId);
+    if (!keys::IsValidAfFqdn(fqdn) || uaStarId.size() != 10 ||
+        uaStarId.find_first_not_of("0123456789ABCDEF") != std::string::npos)
+        return "ERR BAD_REQUEST";
+    std::string afId = fqdn + "." + uaStarId;
+
+    // The application: same user and same executable; failing that, same user and no executable in the policy.
+    const UeConfig::AkmaApplication *application = nullptr;
+    for (auto &a : m_base->config->akmaApplications)
+        if (a.uid == uid && !a.executable.empty() && a.executable == executable)
+            application = &a;
+    if (application == nullptr)
+        for (auto &a : m_base->config->akmaApplications)
+            if (application == nullptr && a.uid == uid && a.executable.empty())
+                application = &a;
+
+    if (application == nullptr)
+    {
+        m_logger->warn("Application of uid %d (%s) not in the AKMA key service policy; AF_ID[%s] refused", uid,
+                       executable.c_str(), afId.c_str());
+        return "ERR NOT_AUTHORIZED";
+    }
+    if (std::find(application->afIds.begin(), application->afIds.end(), afId) == application->afIds.end())
+    {
+        m_logger->warn("Application [%s] not authorized for AF_ID[%s] (TS 33.535 cl. 4.4.3)",
+                       application->name.c_str(), afId.c_str());
+        return "ERR NOT_AUTHORIZED";
+    }
+
+    auto promise = std::make_shared<std::promise<AkmaKafResult>>();
+    auto future = promise->get_future();
+    m_base->appTask->push(std::make_unique<NmUeAkmaKafRequest>(fqdn, uaStarId, promise));
+    if (future.wait_for(std::chrono::milliseconds(REQUEST_TIMEOUT_MS)) != std::future_status::ready)
+        return "ERR UNAVAILABLE";
+    AkmaKafResult result = future.get();
+    if (!result.cause.empty())
+        return "ERR " + result.cause;
+
+    m_logger->info("K_AF for AF_ID[%s] given to application [%s] (uid %d), A-KID[%s]", result.afId.c_str(),
+                   application->name.c_str(), uid, result.aKid.c_str());
+    return "OK a-kid=" + result.aKid + " af-id=" + result.afId + " k-af=" + Lower(result.kAf.toHexString());
+}
+
+} // namespace nr::ue
diff --git a/src/ue/app/akma_service.hpp b/src/ue/app/akma_service.hpp
